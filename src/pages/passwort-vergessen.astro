---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Passwort vergessen | PraxisMaik">
  <section style="padding: 4rem 1rem; max-width: 500px; margin: 0 auto;">
    <h1>Passwort vergessen</h1>

    <p>
      Gib deine E-Mail-Adresse ein. Du erhältst einen Link, mit dem du dein Passwort zurücksetzen kannst.
    </p>

    <div style="display:flex; flex-direction:column; gap:1rem;">
      <input
        type="email"
        id="email"
        placeholder="E-Mail"
        style="padding:1rem;"
      />

      <button id="reset-button">
        Passwort zurücksetzen
      </button>

      <p id="message"></p>
    </div>
  </section>

  <script type="module">
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';

    const supabase = createClient(
      'https://dmjbuijhoiklmgqozxkg.supabase.co',
      'sb_publishable_SQLOHit8yP0fMjfS3nN1QQ_61E3MOgn'
    );

    const button = document.getElementById('reset-button');
    const message = document.getElementById('message');

    button?.addEventListener('click', async () => {
      const email = document.getElementById('email')?.value;

      if (!email) {
        message.textContent = 'Bitte gib deine E-Mail-Adresse ein.';
        return;
      }

      message.textContent = 'E-Mail wird gesendet...';

      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: 'https://www.praxismaik.de/passwort-neu',
      });

      if (error) {
        message.textContent = error.message;
        return;
      }

      message.textContent = 'Wenn ein Konto existiert, wurde eine E-Mail zum Zurücksetzen gesendet.';
    });
  </script>
</BaseLayout>
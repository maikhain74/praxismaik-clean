---
export const prerender = false;

import Stripe from "stripe";
import BaseLayout from "../layouts/BaseLayout.astro";

const sessionId = Astro.url.searchParams.get("session_id");

let paymentVerified = false;
let errorMessage = "";

let purchasedProduct: "azubi" | "praxisanleiter" | null = null;

if (!sessionId) {
  errorMessage =
    "Die Zahlungsbestätigung fehlt. Bitte rufe diese Seite nur nach dem abgeschlossenen Bezahlvorgang auf.";
} else {
  try {
    /*
     * Stripe Test- und Live-Sessions gehören zu getrennten
     * Stripe-Umgebungen.
     *
     * Eine cs_test_-Session muss deshalb mit dem Testschlüssel
     * geprüft werden. Echte Käufe verwenden weiterhin ausschließlich
     * den Live-Schlüssel.
     */
    const isTestSession = sessionId.startsWith("cs_test_");

    const stripeSecretKey = isTestSession
      ? import.meta.env.STRIPE_SECRET_KEY_TEST
      : import.meta.env.STRIPE_SECRET_KEY;

    if (!stripeSecretKey) {
      throw new Error(
        isTestSession
          ? "STRIPE_SECRET_KEY_TEST fehlt."
          : "STRIPE_SECRET_KEY fehlt."
      );
    }

    const stripe = new Stripe(stripeSecretKey);

    const session = await stripe.checkout.sessions.retrieve(sessionId, {
      expand: ["line_items"],
    });

    const purchasedPriceId = session.line_items?.data[0]?.price?.id;
    const premiumType = session.metadata?.premium_type;

    /*
     * Bei Live-Käufen prüfen wir weiterhin gegen die
     * Live-Preis-IDs.
     *
     * Bei Sandbox-Käufen reicht die Kombination aus:
     * gültiger Stripe-Session + erfolgreicher Zahlung +
     * korrektem premium_type.
     */
    const azubiProduct = isTestSession
      ? premiumType === "azubi"
      : purchasedPriceId === import.meta.env.STRIPE_PRICE_ID &&
        premiumType === "azubi";

    const praxisanleiterProduct = isTestSession
      ? premiumType === "praxisanleiter"
      : purchasedPriceId ===
          import.meta.env.STRIPE_PRICE_ID_PRAXISANLEITER &&
        premiumType === "praxisanleiter";

    const paymentCompleted =
      session.status === "complete" &&
      session.payment_status === "paid";

    const correctMode = session.mode === "payment";

    if (azubiProduct) {
      purchasedProduct = "azubi";
    } else if (praxisanleiterProduct) {
      purchasedProduct = "praxisanleiter";
    }

    paymentVerified =
      paymentCompleted &&
      correctMode &&
      purchasedProduct !== null;

    if (paymentVerified && purchasedProduct === "azubi") {
      Astro.cookies.set("praxismaik_premium_azubi", "true", {
        path: "/",
        sameSite: "lax",
        secure: import.meta.env.PROD,
       maxAge: 315360000, 
      }
    );
    }

    if (
      paymentVerified &&
      purchasedProduct === "praxisanleiter"
    ) {
      Astro.cookies.set(
        "praxismaik_premium_praxisanleiter",
        "true",
        {
          path: "/",
          sameSite: "lax",
          secure: import.meta.env.PROD,
        }
      );
    }

    if (!paymentVerified) {
      errorMessage =
        "Die Zahlung konnte noch nicht eindeutig bestätigt werden. Bitte versuche es in wenigen Minuten erneut oder melde dich mit deinem PraxisMaik-Konto an.";
    }
  } catch (error) {
    console.error(
      "Stripe-Session konnte nicht geprüft werden:",
      error
    );

    errorMessage =
      "Die Zahlungsbestätigung konnte nicht geprüft werden. Bitte melde dich mit deinem PraxisMaik-Konto an oder kontaktiere den Support.";
  }
}

const isAzubiPurchase =
  paymentVerified && purchasedProduct === "azubi";

const isPraxisanleiterPurchase =
  paymentVerified && purchasedProduct === "praxisanleiter";
---

<BaseLayout
  title={
    paymentVerified
      ? "Premium freigeschaltet"
      : "Zahlung wird geprüft"
  }
  description={
    paymentVerified
      ? "Dein PraxisMaik Premium-Zugang ist jetzt aktiv."
      : "Deine PraxisMaik-Zahlung konnte noch nicht bestätigt werden."
  }
>
  <div class="premium-success">
    {paymentVerified ? (
      <>
        <span class="success-badge">
          Zahlung bestätigt
        </span>

        <h1>Danke für deinen Kauf</h1>

        {isPraxisanleiterPurchase ? (
          <>
            <p class="success-lead">
              Deine Zahlung wurde bestätigt. Dein
              Praxisanleiter-Premium-Zugang ist jetzt
              freigeschaltet.
            </p>

            <div class="success-actions">
              <a
                href="/praxisanleiter-premium/"
                class="btn"
              >
                Zu Praxisanleiter Premium
              </a>

              <a
                href="/praxisanleitung/faelle/"
                class="btn secondary"
              >
                Zu den Praxisanleiter-Fällen
              </a>
            </div>

            <p class="success-note">
              Dein Praxisanleiter-Premium-Zugang ist vom
              Premiumbereich für Pflegeazubis getrennt.
            </p>
          </>
        ) : (
          <>
            <p class="success-lead">
              Deine Zahlung wurde bestätigt. Dein
              Premium-Zugang für Pflegeazubis ist jetzt
              freigeschaltet.
            </p>

            <p class="success-lead">
              Du kannst jetzt auf alle zentralen
              Premium-Bereiche zugreifen:
            </p>

            <div class="success-actions">
              <a href="/lernskripte" class="btn">
                Zu den Lernskripten
              </a>

              <a href="/pruefung" class="btn secondary">
                Zu den Prüfungsfällen
              </a>

              <a href="/quiz-exam" class="btn secondary">
                Zum Examensquiz
              </a>

              <a href="/ebooks" class="btn secondary">
                Zu den Premium-E-Books
              </a>

              <a
                href="/visuelle-lernkarten"
                class="btn secondary"
              >
                Zu den Lernkarten
              </a>
            </div>

            <p class="success-note">
              Dein Kauf bleibt dauerhaft in deinem
              PraxisMaik-Konto gespeichert. Melde dich bei
              einem Geräte- oder Browserwechsel erneut mit
              deiner E-Mail-Adresse an.
            </p>
          </>
        )}
      </>
    ) : (
      <>
        <span class="success-badge success-badge--error">
          Prüfung nicht abgeschlossen
        </span>

        <h1>Zahlung konnte nicht bestätigt werden</h1>

        <p class="success-lead">
          {errorMessage}
        </p>

        <div class="success-actions">
          <a href="/login" class="btn">
            Zum Login
          </a>

          <a href="/premium" class="btn secondary">
            Zur Premium-Seite
          </a>
        </div>

        <p class="success-note">
          Es wurde auf dieser Seite kein Premium-Zugang
          freigeschaltet.
        </p>
      </>
    )}
  </div>

  {isAzubiPurchase && (
    <script is:inline>
      localStorage.removeItem("praxismaik_premium");

      localStorage.setItem(
        "praxismaik_premium_azubi",
        "true"
      );

      const purchaseAlreadyTracked =
        sessionStorage.getItem(
          "praxismaik_purchase_azubi_tracked"
        );

      if (
        !purchaseAlreadyTracked &&
        typeof window.trackPraxisMaikEvent === "function"
      ) {
        window.trackPraxisMaikEvent("purchase_success", {
          value: 39,
          currency: "EUR",
          product: "PraxisMaik Premium",
          page_path: window.location.pathname,
        });

        sessionStorage.setItem(
          "praxismaik_purchase_azubi_tracked",
          "1"
        );
      }
    </script>
  )}

  {isPraxisanleiterPurchase && (
    <script is:inline>
      localStorage.setItem(
        "praxismaik_premium_praxisanleiter",
        "true"
      );

      const purchaseAlreadyTracked =
        sessionStorage.getItem(
          "praxismaik_purchase_praxisanleiter_tracked"
        );

      if (
        !purchaseAlreadyTracked &&
        typeof window.trackPraxisMaikEvent === "function"
      ) {
        window.trackPraxisMaikEvent("purchase_success", {
          value: 79,
          currency: "EUR",
          product: "PraxisMaik Praxisanleiter Premium",
          page_path: window.location.pathname,
        });

        sessionStorage.setItem(
          "praxismaik_purchase_praxisanleiter_tracked",
          "1"
        );
      }
    </script>
  )}
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Logout | PraxisMaik">
  <section
    style="padding: 4rem 1rem; max-width: 600px; margin: 0 auto;"
  >
    <h1>Du wirst abgemeldet...</h1>

    <p>
      Dein gekaufter Premiumzugang bleibt in deinem PraxisMaik-Konto
      gespeichert.
    </p>

    <p id="logout-message">
      Anmeldung wird beendet...
    </p>
  </section>
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const message =
    document.getElementById('logout-message');

  async function logout() {
    const { error } = await supabase.auth.signOut({
  scope: 'local',
});

    if (error) {
      console.error(
        'Supabase Logout fehlgeschlagen:',
        error
      );
    }

    localStorage.removeItem('praxismaik_premium');
    localStorage.removeItem('praxismaik_premium_azubi');
    localStorage.removeItem(
      'praxismaik_premium_praxisanleiter'
    );
    localStorage.removeItem('praxismaik_user_email');

    document.cookie =
      'praxismaik_premium=; path=/; max-age=0; SameSite=Lax';

    document.cookie =
      'praxismaik_premium_azubi=; path=/; max-age=0; SameSite=Lax';

    document.cookie =
      'praxismaik_premium_praxisanleiter=; path=/; max-age=0; SameSite=Lax';

    if (message) {
      message.textContent =
        'Du wurdest erfolgreich abgemeldet.';
    }

    window.location.href = '/login';
  }

  logout();
</script>
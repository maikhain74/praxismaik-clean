---
import { getCollection, render } from 'astro:content';
import PremiumGate from '../../components/PremiumGate.astro';

export async function getStaticPaths() {
  const faelle = await getCollection('faelle');

  return faelle.map((eintrag) => ({
    params: { slug: eintrag.slug },
    props: { eintrag }
  }));
}

const { eintrag } = Astro.props;
const { Content } = await render(eintrag);

const isPremium = eintrag.data.premium === true;
const title = eintrag.data.title ?? 'Fall';
const beschreibung = eintrag.data.beschreibung ?? '';
const preview = eintrag.data.preview ?? '';

const isLocalhost =
  Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';

const devUnlock = Astro.url.searchParams.get('freischalten') === '1' && isLocalhost;

const showFullContent = !isPremium || devUnlock;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | PraxisMaik</title>
    <meta name="description" content={beschreibung} />
  </head>

  <body>
    <main class="container">
      <article class="content-card">
        <header class="content-header">
          <p class="content-badge">
            {isPremium ? 'Premium-Fall' : 'Fall'}
          </p>

          <h1>{title}</h1>

          {beschreibung && <p class="content-description">{beschreibung}</p>}

          {devUnlock && (
            <div class="dev-box">
              Testmodus aktiv, Premium-Inhalt lokal freigeschaltet.
            </div>
          )}
        </header>

        {showFullContent ? (
          <section class="markdown-content">
            <Content />
          </section>
        ) : (
          <>
            {preview && (
              <section class="preview-box">
                <h2>Vorschau</h2>
                <p>{preview}</p>
              </section>
            )}

            <PremiumGate
              title="Kompletter Fall nur mit Premium"
              text="Du siehst hier die Vorschau. Die vollständige Fallbearbeitung ist nur für Premium freigeschaltet."
              buttonText="Premium freischalten"
              buttonHref="/premium"
            />
          </>
        )}
      </article>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f3f4f6;
    color: #111827;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .content-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  .content-header {
    margin-bottom: 2rem;
  }

  .content-badge {
    display: inline-block;
    margin: 0 0 1rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: #eef2ff;
    color: #3730a3;
    font-size: 0.9rem;
    font-weight: 700;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: 2rem;
    line-height: 1.2;
  }

  .content-description {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #4b5563;
  }

  .dev-box {
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid #d1fae5;
    background: #ecfdf5;
    color: #065f46;
    border-radius: 12px;
    font-weight: 700;
  }

  .preview-box {
    padding: 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    background: #fafafa;
  }

  .preview-box h2 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
  }

  .preview-box p {
    margin: 0;
    line-height: 1.8;
    white-space: pre-line;
  }

  .markdown-content {
    line-height: 1.8;
  }
</style>
---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard | PraxisMaik">
  <section class="dashboard-page">
    <h1>Mein Konto</h1>

    <div id="user-box" class="card">
      Lade Benutzerdaten...
    </div>

    <div id="progress-box" class="card">
      Lade Lernfortschritt...
    </div>

    <div class="logout-box">
      <a href="/logout">Logout</a>
    </div>
  </section>

  <script>
    import { supabase } from '../lib/supabase';

    const userBox = document.getElementById('user-box');
    const progressBox = document.getElementById('progress-box');

    function formatDate(value) {
      if (!value) return 'Noch nicht verfügbar';

      return new Date(value).toLocaleDateString('de-DE', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
      });
    }

    async function loadDashboard() {
      const {
        data: { user },
      } = await supabase.auth.getUser();

      if (!user) {
        window.location.href = '/login';
        return;
      }

      const { data: profile, error: profileError } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .single();

      if (profileError) {
        console.error('Profil konnte nicht geladen werden:', profileError);
      }

      const { data: progress, error: progressError } = await supabase
        .from('learning_progress')
        .select('*')
        .eq('user_id', user.id)
        .order('updated_at', { ascending: false });

      if (progressError) {
        console.error('Lernfortschritt konnte nicht geladen werden:', progressError);
      }

      const progressItems = progress || [];
      const completedItems = progressItems.filter((item) => item.completed === true);
      const latestItem = progressItems[0];

      userBox.innerHTML = `
        <h2>Benutzerdaten</h2>
        <p><strong>E-Mail:</strong> ${user.email}</p>
        <p><strong>Premium:</strong> ${profile?.premium ? 'Ja' : 'Nein'}</p>
      `;

      progressBox.innerHTML = `
        <h2>Lernfortschritt</h2>

        <div class="progress-grid">
          <div class="progress-stat">
            <strong>${progressItems.length}</strong>
            <span>Gestartete Inhalte</span>
          </div>

          <div class="progress-stat">
            <strong>${completedItems.length}</strong>
            <span>Abgeschlossen</span>
          </div>
        </div>

        <div class="latest-box">
          <h3>Zuletzt gelernt</h3>
          ${
            latestItem
              ? `
                <p><strong>Inhalt:</strong> ${latestItem.slug || latestItem.lesson_slug || latestItem.course_slug || 'Unbekannt'}</p>
                <p><strong>Datum:</strong> ${formatDate(latestItem.updated_at)}</p>
              `
              : `
                <p>Du hast noch keinen Lernfortschritt gespeichert.</p>
              `
          }
        </div>
      `;
    }

    loadDashboard();
  </script>

  <style>
    .dashboard-page {
      padding: 4rem 1rem;
      max-width: 900px;
      margin: 0 auto;
    }

    h1 {
      color: #1f3653;
      margin-bottom: 2rem;
    }

    .card {
      padding: 1.5rem;
      border: 1px solid #e8ded1;
      border-radius: 16px;
      background: #f5f1ea;
      margin-bottom: 1.5rem;
    }

    .card h2 {
      margin-top: 0;
      color: #1f3653;
    }

    .progress-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin: 1.5rem 0;
    }

    .progress-stat {
      background: white;
      border-radius: 14px;
      padding: 1rem;
      border: 1px solid #e8ded1;
    }

    .progress-stat strong {
      display: block;
      font-size: 2rem;
      color: #c97b63;
    }

    .progress-stat span {
      color: #1f3653;
    }

    .latest-box {
      margin-top: 1.5rem;
    }

    .latest-box h3 {
      color: #1f3653;
      margin-bottom: 0.5rem;
    }

    .logout-box {
      margin-top: 2rem;
    }

    .logout-box a {
      color: #c97b63;
      font-weight: 700;
    }

    @media (max-width: 600px) {
      .progress-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard | PraxisMaik">
  <section class="dashboard-page">
    <h1>Mein Konto</h1>

    <div id="user-box" class="card">
      Lade Benutzerdaten...
    </div>

    <div id="progress-box" class="card">
      Lade Lernfortschritt...
    </div>

    <div class="logout-box">
      <a href="/logout">Logout</a>
    </div>
  </section>

  <script type="module">
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';

    const supabase = createClient(
      'https://dmjbuijhoiklmgqozxkg.supabase.co',
      'sb_publishable_SQLOHit8yP0fMjfS3nN1QQ_61E3MOgn'
    );

    const userBox = document.getElementById('user-box');
    const progressBox = document.getElementById('progress-box');

    function formatDate(value) {
      if (!value) return 'Noch nicht verfügbar';

      return new Date(value).toLocaleDateString('de-DE', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
      });
    }

    function getProgressName(item) {
      return (
        item?.content_slug ||
        item?.slug ||
        item?.lesson_slug ||
        item?.course_slug ||
        'Unbekannter Inhalt'
      );
    }

    async function loadUser() {
      const {
        data: { user },
      } = await supabase.auth.getUser();

      if (!user) {
        window.location.href = '/login';
        return;
      }

      const { data: profile } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .single();

      userBox.innerHTML = `
        <h2>Benutzerdaten</h2>
        <p><strong>E-Mail:</strong> ${user.email}</p>
        <p><strong>Premium:</strong> ${profile?.premium ? 'Ja' : 'Nein'}</p>
      `;

      const response = await fetch(`/api/progress?userId=${user.id}`);
      const progress = await response.json();

      if (!response.ok) {
        progressBox.innerHTML = `
          <h2>Lernfortschritt</h2>
          <p>Lernfortschritt konnte nicht geladen werden.</p>
        `;
        return;
      }

      const progressItems = Array.isArray(progress) ? progress : [];
      const completedItems = progressItems.filter((item) => item.completed === true);
      const latestItem = progressItems[0];

      const TOTAL_CASES = 35;

const progressPercent =
  TOTAL_CASES > 0
    ? Math.round((completedItems.length / TOTAL_CASES) * 100)
    : 0;

progressBox.innerHTML = `
  <h2>Lernfortschritt</h2>

  <div class="progress-summary">
    <div>
      <strong>${progressPercent}%</strong>
      <span>${completedItems.length} von ${TOTAL_CASES} Prüfungsfällen abgeschlossen</span>
    </div>

    <div class="progress-bar">
      <div class="progress-bar-fill" style="width: ${progressPercent}%"></div>
    </div>
  </div>

  <div class="progress-grid">
    <div class="progress-stat">
      <strong>${progressItems.length}</strong>
      <span>Gestartete Inhalte</span>
    </div>

    <div class="progress-stat">
      <strong>${completedItems.length}</strong>
      <span>Abgeschlossen</span>
    </div>
  </div>

  <div class="latest-box">
    <h3>Zuletzt gelernt</h3>
    ${
      latestItem
        ? `
          <a class="latest-link" href="/pruefung/${getProgressName(latestItem)}/">
            ${latestItem.title || getProgressName(latestItem)}
          </a>
          <p><strong>Datum:</strong> ${formatDate(latestItem.updated_at || latestItem.created_at)}</p>
        `
        : `
          <p>Du hast noch keinen Lernfortschritt gespeichert.</p>
        `
    }
  </div>
`;
    }

    loadUser();
  </script>

  <style>
    .dashboard-page {
      padding: 4rem 1rem;
      max-width: 800px;
      margin: 0 auto;
    }

    h1 {
      color: #1f3653;
      margin-bottom: 2rem;
    }

    .card {
      padding: 1.5rem;
      border: 1px solid #e8ded1;
      border-radius: 16px;
      background: #f5f1ea;
      margin-bottom: 1.5rem;
    }

    .card h2 {
      color: #1f3653;
      margin-top: 0;
    }

.progress-summary {
  display: grid;
  gap: 0.75rem;
  margin: 1.5rem 0;
  padding: 1rem;
  border-radius: 14px;
  background: #ffffff;
  border: 1px solid #e8ded1;
}

.progress-summary strong {
  display: block;
  font-size: 2.2rem;
  color: #c97b63;
}

.progress-summary span {
  color: #1f3653;
  font-weight: 700;
}

.progress-bar {
  width: 100%;
  height: 12px;
  overflow: hidden;
  border-radius: 999px;
  background: #e8ded1;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 999px;
  background: #c97b63;
}

.latest-link {
  display: inline-block;
  margin-bottom: 0.5rem;
  color: #1f3653;
  font-weight: 700;
  text-decoration: none;
}

.latest-link:hover {
  text-decoration: underline;
}

    .progress-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin: 1.5rem 0;
    }

    .progress-stat {
      background: white;
      border: 1px solid #e8ded1;
      border-radius: 14px;
      padding: 1rem;
    }

    .progress-stat strong {
      display: block;
      font-size: 2rem;
      color: #c97b63;
    }

    .progress-stat span {
      color: #1f3653;
    }

    .latest-box {
      margin-top: 1.5rem;
    }

    .latest-box h3 {
      color: #1f3653;
      margin-bottom: 0.5rem;
    }

    .logout-box {
      margin-top: 2rem;
    }

    .logout-box a {
      color: #c97b63;
      font-weight: 700;
    }

    @media (max-width: 600px) {
      .progress-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
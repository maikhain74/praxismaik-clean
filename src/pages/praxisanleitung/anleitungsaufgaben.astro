---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const praxisanleiterPremiumCookie =
  Astro.cookies.get("praxismaik_premium_praxisanleiter")?.value;

const isLocalhost =
  Astro.url.hostname === "localhost" ||
  Astro.url.hostname === "127.0.0.1";

const devUnlock =
  Astro.url.searchParams.get("freischalten") === "1" &&
  isLocalhost;

const hasPraxisanleiterPremium =
  praxisanleiterPremiumCookie === "1" ||
  praxisanleiterPremiumCookie === "true" ||
  devUnlock;

if (!hasPraxisanleiterPremium) {
  return Astro.redirect("/praxisanleiter-premium");
}

const aufgaben = await getCollection("anleitungsaufgaben");

const erstesDrittelAufgaben = aufgaben.filter(
  (item) =>
    item.data.ausbildungsstand === "ausbildungsbeginn" ||
    item.data.ausbildungsstand === "erstes-drittel"
);

const zweitesDrittelAufgaben = aufgaben.filter(
  (item) => item.data.ausbildungsstand === "zweites-drittel"
);

const drittesDrittelAufgaben = aufgaben.filter(
  (item) => item.data.ausbildungsstand === "drittes-drittel"
);

const erstesDrittelHref = `/praxisanleitung/anleitungsaufgaben/erstes-drittel/${
  devUnlock ? "?freischalten=1" : ""
}`;
---

<BaseLayout
  title="Anleitungsaufgaben | Praxisanleiter Premium"
  description="Praxisnahe Anleitungsaufgaben für Praxisanleitende, strukturiert nach Ausbildungsdritteln und abgestimmt auf den jeweiligen Lernstand."
>
  <main class="tasks-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span>›</span>
      <a href="/praxisanleitung/">Praxisanleitung</a>
      <span>›</span>
      <a href="/praxisanleiter-premium/">Premium</a>
      <span>›</span>
      <span>Anleitungsaufgaben</span>
    </nav>

    <header class="tasks-hero">
      <span class="eyebrow">Praxisanleiter Premium</span>

      <h1>Anleitungsaufgaben für die praktische Pflegeausbildung</h1>

      <p>
        Wähle den passenden Ausbildungsabschnitt. Die Aufgaben begleiten
        Auszubildende schrittweise vom Ausbildungsbeginn bis zu zunehmend
        komplexeren und selbstständigeren Pflegesituationen.
      </p>
    </header>

    <section class="intro-box">
      <strong>Strukturiert nach Ausbildungsstand.</strong>
      <p>
        Statt einer langen Sammlung findest du die Anleitungsaufgaben hier
        nach Ausbildungsdritteln geordnet. So kannst du schneller auswählen,
        was zum aktuellen Lernstand deines Auszubildenden passt.
      </p>
    </section>

    <section class="training-section">
      <div class="section-heading">
        <span>Ausbildungsweg</span>
        <h2>Wähle das Ausbildungsdrittel</h2>
        <p>
          Die Anforderungen entwickeln sich mit dem Ausbildungsstand weiter.
          Jeder Bereich baut auf den zuvor erworbenen Kompetenzen auf.
        </p>
      </div>

      <div class="training-grid">
        <article class="training-card training-card-active">
          <div class="card-top">
            <span class="number">01</span>
            <span class="status status-active">Verfügbar</span>
          </div>

          <span class="card-eyebrow">Ausbildungsbeginn inklusive</span>

          <h3>1. Ausbildungsdrittel</h3>

          <p>
            Grundlagen für den Einstieg in die praktische Pflegeausbildung.
            Von Orientierung und grundlegenden Pflegesituationen bis zu
            Beobachtung, Begründung, Übergabe und zunehmend selbstständigem
            Handeln.
          </p>

          <div class="card-count">
            <strong>{erstesDrittelAufgaben.length}</strong>
            <span>Anleitungsaufgaben</span>
          </div>

          <a class="card-link" href={erstesDrittelHref}>
            Aufgaben öffnen →
          </a>
        </article>

        <article class="training-card">
          <div class="card-top">
            <span class="number">02</span>

            {
              zweitesDrittelAufgaben.length > 0 ? (
                <span class="status status-active">Verfügbar</span>
              ) : (
                <span class="status">In Vorbereitung</span>
              )
            }
          </div>

          <span class="card-eyebrow">Kompetenzen vertiefen</span>

          <h3>2. Ausbildungsdrittel</h3>

          <p>
            Aufbauend auf den Grundlagen werden Pflegesituationen
            anspruchsvoller. Beobachtung, Einschätzung, Pflegeprozess und
            begründetes Handeln rücken stärker in den Mittelpunkt.
          </p>

          {
            zweitesDrittelAufgaben.length > 0 ? (
              <div class="card-count">
                <strong>{zweitesDrittelAufgaben.length}</strong>
                <span>Anleitungsaufgaben</span>
              </div>
            ) : (
              <div class="coming-soon">
                Neue Anleitungsaufgaben folgen.
              </div>
            )
          }
        </article>

        <article class="training-card">
          <div class="card-top">
            <span class="number">03</span>

            {
              drittesDrittelAufgaben.length > 0 ? (
                <span class="status status-active">Verfügbar</span>
              ) : (
                <span class="status">In Vorbereitung</span>
              )
            }
          </div>

          <span class="card-eyebrow">Richtung Examen</span>

          <h3>3. Ausbildungsdrittel</h3>

          <p>
            Zunehmend komplexe Pflegesituationen, Prioritätensetzung,
            begründete Entscheidungen und die Vorbereitung auf
            selbstständigeres Handeln und die praktische Prüfung.
          </p>

          {
            drittesDrittelAufgaben.length > 0 ? (
              <div class="card-count">
                <strong>{drittesDrittelAufgaben.length}</strong>
                <span>Anleitungsaufgaben</span>
              </div>
            ) : (
              <div class="coming-soon">
                Neue Anleitungsaufgaben folgen.
              </div>
            )
          }
        </article>
      </div>
    </section>

    <section class="outlook-box">
      <span>Die Bibliothek wächst weiter</span>

      <h2>20 Anleitungsaufgaben für das 1. Ausbildungsdrittel sind jetzt verfügbar.</h2>

      <p>
        Die Anleitungsaufgaben für das 2. und 3. Ausbildungsdrittel werden
        schrittweise ergänzt. So entsteht eine strukturierte
        Anleitungsbibliothek für den gesamten Verlauf der Pflegeausbildung.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .tasks-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.2rem 1rem 4rem;
    color: #18324a;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2rem;
    color: #6b7280;
    font-size: 0.92rem;
  }

  .breadcrumbs a {
    color: #18324a;
    text-decoration: none;
  }

  .tasks-hero {
    max-width: 850px;
    margin-bottom: 2rem;
  }

  .eyebrow,
  .section-heading > span,
  .outlook-box > span {
    display: inline-block;
    margin-bottom: 0.7rem;
    color: #e67e22;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tasks-hero h1 {
    margin: 0 0 1rem;
    color: #18324a;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.08;
  }

  .tasks-hero p,
  .section-heading p {
    color: #556270;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .intro-box {
    margin-bottom: 3.5rem;
    padding: 1.5rem 1.6rem;
    border: 1px solid rgba(230, 126, 34, 0.2);
    border-radius: 18px;
    background: #fff8f1;
  }

  .intro-box strong {
    display: block;
    margin-bottom: 0.45rem;
    color: #18324a;
    font-size: 1.05rem;
  }

  .intro-box p {
    margin: 0;
    color: #556270;
    line-height: 1.7;
  }

  .training-section {
    margin-bottom: 3.5rem;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 1.7rem;
  }

  .section-heading h2 {
    margin: 0 0 0.7rem;
    color: #18324a;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    line-height: 1.15;
  }

  .section-heading p {
    margin: 0;
  }

  .training-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .training-card {
    display: flex;
    flex-direction: column;
    min-height: 430px;
    padding: 1.6rem;
    border: 1px solid rgba(24, 50, 74, 0.1);
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 10px 28px rgba(24, 50, 74, 0.05);
  }

  .training-card-active {
    border-color: rgba(230, 126, 34, 0.35);
    background: linear-gradient(180deg, #fffaf5 0%, #ffffff 100%);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: #fff3e7;
    color: #e67e22;
    font-size: 1rem;
    font-weight: 900;
  }

  .status {
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: #f3f4f6;
    color: #7a8793;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .status-active {
    background: #fff0df;
    color: #b85f15;
  }

  .card-eyebrow {
    display: block;
    margin-bottom: 0.45rem;
    color: #e67e22;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .training-card h3 {
    margin: 0 0 1rem;
    color: #18324a;
    font-size: 1.55rem;
    line-height: 1.2;
  }

  .training-card > p {
    margin: 0 0 1.5rem;
    color: #556270;
    line-height: 1.7;
  }

  .card-count {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-top: auto;
    margin-bottom: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(24, 50, 74, 0.08);
  }

  .card-count strong {
    color: #e67e22;
    font-size: 2rem;
    line-height: 1;
  }

  .card-count span {
    color: #556270;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .coming-soon {
    margin-top: auto;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(24, 50, 74, 0.08);
    color: #7a8793;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .card-link {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    background: #e67e22;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }

  .card-link:hover {
    background: #cf6f1d;
    transform: translateY(-1px);
  }

  .outlook-box {
    padding: 2rem;
    border-radius: 22px;
    background: #fff8f1;
    border: 1px solid rgba(230, 126, 34, 0.18);
  }

  .outlook-box h2 {
    margin: 0 0 0.8rem;
    color: #18324a;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
  }

  .outlook-box p {
    max-width: 800px;
    margin: 0;
    color: #556270;
    line-height: 1.75;
  }

  @media (max-width: 900px) {
    .training-grid {
      grid-template-columns: 1fr;
    }

    .training-card {
      min-height: auto;
    }
  }
</style>
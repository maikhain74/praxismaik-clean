---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { createSupabaseServerClient } from "../../../lib/supabase-server";

const isLocalhost =
  Astro.url.hostname === "localhost" ||
  Astro.url.hostname === "127.0.0.1";

const devUnlock =
  Astro.url.searchParams.get("freischalten") === "1" &&
  isLocalhost;

const supabase =
  createSupabaseServerClient(Astro.cookies);

const {
  data: { user },
  error: userError,
} = await supabase.auth.getUser();

let hasPraxisanleiterPremium = false;

if (!userError && user) {
  const {
    data: profile,
    error: profileError,
  } = await supabase
    .from("profiles")
    .select("premium_praxisanleiter")
    .eq("id", user.id)
    .single();

  if (!profileError && profile) {
    hasPraxisanleiterPremium =
      profile.premium_praxisanleiter === true;
  }
}

if (devUnlock) {
  hasPraxisanleiterPremium = true;
}

const aufgaben = await getCollection("anleitungsaufgaben");

const aufgabenErstesDrittel = aufgaben
  .filter(
    (item) =>
      item.data.ausbildungsstand === "ausbildungsbeginn" ||
      item.data.ausbildungsstand === "erstes-drittel"
  )
  .sort(
    (a, b) =>
      (a.data.reihenfolge ?? 999) -
      (b.data.reihenfolge ?? 999)
  );

const ausbildungsbeginn = aufgabenErstesDrittel.filter(
  (item) =>
    (item.data.reihenfolge ?? 999) >= 1 &&
    (item.data.reihenfolge ?? 999) <= 7
);

const kompetenzenAufbauen = aufgabenErstesDrittel.filter(
  (item) =>
    (item.data.reihenfolge ?? 999) >= 8 &&
    (item.data.reihenfolge ?? 999) <= 14
);

const zunehmendSelbststaendig = aufgabenErstesDrittel.filter(
  (item) =>
    (item.data.reihenfolge ?? 999) >= 15 &&
    (item.data.reihenfolge ?? 999) <= 20
);

const ausbildungsstandLabels = {
  ausbildungsbeginn: "Ausbildungsbeginn",
  "erstes-drittel": "1. Ausbildungsdrittel",
  "zweites-drittel": "2. Ausbildungsdrittel",
  "drittes-drittel": "3. Ausbildungsdrittel",
};

const settingLabels = {
  settinguebergreifend: "Settingübergreifend",
  klinik: "Klinik",
  "stationaere-langzeitpflege": "Stationäre Langzeitpflege",
  "ambulante-pflege": "Ambulante Pflege",
};

const abschnitte = [
  {
    nummer: "01",
    titel: "Ausbildungsbeginn",
    untertitel: "Orientierung und erste Sicherheit entwickeln",
    beschreibung:
      "Die ersten Aufgaben unterstützen Auszubildende beim Einstieg in den Pflegealltag und beim Aufbau grundlegender Handlungssicherheit.",
    aufgaben: ausbildungsbeginn,
  },
  {
    nummer: "02",
    titel: "Kompetenzen aufbauen",
    untertitel: "Beobachten, handeln und zunehmend verstehen",
    beschreibung:
      "Jetzt werden bekannte Grundlagen erweitert. Beobachtung, Kommunikation, Mobilisation, Pflegesituationen, Begründungen sowie Dokumentation und Übergabe gewinnen an Bedeutung.",
    aufgaben: kompetenzenAufbauen,
  },
  {
    nummer: "03",
    titel: "Zunehmend selbstständig handeln",
    untertitel: "Zusammenhänge erkennen und Verantwortung entwickeln",
    beschreibung:
      "Die Aufgaben führen schrittweise zu mehr Selbstständigkeit, ohne Kompetenzgrenzen aus dem Blick zu verlieren. Den Abschluss bildet die Reflexion der bisherigen Entwicklung.",
    aufgaben: zunehmendSelbststaendig,
  },
];
---

<BaseLayout
  title="1. Ausbildungsdrittel | Anleitungsaufgaben | PraxisMaik"
  description="Strukturierte Anleitungsaufgaben für den Ausbildungsbeginn und das erste Ausbildungsdrittel der generalistischen Pflegeausbildung."
>
  <main class="tasks-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span>›</span>
      <a href="/praxisanleitung/">Praxisanleitung</a>
      <span>›</span>
      <a
        href={`/praxisanleitung/anleitungsaufgaben/${devUnlock ? "?freischalten=1" : ""}`}
      >
        Anleitungsaufgaben
      </a>
      <span>›</span>
      <span>1. Ausbildungsdrittel</span>
    </nav>

    <header class="tasks-hero">
      <span class="eyebrow">Praxisanleiter Premium</span>

      <h1>Anleitungsaufgaben für das 1. Ausbildungsdrittel</h1>

      <p>
        Vom Ausbildungsbeginn bis zum zunehmend selbstständigen Handeln.
        Wähle den Lernabschnitt, der zum aktuellen Entwicklungsstand deines
        Auszubildenden passt.
      </p>
    </header>

    <section class="progress-box">
      <div class="progress-number">
        <strong>{aufgabenErstesDrittel.length}</strong>
        <span>Anleitungsaufgaben</span>
      </div>

      <p>
        Die Aufgaben bauen schrittweise aufeinander auf, müssen aber nicht
        starr in dieser Reihenfolge bearbeitet werden. Entscheidend ist der
        tatsächliche Lernstand des Auszubildenden.
      </p>
    </section>

    <section class="tasks-learning-path">
      <div class="section-heading">
        <span>1. Ausbildungsdrittel</span>
        <h2>Drei Schritte im Kompetenzaufbau</h2>
        <p>
          Öffne den passenden Lernabschnitt. Darin findest du die zugehörigen
          Anleitungsaufgaben.
        </p>
      </div>

      <div class="learning-sections">
        {
          abschnitte.map((abschnitt) => (
            <details class="learning-section">
              <summary>
                <div class="summary-number">
                  {abschnitt.nummer}
                </div>

                <div class="summary-content">
                  <span>{abschnitt.untertitel}</span>
                  <h3>{abschnitt.titel}</h3>
                  <p>{abschnitt.beschreibung}</p>
                </div>

                <div class="summary-side">
                  <span class="task-count">
                    {abschnitt.aufgaben.length} Aufgaben
                  </span>

                  <span class="open-icon" aria-hidden="true">
                    +
                  </span>
                </div>
              </summary>

              <div class="section-content">
                <div class="task-grid">
                  {
                    abschnitt.aufgaben.map((item) => (
                      <article class="task-card">
                        <div class="task-card-top">
                          <span class="task-number">
                            Aufgabe{" "}
                            {String(
                              item.data.reihenfolge ?? ""
                            ).padStart(2, "0")}
                          </span>

                          <span class="premium-badge">
                            Praxisanleiter Premium
                          </span>
                        </div>

                        <div class="task-meta">
                          <span>
                            {
                              ausbildungsstandLabels[
                                item.data.ausbildungsstand
                              ]
                            }
                          </span>

                          {item.data.dauer && (
                            <span>{item.data.dauer}</span>
                          )}
                        </div>

                        <h4>{item.data.title}</h4>

                        <p>{item.data.beschreibung}</p>

                        <div class="task-topic">
                          <strong>Themenbereich</strong>
                          <span>{item.data.themenbereich}</span>
                        </div>

                        <div class="task-settings">
                          {item.data.setting.map((setting) => (
                            <span>{settingLabels[setting]}</span>
                          ))}
                        </div>

                        <a
                          class="task-link"
                          href={`/praxisanleitung/anleitungsaufgaben/${item.slug}/${devUnlock ? "?freischalten=1" : ""}`}
                        >
                          Anleitungsaufgabe öffnen →
                        </a>
                      </article>
                    ))
                  }
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section class="next-step">
      <span>Wie geht es weiter?</span>

      <h2>Das nächste Ausbildungsdrittel baut darauf auf.</h2>

      <p>
        Mit zunehmender Ausbildung werden Pflegesituationen komplexer.
        Beobachtung, Einschätzung, Pflegeprozess, Prioritätensetzung und
        begründete Entscheidungen gewinnen weiter an Bedeutung.
      </p>

      <a
        href={`/praxisanleitung/anleitungsaufgaben/${devUnlock ? "?freischalten=1" : ""}`}
      >
        Zur Übersicht der Ausbildungsdrittel →
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .tasks-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.2rem 1rem 4rem;
    color: #18324a;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2rem;
    color: #6b7280;
    font-size: 0.92rem;
  }

  .breadcrumbs a {
    color: #18324a;
    text-decoration: none;
  }

  .tasks-hero {
    max-width: 850px;
    margin-bottom: 2rem;
  }

  .eyebrow,
  .section-heading > span,
  .next-step > span {
    display: inline-block;
    margin-bottom: 0.7rem;
    color: #e67e22;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tasks-hero h1 {
    margin: 0 0 1rem;
    color: #18324a;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.08;
  }

  .tasks-hero p,
  .section-heading p {
    color: #556270;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .progress-box {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr);
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 3.5rem;
    padding: 1.5rem 1.6rem;
    border: 1px solid rgba(230, 126, 34, 0.2);
    border-radius: 18px;
    background: #fff8f1;
  }

  .progress-number {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .progress-number strong {
    color: #e67e22;
    font-size: 2.4rem;
    line-height: 1;
  }

  .progress-number span {
    color: #18324a;
    font-weight: 800;
  }

  .progress-box p {
    margin: 0;
    color: #556270;
    line-height: 1.7;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 1.7rem;
  }

  .section-heading h2 {
    margin: 0 0 0.7rem;
    color: #18324a;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    line-height: 1.15;
  }

  .section-heading p {
    margin: 0;
  }

  .learning-sections {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .learning-section {
    overflow: hidden;
    border: 1px solid rgba(24, 50, 74, 0.1);
    border-radius: 20px;
    background: #ffffff;
    box-shadow: 0 8px 24px rgba(24, 50, 74, 0.04);
  }

  .learning-section[open] {
    border-color: rgba(230, 126, 34, 0.3);
  }

  .learning-section summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: center;
    padding: 1.5rem;
    cursor: pointer;
    list-style: none;
  }

  .learning-section summary::-webkit-details-marker {
    display: none;
  }

  .summary-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    background: #fff3e7;
    color: #e67e22;
    font-weight: 900;
  }

  .summary-content > span {
    display: block;
    margin-bottom: 0.3rem;
    color: #e67e22;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .summary-content h3 {
    margin: 0 0 0.4rem;
    color: #18324a;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .summary-content p {
    max-width: 720px;
    margin: 0;
    color: #66727e;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .summary-side {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .task-count {
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    background: #f6f7f8;
    color: #556270;
    font-size: 0.78rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .open-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff3e7;
    color: #e67e22;
    font-size: 1.4rem;
    font-weight: 500;
    transition: transform 0.2s ease;
  }

  .learning-section[open] .open-icon {
    transform: rotate(45deg);
  }

  .section-content {
    padding: 0 1.5rem 1.5rem;
  }

  .task-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(24, 50, 74, 0.08);
  }

  .task-card {
    display: flex;
    flex-direction: column;
    padding: 1.35rem;
    border: 1px solid rgba(24, 50, 74, 0.09);
    border-radius: 16px;
    background: #ffffff;
  }

  .task-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .task-number {
    color: #e67e22;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .premium-badge {
    padding: 0.38rem 0.6rem;
    border-radius: 999px;
    background: #fff3e7;
    color: #b85f15;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .task-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.9rem;
  }

  .task-meta span,
  .task-settings span {
    padding: 0.35rem 0.55rem;
    border-radius: 999px;
    background: #f6f7f8;
    color: #556270;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .task-card h4 {
    margin: 0 0 0.7rem;
    color: #18324a;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .task-card > p {
    margin: 0 0 1rem;
    color: #556270;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .task-topic {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 0.9rem;
  }

  .task-topic strong {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .task-topic span {
    color: #556270;
    font-size: 0.9rem;
  }

  .task-settings {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .task-link {
    display: inline-flex;
    align-items: center;
    margin-top: auto;
    color: #18324a;
    font-weight: 800;
    text-decoration: none;
  }

  .task-link:hover {
    color: #e67e22;
  }

  .next-step {
    margin-top: 3.5rem;
    padding: 2rem;
    border: 1px solid rgba(230, 126, 34, 0.18);
    border-radius: 22px;
    background: #fff8f1;
  }

  .next-step h2 {
    margin: 0 0 0.8rem;
    color: #18324a;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .next-step p {
    max-width: 800px;
    margin: 0 0 1.2rem;
    color: #556270;
    line-height: 1.7;
  }

  .next-step a {
    color: #18324a;
    font-weight: 800;
    text-decoration: none;
  }

  .next-step a:hover {
    color: #e67e22;
  }

  @media (max-width: 760px) {
    .progress-box,
    .task-grid {
      grid-template-columns: 1fr;
    }

    .learning-section summary {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .summary-side {
      grid-column: 1 / -1;
      justify-content: space-between;
    }

    .task-card-top {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
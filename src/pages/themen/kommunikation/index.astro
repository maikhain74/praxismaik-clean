---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const themen = await getCollection("themen");

const categoryEntry = themen.find((entry) => entry.slug === "kommunikation");

if (!categoryEntry) {
  throw new Error('Kategorie "kommunikation" nicht gefunden.');
}

const subtopics = themen
  .filter((entry) => entry.slug.startsWith("kommunikation/"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "de"));

const { Content } = await categoryEntry.render();
---

<BaseLayout title="Kommunikation in der Pflege" description={categoryEntry.data.description}>
  <article class="content">
    <nav class="breadcrumbs">
      <a href="/">Start</a>
      <span class="breadcrumb-sep">›</span>
      <a href="/themen/">Themen</a>
      <span class="breadcrumb-sep">›</span>
      <span class="current">Kommunikation in der Pflege</span>
    </nav>

    <Content />

    <section class="related-topics" style="margin-top:32px;">
      <h2>Unterthemen</h2>

      <div class="topic-grid" style="margin-top:16px;">
        {subtopics.map((item) => (
          <a class="topic-card" href={`/themen/${item.slug}/`}>
            <h3>{item.data.title}</h3>
            {item.data.description ? <p>{item.data.description}</p> : null}
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
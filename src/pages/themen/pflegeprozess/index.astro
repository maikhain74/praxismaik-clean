---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const themen = await getCollection("themen");

const pflegeprozessThemen = themen
  .filter((t) =>
    t.slug.toLowerCase().includes("/pflegeprozess/")
  )
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "de"));

const topicDescriptions = {
  "pflegeprozess/pflegeprozess-grundlagen":
    "Verstehe den Aufbau und die Logik des Pflegeprozesses als zentrales Arbeitsmodell.",
  "pflegeprozess/informationssammlung":
    "Lerne, wie du Informationen systematisch erhebst und für die Pflegeplanung nutzt.",
  "pflegeprozess/pflegeprobleme-ressourcen":
    "Erkenne Pflegeprobleme und Ressourcen als Grundlage für gezielte Maßnahmen.",
  "pflegeprozess/pflegediagnosen":
    "Verstehe, wie Pflegediagnosen formuliert und im Pflegeprozess eingesetzt werden.",
  "pflegeprozess/pflegeziele":
    "Formuliere klare, erreichbare Pflegeziele als Orientierung für Maßnahmen.",
  "pflegeprozess/pflegemassnahmen":
    "Plane konkrete pflegerische Maßnahmen passend zu Problemen und Zielen.",
  "pflegeprozess/durchfuehrung":
    "Setze geplante Maßnahmen fachgerecht im Pflegealltag um.",
  "pflegeprozess/evaluation":
    "Überprüfe, ob Pflegeziele erreicht wurden und passe die Planung an.",
};

const topicTypes = [
  "Grundlage",
  "Assessment",
  "Analyse",
  "Diagnostik",
  "Planung",
  "Umsetzung",
  "Praxis",
  "Kontrolle",
];
---

<BaseLayout
  title="Pflegeprozess"
  description="Lerne den Pflegeprozess Schritt für Schritt: Informationssammlung, Pflegeprobleme, Ressourcen, Ziele, Maßnahmen, Durchführung und Evaluation."
>
  <main class="category-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span>›</span>
      <a href="/themen/">Themen</a>
      <span>›</span>
      <span>Pflegeprozess</span>
    </nav>

    <section class="category-hero">
      <p class="category-eyebrow">Themenbereich</p>
      <h1>Pflegeprozess</h1>
      <p class="category-intro">
        Der Pflegeprozess ist das zentrale Arbeitsmodell in der Pflege. Hier lernst du,
        Pflege systematisch zu planen, durchzuführen, zu überprüfen und fachlich zu begründen.
      </p>
    </section>

    <section class="category-panel">
      <h2>Warum Pflegeprozess wichtig ist</h2>

      <div class="info-grid">
        <article class="info-card">
          <h3>Struktur im Pflegealltag</h3>
          <p>
            Der Pflegeprozess hilft dir, Informationen zu ordnen und pflegerische Entscheidungen nachvollziehbar zu treffen.
          </p>
        </article>

        <article class="info-card">
          <h3>Gezielte Pflegeplanung</h3>
          <p>
            Du lernst, Pflegeprobleme, Ressourcen, Ziele und Maßnahmen sinnvoll miteinander zu verbinden.
          </p>
        </article>

        <article class="info-card">
          <h3>Wirksamkeit prüfen</h3>
          <p>
            Durch Evaluation erkennst du, ob Pflegeziele erreicht wurden oder ob die Planung angepasst werden muss.
          </p>
        </article>
      </div>
    </section>

    <section class="category-panel">
      <h2>Was du in diesem Bereich können solltest</h2>

      <ul class="learning-list">
        <li>Den Aufbau und die Schritte des Pflegeprozesses erklären.</li>
        <li>Informationen strukturiert sammeln und fachlich einordnen.</li>
        <li>Pflegeprobleme und Ressourcen erkennen und beschreiben.</li>
        <li>Pflegeziele verständlich und überprüfbar formulieren.</li>
        <li>Pflegemaßnahmen passend planen, durchführen und evaluieren.</li>
      </ul>
    </section>

<section class="category-panel">
  <h2>Das PESR-Schema einfach erklärt</h2>

  <p class="category-intro">
    Das PESR-Schema hilft dir dabei, Pflegeprobleme systematisch zu erkennen und fachlich korrekt zu formulieren.
    Es wird in der Pflegeplanung verwendet, um Probleme, Ursachen, Symptome und Ressourcen übersichtlich
    darzustellen. Dadurch können Pflegeziele und Maßnahmen gezielt geplant werden.
  </p>

  <div class="info-grid">
    <article class="info-card">
      <h3>P = Problem</h3>
      <p>Welches pflegerische Problem liegt vor?</p>

      <ul>
        <li>Eingeschränkte Mobilität</li>
        <li>Akuter Schmerz</li>
        <li>Selbstpflege eingeschränkt</li>
      </ul>
    </article>

    <article class="info-card">
      <h3>E = Einflussfaktoren</h3>
      <p>Warum besteht das Problem?</p>

      <ul>
        <li>Operation</li>
        <li>Schmerzen</li>
        <li>Schwäche</li>
        <li>Angst</li>
      </ul>
    </article>

    <article class="info-card">
      <h3>S = Symptome</h3>
      <p>Woran erkenne ich das Problem?</p>

      <ul>
        <li>Unsicherer Gang</li>
        <li>NRS 8 von 10</li>
        <li>Benötigt Unterstützung</li>
      </ul>
    </article>

    <article class="info-card">
      <h3>R = Ressourcen</h3>
      <p>Was kann die Person noch selbst?</p>

      <ul>
        <li>Mobilisation mit Rollator</li>
        <li>Kooperationsbereit</li>
        <li>Motiviert</li>
      </ul>
    </article>
  </div>

  <div class="category-panel" style="margin-top:2rem;">
    <h3>Prüfungsbeispiel</h3>

    <p>
      Frau Müller wurde vor zwei Tagen an der Hüfte operiert.
      Sie benötigt Hilfe beim Aufstehen und klagt über starke Schmerzen.
      Mit ihrem Rollator kann sie kurze Strecken gehen.
    </p>

    <p>
      <strong>P:</strong> Eingeschränkte Mobilität<br />
      <strong>E:</strong> Schmerzen nach Hüftoperation<br />
      <strong>S:</strong> Unsicherer Gang, Hilfe beim Aufstehen, Schmerzangabe NRS 7<br />
      <strong>R:</strong> Kann mit Rollator kurze Strecken gehen, motiviert zur Mitarbeit
    </p>
  </div>

  <div class="category-panel" style="margin-top:2rem;">
    <h3>Typische Prüfungsfehler</h3>

    <ul class="learning-list">
      <li>Ursachen und Symptome verwechseln.</li>
      <li>Ressourcen vergessen.</li>
      <li>Medizinische Diagnosen statt Pflegeprobleme formulieren.</li>
      <li>Pflegediagnosen ohne Beobachtungen begründen.</li>
      <li>PESR nicht vollständig darstellen.</li>
    </ul>
  </div>

  <div class="category-panel" style="margin-top:2rem;">
    <h3>Merksatz</h3>

    <p>
      Das PESR-Schema beantwortet vier Fragen:
      <strong>Was ist das Problem?</strong>,
      <strong>Warum besteht es?</strong>,
      <strong>Woran erkenne ich es?</strong> und
      <strong>Was kann die Person noch selbst?</strong>
    </p>
  </div>
</section>

    <section class="category-panel">
      <div class="topics-head">
        <div>
          <p class="category-eyebrow">Übersicht</p>
          <h2>Pflegeprozess Schritt für Schritt lernen</h2>
        </div>

        <span class="topic-count-badge">{pflegeprozessThemen.length} Themen</span>
      </div>

<section class="pflegeprozess-info">

      <div class="topic-grid">
        {pflegeprozessThemen.map((topic, index) => (
          <a class="topic-card" href={`/themen/${topic.slug}/`}>
            <div class="topic-card-top">
              <span class="topic-step">Thema {index + 1}</span>
              <span class="topic-type">{topicTypes[index] ?? "Pflegeplanung"}</span>
            </div>

            <h3>{topic.data.title}</h3>

            <p>
              {
                topic.data.beschreibung ??
                topic.data.description ??
                topicDescriptions[topic.slug] ??
                "Lerne dieses Thema im Pflegeprozess und seine Bedeutung für die Pflegepraxis kennen."
              }
            </p>

            <span class="topic-card-link">Thema öffnen →</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .category-page {
    display: grid;
    gap: 24px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: #64748b;
    font-size: 0.95rem;
  }

  .breadcrumb a {
    color: #2563eb;
    text-decoration: none;
  }

  .category-hero,
  .category-panel {
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    background: #ffffff;
    padding: 28px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
  }

  .category-hero {
    background: linear-gradient(135deg, #eff6ff 0%, #ffffff 58%, #f8fafc 100%);
  }

  .category-eyebrow {
    margin: 0 0 10px;
    color: #2563eb;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 4vw, 3.4rem);
    line-height: 1.05;
    color: #0f172a;
  }

  .category-intro {
    max-width: 760px;
    margin: 16px 0 0;
    color: #475569;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .category-panel h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: 1.45rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .info-card {
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: #ffffff;
    padding: 22px;
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.05);
  }

  .info-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 1.08rem;
  }

  .info-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.65;
  }

  .learning-list {
    margin: 0;
    padding-left: 20px;
    color: #475569;
    line-height: 1.8;
  }

  .topics-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .topics-head h2 {
    margin-bottom: 0;
  }

  .topic-count-badge {
    flex: 0 0 auto;
    border-radius: 999px;
    background: #dbeafe;
    color: #1d4ed8;
    padding: 8px 14px;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .topic-card {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: #ffffff;
    padding: 22px;
    text-decoration: none;
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.05);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .topic-card:hover {
    transform: translateY(-3px);
    border-color: #bfdbfe;
    box-shadow: 0 18px 38px rgba(37, 99, 235, 0.12);
  }

  .topic-card-top {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .topic-step,
  .topic-type {
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .topic-step {
    background: #eff6ff;
    color: #2563eb;
  }

  .topic-type {
    background: #f1f5f9;
    color: #475569;
  }

  .topic-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 1.12rem;
  }

  .topic-card p {
    margin: 0 0 20px;
    color: #64748b;
    line-height: 1.65;
  }

  .topic-card-link {
    margin-top: auto;
    color: #2563eb;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .info-grid,
    .topic-grid {
      grid-template-columns: 1fr;
    }

    .topics-head {
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .category-hero,
    .category-panel {
      padding: 22px;
      border-radius: 20px;
    }

    .topic-card {
      min-height: auto;
    }
  }

  .pflegeprozess-info {
  margin-top: 2rem;
}

.pflegeprozess-info h2 {
  margin-bottom: 1rem;
}

.pesr-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1rem;
  margin: 2rem 0;
}

.pesr-card {
  background: #fff;
  border: 1px solid #e7e1d8;
  border-radius: 18px;
  padding: 1.5rem;
  min-width: 0;
  overflow-wrap: anywhere;
  word-break: normal;
}

.pesr-card ul {
  padding-left: 1.2rem;
  margin-bottom: 0;
}

.pesr-card li {
  line-height: 1.45;
  margin-bottom: 0.4rem;
}

.pesr-card h3 {
  margin-bottom: 0.75rem;
}

.pesr-example {
  background: #f8fafc;
  border-radius: 18px;
  padding: 1.5rem;
  margin-top: 2rem;
}

.pesr-example-grid {
  display: grid;
  gap: 1rem;
  margin-top: 1rem;
}

.exam-tip {
  background: #fff8ec;
  border-left: 4px solid #c97b63;
  padding: 1rem;
  margin-top: 2rem;
  border-radius: 12px;
}

.info-card {
  min-width: 0;
  overflow-wrap: anywhere;
}
</style>
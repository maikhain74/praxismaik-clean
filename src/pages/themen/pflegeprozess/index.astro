---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const themen = await getCollection("themen");

const pflegeprozessReihenfolge = [
  "pflegeprozess-grundlagen",
  "informationssammlung",
  "pflegeprobleme-ressourcen",
  "pflegediagnosen",
  "pesr-schema",
  "pflegeziele",
  "pflegemassnahmen",
  "durchfuehrung",
  "evaluation",
  "vorbehaltsaufgaben",
  "vorbehaltsaufgaben-beispiele",
  "vorbehaltsaufgaben-fallbeispiele",
  "vorbehaltsaufgaben-pflegepruefung",
  "pflegediagnosen-bei-asthma",
  "pflegediagnosen-bei-copd",
  "pflegediagnosen-beispiele-pesr",
  "pflegediagnosen-fallbeispiele",
  "pflegediagnosen-in-der-pflegepruefung",
];

const getDateiname = (slug) => {
  const teile = slug.split("/");
  return teile[teile.length - 1];
};

const getReihenfolge = (slug) => {
  const dateiname = getDateiname(slug);
  const position = pflegeprozessReihenfolge.indexOf(dateiname);

  return position === -1
    ? 999
    : position;
};

const pflegeprozessThemen = themen
  .filter((thema) =>
    thema.slug.startsWith("pflegeausbildung/pflegeprozess/")
  )
  .sort((a, b) => {
    const reihenfolgeA = getReihenfolge(a.slug);
    const reihenfolgeB = getReihenfolge(b.slug);

    if (reihenfolgeA !== reihenfolgeB) {
      return reihenfolgeA - reihenfolgeB;
    }

    return a.data.title.localeCompare(b.data.title, "de");
  });

const topicDescriptions = {
  "pflegeprozess-grundlagen":
    "Verstehe den Aufbau und die Logik des Pflegeprozesses als zentrales Arbeitsmodell.",
  informationssammlung:
    "Lerne, wie du Informationen systematisch erhebst und für die Pflegeplanung nutzt.",
  "pflegeprobleme-ressourcen":
    "Erkenne Pflegeprobleme und Ressourcen als Grundlage für gezielte Maßnahmen.",
  pflegediagnosen:
    "Verstehe, wie Pflegediagnosen formuliert und im Pflegeprozess eingesetzt werden.",
  "pesr-schema":
    "Lerne, Pflegediagnosen mit dem PESR-Schema systematisch zu formulieren.",
  pflegeziele:
    "Formuliere klare, erreichbare und überprüfbare Pflegeziele.",
  pflegemassnahmen:
    "Plane konkrete pflegerische Maßnahmen passend zu Problemen, Ressourcen und Zielen.",
  durchfuehrung:
    "Setze geplante Pflegemaßnahmen fachgerecht und individuell um.",
  evaluation:
    "Überprüfe die Wirksamkeit der Pflege und passe die Planung bei Bedarf an.",
  vorbehaltsaufgaben:
    "Verstehe die vorbehaltenen Aufgaben der Pflegefachperson im Pflegeprozess.",
  "vorbehaltsaufgaben-beispiele":
    "Ordne typische Aufgaben aus dem Pflegealltag den Vorbehaltsaufgaben zu.",
  "vorbehaltsaufgaben-fallbeispiele":
    "Wende dein Wissen zu den Vorbehaltsaufgaben in realistischen Fällen an.",
  "vorbehaltsaufgaben-pflegepruefung":
    "Bereite dich auf Prüfungsfragen zu Pflegeprozess und Vorbehaltsaufgaben vor.",
  "pflegediagnosen-bei-asthma":
    "Übertrage Pflegediagnosen auf eine pflegerische Situation bei Asthma.",
  "pflegediagnosen-bei-copd":
    "Übertrage Pflegediagnosen auf eine pflegerische Situation bei COPD.",
  "pflegediagnosen-beispiele-pesr":
    "Vertiefe das PESR-Schema mit konkreten Beispielen für Pflegediagnosen.",
  "pflegediagnosen-fallbeispiele":
    "Trainiere Pflegediagnosen anhand realistischer Fallsituationen.",
  "pflegediagnosen-in-der-pflegepruefung":
    "Bereite dich gezielt auf Pflegediagnosen in der Pflegeprüfung vor.",
};

const topicTypes = {
  "pflegeprozess-grundlagen": "Grundlage",
  informationssammlung: "Schritt 1",
  "pflegeprobleme-ressourcen": "Schritt 2",
  pflegediagnosen: "Schritt 2",
  "pesr-schema": "Schritt 2",
  pflegeziele: "Schritt 3",
  pflegemassnahmen: "Schritt 4",
  durchfuehrung: "Schritt 5",
  evaluation: "Schritt 6",
  vorbehaltsaufgaben: "Verantwortung",
  "vorbehaltsaufgaben-beispiele": "Vertiefung",
  "vorbehaltsaufgaben-fallbeispiele": "Anwendung",
  "vorbehaltsaufgaben-pflegepruefung": "Prüfung",
  "pflegediagnosen-bei-asthma": "Praxisbeispiel",
  "pflegediagnosen-bei-copd": "Praxisbeispiel",
  "pflegediagnosen-beispiele-pesr": "Vertiefung",
  "pflegediagnosen-fallbeispiele": "Anwendung",
  "pflegediagnosen-in-der-pflegepruefung": "Prüfung",
};
---

<BaseLayout
  title="Pflegeprozess"
  description="Lerne den Pflegeprozess Schritt für Schritt: Informationssammlung, Pflegeprobleme, Ressourcen, Ziele, Maßnahmen, Durchführung und Evaluation."
>
  <main class="category-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span>›</span>
      <a href="/themen/">Themen</a>
      <span>›</span>
      <span>Pflegeprozess</span>
    </nav>

    <section class="category-hero">
      <p class="category-eyebrow">Themenbereich</p>

      <h1>Pflegeprozess</h1>

      <p class="category-intro">
        Der Pflegeprozess ist das zentrale Arbeitsmodell in der Pflege. Hier
        lernst du, Pflege systematisch zu planen, durchzuführen, zu überprüfen
        und fachlich zu begründen.
      </p>
    </section>

    <section class="category-panel">
      <h2>Warum der Pflegeprozess wichtig ist</h2>

      <div class="info-grid">
        <article class="info-card">
          <h3>Struktur im Pflegealltag</h3>

          <p>
            Der Pflegeprozess hilft dir, Informationen zu ordnen und
            pflegerische Entscheidungen nachvollziehbar zu treffen.
          </p>
        </article>

        <article class="info-card">
          <h3>Gezielte Pflegeplanung</h3>

          <p>
            Du lernst, Pflegeprobleme, Ressourcen, Ziele und Maßnahmen sinnvoll
            miteinander zu verbinden.
          </p>
        </article>

        <article class="info-card">
          <h3>Wirksamkeit prüfen</h3>

          <p>
            Durch die Evaluation erkennst du, ob Pflegeziele erreicht wurden
            oder ob die Planung angepasst werden muss.
          </p>
        </article>
      </div>
    </section>

    <section class="category-panel">
      <h2>Was du in diesem Bereich können solltest</h2>

      <ul class="learning-list">
        <li>Den Aufbau und die Schritte des Pflegeprozesses erklären.</li>
        <li>Informationen strukturiert sammeln und fachlich einordnen.</li>
        <li>Pflegeprobleme und Ressourcen erkennen und beschreiben.</li>
        <li>Pflegeziele verständlich und überprüfbar formulieren.</li>
        <li>
          Pflegemaßnahmen passend planen, durchführen und evaluieren.
        </li>
      </ul>
    </section>

    <section class="category-panel">
      <div class="topics-head">
        <div>
          <p class="category-eyebrow">Übersicht</p>
          <h2>Pflegeprozess Schritt für Schritt lernen</h2>
        </div>

        <span class="topic-count-badge">
          {pflegeprozessThemen.length} Themen
        </span>
      </div>

      <div class="topic-grid">
        {pflegeprozessThemen.map((topic, index) => {
          const dateiname = getDateiname(topic.slug);

          return (
            <a class="topic-card" href={`/themen/${topic.slug}/`}>
              <div class="topic-card-top">
                <span class="topic-step">
                  Thema {index + 1}
                </span>

                <span class="topic-type">
                  {topicTypes[dateiname] ?? "Vertiefung"}
                </span>
              </div>

              <h3>{topic.data.title}</h3>

              <p>
                {
                  topic.data.beschreibung ??
                  topic.data.description ??
                  topicDescriptions[dateiname] ??
                  "Lerne dieses Thema im Pflegeprozess und seine Bedeutung für die Pflegepraxis kennen."
                }
              </p>

              <span class="topic-card-link">
                Thema öffnen →
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .category-page {
    display: grid;
    gap: 24px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: #64748b;
    font-size: 0.95rem;
  }

  .breadcrumb a {
    color: #2563eb;
    text-decoration: none;
  }

  .category-hero,
  .category-panel {
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    background: #ffffff;
    padding: 28px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
  }

  .category-hero {
    background:
      linear-gradient(
        135deg,
        #eff6ff 0%,
        #ffffff 58%,
        #f8fafc 100%
      );
  }

  .category-eyebrow {
    margin: 0 0 10px;
    color: #2563eb;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 4vw, 3.4rem);
    line-height: 1.05;
    color: #0f172a;
  }

  .category-intro {
    max-width: 760px;
    margin: 16px 0 0;
    color: #475569;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .category-panel h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: 1.45rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .info-card {
    min-width: 0;
    overflow-wrap: anywhere;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: #ffffff;
    padding: 22px;
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.05);
  }

  .info-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 1.08rem;
  }

  .info-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.65;
  }

  .learning-list {
    margin: 0;
    padding-left: 20px;
    color: #475569;
    line-height: 1.8;
  }

  .topics-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .topics-head h2 {
    margin-bottom: 0;
  }

  .topic-count-badge {
    flex: 0 0 auto;
    border-radius: 999px;
    background: #dbeafe;
    color: #1d4ed8;
    padding: 8px 14px;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .topic-card {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: #ffffff;
    padding: 22px;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.05);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .topic-card:hover {
    transform: translateY(-3px);
    border-color: #bfdbfe;
    box-shadow: 0 18px 38px rgba(37, 99, 235, 0.12);
  }

  .topic-card-top {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .topic-step,
  .topic-type {
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .topic-step {
    background: #eff6ff;
    color: #2563eb;
  }

  .topic-type {
    background: #f1f5f9;
    color: #475569;
  }

  .topic-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 1.12rem;
  }

  .topic-card p {
    margin: 0 0 20px;
    color: #64748b;
    line-height: 1.65;
  }

  .topic-card-link {
    margin-top: auto;
    color: #2563eb;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .info-grid,
    .topic-grid {
      grid-template-columns: 1fr;
    }

    .topics-head {
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .category-hero,
    .category-panel {
      padding: 22px;
      border-radius: 20px;
    }

    .topic-card {
      min-height: auto;
    }
  }
</style>
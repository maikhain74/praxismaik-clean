---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("themen");

const categoryEntry = entries.find((entry) => entry.slug === "prophylaxen");

const prophylaxenTopics = entries
  .filter((entry) => entry.slug.startsWith("prophylaxen/"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "de"));
---

<BaseLayout
  title="Prophylaxen | PraxisMaik"
  description={categoryEntry?.data.description ?? "Prophylaxen für die Pflegeausbildung verständlich und strukturiert lernen."}
>
  <section class="category-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span class="breadcrumb-sep">›</span>
      <a href="/themen/">Themen</a>
      <span class="breadcrumb-sep">›</span>
      <span class="current">Prophylaxen</span>
    </nav>

    <header class="category-hero">
      <span class="category-eyebrow">Themenbereich</span>
      <h1>Prophylaxen</h1>
      <p class="category-intro">
        Prophylaxen gehören zum pflegerischen Kern. Du musst Risiken früh erkennen,
        gefährdete Personen einschätzen und passende Maßnahmen sicher ableiten.
      </p>
    </header>

    <section class="category-panel">
      <h2>Warum Prophylaxen wichtig sind</h2>
      <div class="info-grid">
        <div class="info-card">
          <h3>Risiken früh erkennen</h3>
          <p>
            Viele pflegerische Probleme entstehen nicht plötzlich, sondern kündigen
            sich an. Gute Pflege beginnt deshalb mit genauer Beobachtung.
          </p>
        </div>

        <div class="info-card">
          <h3>Komplikationen vermeiden</h3>
          <p>
            Prophylaxen helfen, Schäden wie Dekubitus, Stürze oder Thrombosen
            möglichst früh zu verhindern.
          </p>
        </div>

        <div class="info-card">
          <h3>Prüfungsrelevant in fast allen Bereichen</h3>
          <p>
            Prophylaxen tauchen in Prüfungen ständig auf, oft eingebettet in
            Fallsituationen und pflegerische Entscheidungen.
          </p>
        </div>
      </div>
    </section>

    <section class="category-panel">
      <h2>Was du in diesem Bereich können solltest</h2>
      <ul class="learning-list">
        <li>Risikofaktoren systematisch erkennen</li>
        <li>gefährdete Personen und Situationen richtig einschätzen</li>
        <li>passende prophylaktische Maßnahmen begründet auswählen</li>
        <li>Pflegehandlungen nachvollziehbar erklären und priorisieren</li>
      </ul>
    </section>

    <section class="category-panel">
      <div class="topics-head">
        <div>
          <h2>Alle Themen zu Prophylaxen</h2>
          <p class="muted">
            Arbeite die einzelnen Prophylaxen Schritt für Schritt durch und achte
            immer auf Risiko, Ziel und Maßnahme.
          </p>
        </div>
        <div class="topic-count-badge">
          {prophylaxenTopics.length} {prophylaxenTopics.length === 1 ? "Thema" : "Themen"}
        </div>
      </div>

      {prophylaxenTopics.length > 0 ? (
        <div class="topic-grid">
          {prophylaxenTopics.map((topic) => (
            <a class="topic-card" href={`/themen/${topic.slug}/`}>
              <h3>{topic.data.title}</h3>
              <p>{topic.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Noch keine Prophylaxen-Themen vorhanden.</p>
        </div>
      )}
    </section>
  </section>
</BaseLayout>

<style is:global>
.category-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2.5rem 1rem 3.5rem;
}

.category-hero {
  max-width: 760px;
  margin-top: 0.5rem;
  margin-bottom: 2rem;
}

.category-eyebrow {
  display: inline-block;
  margin-bottom: 0.6rem;
  padding: 0.35rem 0.65rem;
  border-radius: 999px;
  background: #eef5ff;
  color: #2f5f9b;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.category-hero h1 {
  margin: 0 0 0.75rem;
  font-size: clamp(2rem, 3vw, 2.7rem);
  line-height: 1.12;
}

.category-intro {
  max-width: 58ch;
  margin: 0;
  color: #5b6b7a;
  line-height: 1.7;
}

.category-panel + .category-panel {
  margin-top: 2rem;
}

.category-panel {
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 20px;
  padding: 1.5rem;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.04);
}

.category-panel h2 {
  margin-top: 0;
  margin-bottom: 0.9rem;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

.info-card {
  background: #f8fbff;
  border: 1px solid #dbe7f5;
  border-radius: 16px;
  padding: 1.1rem;
}

.info-card h3 {
  margin: 0 0 0.45rem;
  font-size: 1rem;
}

.info-card p {
  margin: 0;
  color: #556270;
  line-height: 1.55;
}

.learning-list {
  margin: 0;
  padding-left: 1.2rem;
}

.learning-list li + li {
  margin-top: 0.55rem;
}

.topics-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 1rem;
}

.topic-count-badge {
  flex-shrink: 0;
  padding: 0.5rem 0.8rem;
  border-radius: 999px;
  background: #eef5ff;
  color: #2f5f9b;
  font-size: 0.9rem;
  font-weight: 700;
}

.topic-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

.topic-card {
  display: block;
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 16px;
  padding: 1.2rem;
  text-decoration: none;
  color: inherit;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

.topic-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 28px rgba(24, 50, 74, 0.08);
  border-color: #cfdceb;
}

.topic-card h3 {
  margin: 0 0 0.45rem;
  font-size: 1.02rem;
}

.topic-card p {
  margin: 0;
  color: #556270;
  line-height: 1.55;
}

.empty-state {
  padding: 1rem 0 0;
  color: #5b6b7a;
}

@media (max-width: 900px) {
  .info-grid,
  .topic-grid {
    grid-template-columns: 1fr;
  }

  .topics-head {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>
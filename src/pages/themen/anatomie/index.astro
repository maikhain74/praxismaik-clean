---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("themen");

const categoryEntry = entries.find((entry) => entry.slug === "anatomie");

const anatomyTopics = entries
  .filter((entry) => entry.slug.startsWith("anatomie/"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "de"));
---

<BaseLayout
  title="Anatomie | PraxisMaik"
  description={categoryEntry?.data.description ?? "Anatomie für die Pflegeausbildung verständlich und strukturiert lernen."}
>
  <section class="category-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span class="breadcrumb-sep">›</span>
      <a href="/themen/">Themen</a>
      <span class="breadcrumb-sep">›</span>
      <span class="current">Anatomie</span>
    </nav>

    <header class="category-hero">
      <span class="category-eyebrow">Themenbereich</span>
      <h1>Anatomie</h1>
      <p class="category-intro">
        Anatomie hilft dir, den menschlichen Körper zu verstehen. Ohne dieses
        Grundwissen kannst du Beobachtungen, Symptome und pflegerische Maßnahmen
        nicht sauber einordnen.
      </p>
    </header>

    <section class="category-panel">
      <h2>Warum Anatomie wichtig ist</h2>
      <div class="info-grid">
        <div class="info-card">
          <h3>Grundlage für Pflegewissen</h3>
          <p>
            Du verstehst, wie Organe, Gewebe und Körpersysteme aufgebaut sind
            und worauf pflegerische Beobachtungen beruhen.
          </p>
        </div>

        <div class="info-card">
          <h3>Besseres Verständnis von Krankheiten</h3>
          <p>
            Krankheitslehre wird erst dann wirklich logisch, wenn du weißt,
            wie der gesunde Körper funktioniert.
          </p>
        </div>

        <div class="info-card">
          <h3>Sicherer in Prüfungen</h3>
          <p>
            Anatomisches Grundwissen taucht in vielen Prüfungsfragen indirekt
            auf, auch wenn nicht ausdrücklich nach Anatomie gefragt wird.
          </p>
        </div>
      </div>
    </section>

    <section class="category-panel">
      <h2>Was du in diesem Bereich können solltest</h2>
      <ul class="learning-list">
        <li>Körperstrukturen und Gewebearten sicher benennen</li>
        <li>Organe und Organsysteme grundlegend einordnen</li>
        <li>Zusammenhänge zwischen Aufbau und Funktion verstehen</li>
        <li>Anatomisches Wissen auf Pflegepraxis und Krankheitslehre übertragen</li>
      </ul>
    </section>

    <section class="category-panel">
      <div class="topics-head">
        <div>
          <h2>Alle Anatomie-Themen</h2>
          <p class="muted">
            Lerne die Inhalte Schritt für Schritt und arbeite dich systematisch
            durch den Bereich.
          </p>
        </div>
        <div class="topic-count-badge">
          {anatomyTopics.length} {anatomyTopics.length === 1 ? "Thema" : "Themen"}
        </div>
      </div>

      {anatomyTopics.length > 0 ? (
        <div class="topic-grid">
          {anatomyTopics.map((topic) => (
            <a class="topic-card" href={`/themen/${topic.slug}/`}>
              <h3>{topic.data.title}</h3>
              <p>{topic.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Noch keine Anatomie-Themen vorhanden.</p>
        </div>
      )}
    </section>
  </section>
</BaseLayout>

<style is:global>
.category-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2.5rem 1rem 3.5rem;
}

.category-hero {
  max-width: 760px;
  margin-top: 0.5rem;
  margin-bottom: 2rem;
}

.category-eyebrow {
  display: inline-block;
  margin-bottom: 0.6rem;
  padding: 0.35rem 0.65rem;
  border-radius: 999px;
  background: #eef5ff;
  color: #2f5f9b;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.category-hero h1 {
  margin: 0 0 0.75rem;
  font-size: clamp(2rem, 3vw, 2.7rem);
  line-height: 1.12;
}

.category-intro {
  max-width: 58ch;
  margin: 0;
  color: #5b6b7a;
  line-height: 1.7;
}

.category-panel + .category-panel {
  margin-top: 2rem;
}

.category-panel {
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 20px;
  padding: 1.5rem;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.04);
}

.category-panel h2 {
  margin-top: 0;
  margin-bottom: 0.9rem;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

.info-card {
  background: #f8fbff;
  border: 1px solid #dbe7f5;
  border-radius: 16px;
  padding: 1.1rem;
}

.info-card h3 {
  margin: 0 0 0.45rem;
  font-size: 1rem;
}

.info-card p {
  margin: 0;
  color: #556270;
  line-height: 1.55;
}

.learning-list {
  margin: 0;
  padding-left: 1.2rem;
}

.learning-list li + li {
  margin-top: 0.55rem;
}

.topics-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 1rem;
}

.topic-count-badge {
  flex-shrink: 0;
  padding: 0.5rem 0.8rem;
  border-radius: 999px;
  background: #eef5ff;
  color: #2f5f9b;
  font-size: 0.9rem;
  font-weight: 700;
}

.topic-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

.topic-card,
.topic-card:link,
.topic-card:visited {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 250px;
  padding: 1.35rem;
  border-radius: 18px;
  border: 1px solid #e5e5e5;
  background: #ffffff;
  text-decoration: none;
  color: inherit !important;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

.topic-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 30px rgba(24, 50, 74, 0.08);
  border-color: #cfdceb;
}

.topic-card h3 {
  margin: 0 0 0.75rem 0;
  font-size: 1.08rem;
  line-height: 1.35;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.topic-card p {
  margin: 0;
  color: #556270 !important;
  line-height: 1.6;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.empty-state {
  padding: 1rem 0 0;
  color: #5b6b7a;
}

@media (max-width: 900px) {
  .info-grid {
    grid-template-columns: 1fr;
  }

  .topic-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .topics-head {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 640px) {
  .topic-grid {
    grid-template-columns: 1fr;
  }
}
</style>
---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import TopicGrid from "../../../components/krankheitslehre/TopicGrid.astro";
import ClusterSection from "../../../components/krankheitslehre/ClusterSection.astro";
import { gruppenConfig } from "../../../data/krankheitslehre/gruppenConfig";
import {
  gruppenZuordnung,
  type GruppenKey,
} from "../../../data/krankheitslehre/gruppenZuordnung";
import { clusterRegistry } from "../../../data/krankheitslehre/clusterRegistry";
import { getCluster } from "../../../data/krankheitslehre/getCluster";

const themen = await getCollection("themen");

const krankheitslehreThemen = themen
  .filter((t) => t.slug.toLowerCase().startsWith("krankheitslehre/"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "de"));

const getGroupKey = (topic): GruppenKey => {
  const slug = topic.slug.toLowerCase();

  for (const [gruppe, begriffe] of Object.entries(gruppenZuordnung)) {
    if (begriffe.some((begriff) => slug.includes(begriff))) {
      return gruppe as GruppenKey;
    }
  }

  return "weitere";
};

const gruppen = gruppenConfig
  .map((group) => ({
    ...group,
    items: krankheitslehreThemen
      .filter((topic) => getGroupKey(topic) === group.key)
      .sort((a, b) => a.data.title.localeCompare(b.data.title, "de")),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout
  title="Krankheitslehre | PraxisMaik"
  description="Krankheitslehre für die Pflegeausbildung verständlich, praxisnah und prüfungsrelevant lernen."
>
  <section class="category-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span class="breadcrumb-sep">›</span>
      <a href="/themen/">Themen</a>
      <span class="breadcrumb-sep">›</span>
      <span class="current">Krankheitslehre</span>
    </nav>

    <header class="category-hero">
      <span class="category-eyebrow">Themenbereich</span>

      <h1>Krankheitslehre</h1>

      <p class="category-intro">
        Krankheitslehre hilft dir, Symptome, Risiken und Verläufe besser zu verstehen.
        Du lernst, Veränderungen zu erkennen, pflegerisch einzuordnen und daraus sinnvolle Maßnahmen abzuleiten.
      </p>
    </header>

    <section class="category-panel">
      <h2>Warum Krankheitslehre wichtig ist</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Symptome erkennen</h3>

          <p>
            Du lernst, typische Krankheitszeichen zu beobachten und fachlich richtig einzuordnen.
          </p>
        </div>

        <div class="info-card">
          <h3>Risiken verstehen</h3>

          <p>
            Du erkennst mögliche Komplikationen früher und weißt, wann eine Situation kritisch wird.
          </p>
        </div>

        <div class="info-card">
          <h3>Pflege begründen</h3>

          <p>
            Du verbindest Krankheitswissen mit konkretem pflegerischem Handeln und sicheren Entscheidungen.
          </p>
        </div>
      </div>
    </section>

    <section class="category-panel">
      <h2>Was du in diesem Bereich können solltest</h2>

      <ul class="learning-list">
        <li>Krankheitsbilder mit Ursachen, Symptomen und Verlauf erklären</li>
        <li>wichtige Beobachtungsschwerpunkte sicher benennen</li>
        <li>Warnzeichen und Komplikationen frühzeitig erkennen</li>
        <li>pflegerische Maßnahmen aus dem Krankheitsbild ableiten</li>
      </ul>
    </section>

    <section class="category-panel">
      <div class="topics-head">
        <div>
          <h2>Alle Krankheitslehre-Themen</h2>

          <p class="muted">
            Arbeite dich Schritt für Schritt durch wichtige Krankheitsbilder und Pflegebezüge.
          </p>
        </div>

        <div class="topic-count-badge">
          {krankheitslehreThemen.length}
          {krankheitslehreThemen.length === 1 ? "Thema" : "Themen"}
        </div>
      </div>

      {gruppen.length > 0 ? (
        <div class="disease-groups">
          {gruppen.map((group) => {
            const clusterDefinition = clusterRegistry[group.key];

            return (
              <section class="disease-group">
                <div class="disease-group-head">
                  <div>
                    <h3>{group.title}</h3>
                    <p>{group.description}</p>
                  </div>

                  <span class="disease-group-count">
                    {group.items.length}
                    {group.items.length === 1 ? "Thema" : "Themen"}
                  </span>
                </div>

            {clusterDefinition ? (
  <ClusterSection
    clusters={getCluster(group.items, clusterDefinition)}
  />
) : (
  <TopicGrid items={group.items} />
)}
              </section>
            );
          })}
        </div>
      ) : (
        <div class="empty-state">
          <p>Noch keine Krankheitslehre-Themen vorhanden.</p>
        </div>
      )}
    </section>
  </section>
</BaseLayout>

<style is:global>
  .category-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1rem 3.5rem;
  }

  .category-hero {
    max-width: 760px;
    margin-top: 0.5rem;
    margin-bottom: 2rem;
  }

  .category-eyebrow {
    display: inline-block;
    margin-bottom: 0.6rem;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #eef5ff;
    color: #2f5f9b;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .category-hero h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 3vw, 2.7rem);
    line-height: 1.12;
  }

  .category-intro {
    max-width: 58ch;
    margin: 0;
    color: #5b6b7a;
    line-height: 1.7;
  }

  .category-panel + .category-panel {
    margin-top: 2rem;
  }

  .category-panel {
    padding: 1.5rem;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 20px;
    box-shadow: 0 10px 24px rgba(24, 50, 74, 0.04);
  }

  .category-panel h2 {
    margin-top: 0;
    margin-bottom: 0.9rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .info-card {
    padding: 1.1rem;
    background: #f8fbff;
    border: 1px solid #dbe7f5;
    border-radius: 16px;
  }

  .info-card h3 {
    margin: 0 0 0.45rem;
    font-size: 1rem;
  }

  .info-card p {
    margin: 0;
    color: #556270;
    line-height: 1.55;
  }

  .learning-list {
    margin: 0;
    padding-left: 1.2rem;
  }

  .learning-list li + li {
    margin-top: 0.55rem;
  }

  .topics-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .topic-count-badge,
  .disease-group-count {
    flex-shrink: 0;
    padding: 0.5rem 0.8rem;
    background: #eef5ff;
    border-radius: 999px;
    color: #2f5f9b;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .disease-groups {
    display: grid;
    gap: 2rem;
  }

  .disease-group {
    padding-top: 1.25rem;
    border-top: 1px solid #e5e7eb;
  }

  .disease-group:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .disease-group-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .disease-group-head h3 {
    margin: 0 0 0.35rem;
    color: #18324a;
    font-size: 1.25rem;
  }

  .disease-group-head p {
    margin: 0;
    color: #556270;
    line-height: 1.6;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .topic-card,
  .topic-card:link,
  .topic-card:visited {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 250px;
    padding: 1.35rem;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 18px;
    box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
    color: inherit !important;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }

  .topic-card:hover {
    transform: translateY(-4px);
    border-color: #cfdceb;
    box-shadow: 0 16px 30px rgba(24, 50, 74, 0.08);
  }

  .topic-card-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }

  .topic-step,
  .topic-type {
    display: inline-flex;
    align-items: center;
    padding: 0.32rem 0.65rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
  }

  .topic-step {
    background: #eef5ff;
    color: #18324a;
  }

  .topic-type {
    background: #fff4e8;
    color: #9a3412;
  }

  .topic-card h3 {
    margin: 0 0 0.75rem;
    font-size: 1.08rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .topic-card p {
    margin: 0;
    color: #556270 !important;
    line-height: 1.6;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .topic-card-link {
    margin-top: auto;
    color: #18324a;
    font-weight: 700;
  }

  .empty-state {
    padding: 1rem 0 0;
    color: #5b6b7a;
  }

  @media (max-width: 900px) {
    .info-grid {
      grid-template-columns: 1fr;
    }

    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .topics-head,
    .disease-group-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 640px) {
    .topic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
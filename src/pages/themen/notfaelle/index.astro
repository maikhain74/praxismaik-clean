---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const themen = await getCollection("themen");

const notfaelleThemen = themen
  .filter((t) => t.slug.toLowerCase().startsWith("notfaelle/"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "de"));

const topicDescriptions = {
  "notfaelle/atemnot":
    "Erkenne Atemnot schnell und leite sofortige pflegerische Maßnahmen ein.",
  "notfaelle/bewusstlosigkeit":
    "Handle sicher bei Bewusstlosigkeit und erkenne lebensbedrohliche Situationen.",
  "notfaelle/herzinfarkt-erkennen":
    "Lerne typische Anzeichen eines Herzinfarkts und reagiere ohne Zeitverlust.",
  "notfaelle/schlaganfall-erkennen":
    "Erkenne Schlaganfall-Symptome frühzeitig und handle strukturiert.",
  "notfaelle/hypoglykaemie":
    "Erkenne Unterzuckerung und reagiere schnell und richtig im Pflegealltag.",
  "notfaelle/anaphylaxie":
    "Verstehe die Anzeichen einer Anaphylaxie und handle sofort bei dieser lebensbedrohlichen Reaktion.",
  "notfaelle/reanimation-grundlagen":
    "Lerne die Grundlagen der Reanimation und deine Rolle im Notfall.",
};

const topicTypes = [
  "Akut",
  "Sicherheit",
  "Herz",
  "Neurologie",
  "Stoffwechsel",
  "Allergie",
  "Reanimation",
];
---

<BaseLayout
  title="Notfälle in der Pflege"
  description="Lerne wichtige Notfälle in der Pflege sicher zu erkennen und richtig zu reagieren: Atemnot, Bewusstlosigkeit, Herzinfarkt, Schlaganfall, Hypoglykämie, Anaphylaxie und Reanimation."
>
  <main class="category-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span>›</span>
      <a href="/themen/">Themen</a>
      <span>›</span>
      <span>Notfälle in der Pflege</span>
    </nav>

    <section class="category-hero">
      <p class="category-eyebrow">Themenbereich</p>
      <h1>Notfälle in der Pflege</h1>
      <p class="category-intro">
        In Notfallsituationen zählt jede Minute. Hier lernst du, kritische Situationen
        schnell zu erkennen, Prioritäten zu setzen und sicher zu handeln.
      </p>
    </section>

    <section class="category-panel">
      <h2>Warum Notfälle in der Pflege wichtig sind</h2>

      <div class="info-grid">
        <article class="info-card">
          <h3>Schnell erkennen</h3>
          <p>
            Du lernst, Warnzeichen und lebensbedrohliche Veränderungen frühzeitig wahrzunehmen.
          </p>
        </article>

        <article class="info-card">
          <h3>Richtig handeln</h3>
          <p>
            Du übst, in akuten Situationen sofort die passenden pflegerischen Maßnahmen einzuleiten.
          </p>
        </article>

        <article class="info-card">
          <h3>Sicher weitergeben</h3>
          <p>
            Du lernst, Notfälle strukturiert zu melden, im Team zu arbeiten und wichtige Informationen klar weiterzugeben.
          </p>
        </article>
      </div>
    </section>

    <section class="category-panel">
      <h2>Was du in diesem Bereich können solltest</h2>

      <ul class="learning-list">
        <li>Notfallsituationen schnell erkennen und fachlich einschätzen.</li>
        <li>Wichtige Symptome richtig deuten und priorisieren.</li>
        <li>Sofortmaßnahmen sicher und strukturiert durchführen.</li>
        <li>Bei akuten Veränderungen ruhig und teamorientiert handeln.</li>
        <li>Notfälle korrekt weitergeben und nachvollziehbar dokumentieren.</li>
      </ul>
    </section>

    <section class="category-panel">
      <div class="topics-head">
        <div>
          <p class="category-eyebrow">Übersicht</p>
          <h2>Alle Notfall-Themen</h2>
        </div>

        <span class="topic-count-badge">{notfaelleThemen.length} Themen</span>
      </div>

      <div class="topic-grid">
        {notfaelleThemen.map((topic, index) => (
          <a class="topic-card" href={`/themen/${topic.slug}/`}>
            <div class="topic-card-top">
              <span class="topic-step">Thema {index + 1}</span>
              <span class="topic-type">{topicTypes[index] ?? "Notfall"}</span>
            </div>

            <h3>{topic.data.title}</h3>

            <p>
              {
                topic.data.beschreibung ??
                topic.data.description ??
                topicDescriptions[topic.slug] ??
                "Lerne, diesen Notfall zu erkennen und sicher darauf zu reagieren."
              }
            </p>

            <span class="topic-card-link">Thema öffnen →</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .category-page {
    display: grid;
    gap: 24px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: #64748b;
    font-size: 0.95rem;
  }

  .breadcrumb a {
    color: #2563eb;
    text-decoration: none;
  }

  .category-hero,
  .category-panel {
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    background: #ffffff;
    padding: 28px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
  }

  .category-hero {
    background: linear-gradient(135deg, #eff6ff 0%, #ffffff 58%, #f8fafc 100%);
  }

  .category-eyebrow {
    margin: 0 0 10px;
    color: #2563eb;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 4vw, 3.4rem);
    line-height: 1.05;
    color: #0f172a;
  }

  .category-intro {
    max-width: 760px;
    margin: 16px 0 0;
    color: #475569;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .category-panel h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: 1.45rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .info-card {
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: #ffffff;
    padding: 22px;
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.05);
  }

  .info-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 1.08rem;
  }

  .info-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.65;
  }

  .learning-list {
    margin: 0;
    padding-left: 20px;
    color: #475569;
    line-height: 1.8;
  }

  .topics-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .topics-head h2 {
    margin-bottom: 0;
  }

  .topic-count-badge {
    flex: 0 0 auto;
    border-radius: 999px;
    background: #dbeafe;
    color: #1d4ed8;
    padding: 8px 14px;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .topic-card {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: #ffffff;
    padding: 22px;
    text-decoration: none;
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.05);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .topic-card:hover {
    transform: translateY(-3px);
    border-color: #bfdbfe;
    box-shadow: 0 18px 38px rgba(37, 99, 235, 0.12);
  }

  .topic-card-top {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .topic-step,
  .topic-type {
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .topic-step {
    background: #eff6ff;
    color: #2563eb;
  }

  .topic-type {
    background: #f1f5f9;
    color: #475569;
  }

  .topic-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 1.12rem;
  }

  .topic-card p {
    margin: 0 0 20px;
    color: #64748b;
    line-height: 1.65;
  }

  .topic-card-link {
    margin-top: auto;
    color: #2563eb;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .info-grid,
    .topic-grid {
      grid-template-columns: 1fr;
    }

    .topics-head {
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .category-hero,
    .category-panel {
      padding: 22px;
      border-radius: 20px;
    }

    .topic-card {
      min-height: auto;
    }
  }
</style>
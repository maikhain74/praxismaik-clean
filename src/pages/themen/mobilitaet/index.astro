---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const themen = await getCollection("themen");
const mobilitaet = themen.find((entry) => entry.slug === "mobilitaet");

if (!mobilitaet) {
  throw new Error('Thema "mobilitaet" nicht gefunden.');
}

const { Content } = await render(mobilitaet);
---

<BaseLayout title="Mobilität" description={mobilitaet.data.description}>
  <article class="topic-content">
    <Content />
  </article>
</BaseLayout>

<style>
.topic-content {
  max-width: 900px;
  margin: 0 auto;
  padding: 2rem 1rem 3rem;
  line-height: 1.8;
}

.topic-content :global(img) {
  max-width: 100%;
  height: auto;
  border-radius: 16px;
  margin: 1rem 0 2rem;
  border: 1px solid #e5e7eb;
}

.topic-content :global(h1) {
  margin-top: 0;
}

.topic-content :global(h2) {
  margin-top: 2.4rem;
}

.topic-content :global(h3) {
  margin-top: 1.6rem;
}
</style>
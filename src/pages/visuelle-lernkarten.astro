      width="1400"
      height="1800"
    />
  </div>

  <div class="learning-card-content">
    <span class="card-label">
      Schmerzmanagement
    </span>

    <h2>Schmerzbeobachtung bei Demenz</h2>

    <p>
      Menschen mit Demenz äußern Schmerzen häufig
      über Verhalten, Mimik
      und Veränderungen im Alltag.
    </p>

    <ul>
      <li>Verhaltensänderungen beobachten</li>
      <li>Mimik und Körpersprache beachten</li>
      <li>Schmerzen regelmäßig einschätzen</li>
    </ul>

    <div class="exam-tip">
      Typische Prüfungsfrage:
      Warum sind Schmerzen bei Demenz schwer erkennbar?
    </div>
  </div>
</article>

  </div>

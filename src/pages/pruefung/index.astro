---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pruefungen = await getCollection("pruefung");

const sortedPruefungen = [...pruefungen].sort((a, b) => {
  const topicCompare = (a.data.topic ?? "").localeCompare(b.data.topic ?? "");
  if (topicCompare !== 0) return topicCompare;

  return (a.data.reihenfolge ?? 999) - (b.data.reihenfolge ?? 999);
});

const groupedPruefungenMap = new Map();

for (const item of sortedPruefungen) {
  const topicKey = item.data.topic?.trim() || "ohne-thema";

  if (!groupedPruefungenMap.has(topicKey)) {
    groupedPruefungenMap.set(topicKey, []);
  }

  groupedPruefungenMap.get(topicKey).push(item);
}

const groupedPruefungen = Array.from(groupedPruefungenMap.entries()).map(([topic, items]) => ({
  topic,
  items,
}));

const premiumCount = pruefungen.filter((item) => item.data.premium === true).length;
const freeCount = pruefungen.filter((item) => item.data.premium !== true).length;

const hasPremiumCookie = Astro.cookies.get("praxismaik_premium")?.value === "1";

const startablePruefungen = hasPremiumCookie
  ? sortedPruefungen
  : sortedPruefungen.filter((item) => item.data.premium !== true);

const firstStartableCase = startablePruefungen[0] ?? sortedPruefungen[0];

const startableCases = startablePruefungen.map((item, index) => ({
  slug: item.slug,
  title: item.data.title ?? "Prüfungsfall",
  order: index + 1,
}));

function formatTopicLabel(topic) {
  if (topic === "ohne-thema") return "Ohne Themenzuordnung";

  return topic
    .split("-")
    .map((teil) => teil.charAt(0).toUpperCase() + teil.slice(1))
    .join(" ");
}
---

<BaseLayout
  title="Prüfung | PraxisMaik"
  description="Prüfungsvorbereitung für die Pflegeausbildung mit strukturierten Prüfungsfällen und klarer Lernlogik."
>
  <section class="exam-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span class="breadcrumb-sep">›</span>
      <span class="current">Prüfung</span>
    </nav>

   <header class="exam-hero">
  <span class="exam-eyebrow">Prüfungsbereich</span>
  <h1>Prüfungsfälle</h1>
  <p class="exam-lead">
    Hier trainierst du prüfungsnahe Fallsituationen für die Pflegeausbildung,
    mit klarer Struktur und echter Prüfungslogik.
  </p>

     <div class="exam-hero-actions">
    <a
      href={`/pruefung/${firstStartableCase.slug}/`}
      class="btn exam-main-btn"
      id="smart-start-button"
      data-default-text="Jetzt mit dem ersten Fall starten"
      data-repeat-text="Alle Fälle abgeschlossen, ersten Fall wiederholen"
    >
      Jetzt mit dem ersten Fall starten
    </a>
    <a href="/premium/" class="btn secondary">Premium ansehen</a>
  </div>

  <div class="overview-stats">
        <div class="overview-stat">
          <strong>{pruefungen.length}</strong>
          <span>Prüfungsfälle gesamt</span>
        </div>
        <div class="overview-stat">
          <strong>{freeCount}</strong>
          <span>kostenlos</span>
        </div>
        <div class="overview-stat">
          <strong>{premiumCount}</strong>
          <span>Premium</span>
        </div>
      </div>

      <div class="cases-progress-overview" id="cases-progress-overview" hidden>
        <p class="cases-progress-label">Dein Fortschritt</p>
        <p class="cases-progress-text">
          <strong id="cases-progress-count">0</strong> von <strong>{pruefungen.length}</strong> Fällen abgeschlossen
        </p>
      </div>
       </header>

       <div
      id="smart-start-data"
      data-cases={JSON.stringify(startableCases)}
      data-default-href={`/pruefung/${firstStartableCase.slug}/`}
      hidden
    ></div>

    <section class="exam-logic">
      <div class="section-headline">
        <h2>So denkst du in der Prüfung</h2>
        <p class="section-intro">
          Gute Prüfungsantworten entstehen nicht durch Auswendiglernen, sondern durch
          klares pflegerisches Denken.
        </p>
      </div>

      <div class="exam-logic-grid">
        <div class="exam-logic-card">
          <span class="logic-step">1</span>
          <h3>Situation erfassen</h3>
          <p>Was ist das eigentliche Problem und was fällt sofort auf?</p>
        </div>

        <div class="exam-logic-card">
          <span class="logic-step">2</span>
          <h3>Probleme erkennen</h3>
          <p>Welche Risiken, Symptome oder Pflegeprobleme stehen im Vordergrund?</p>
        </div>

        <div class="exam-logic-card">
          <span class="logic-step">3</span>
          <h3>Prioritäten setzen</h3>
          <p>Was ist jetzt am wichtigsten und was folgt danach?</p>
        </div>

        <div class="exam-logic-card">
          <span class="logic-step">4</span>
          <h3>Maßnahmen begründen</h3>
          <p>Welche Handlung ist fachlich richtig und warum?</p>
        </div>
      </div>
    </section>

    {groupedPruefungen.length === 0 ? (
      <section class="exam-empty">
        <h2>Noch keine Prüfungsfälle vorhanden</h2>
        <p>Lege zuerst Inhalte in <code>src/content/pruefung</code> an.</p>
      </section>
    ) : (
      <>
        {groupedPruefungen.map((group) => (
          <section class="exam-group">
            <div class="exam-group-head">
              <div>
                <h2>{formatTopicLabel(group.topic)}</h2>
                <p>
                  {group.topic === "ohne-thema"
                    ? "Diese Prüfungsfälle haben noch kein topic im Frontmatter."
                    : "Prüfungsfälle zu diesem Themenbereich."}
                </p>
              </div>
            </div>

            <div class="exam-grid">
              {group.items.map((item, index) => {
                const isPremium = item.data.premium === true;

                return (

                <a
                    class={`exam-card ${isPremium ? "exam-card-premium" : "exam-card-free"}`}
                    href={`/pruefung/${item.slug}/`}
                    data-case-card
                    data-case-slug={item.slug}
                  >
                      <div class="exam-card-top">
                      <div class="exam-card-badges">
                        {isPremium ? (
                          <span class="card-badge card-badge-premium">🔒 Premium</span>
                        ) : (
                          <span class="card-badge card-badge-free">Kostenlos</span>
                        )}

                        <span class="card-badge card-badge-completed" data-case-completed hidden>
                          ✓ Abgeschlossen
                        </span>
                      </div>

                   <span class="exam-order">
  Fall {sortedPruefungen.findIndex((f) => f.slug === item.slug) + 1}
</span>
                    </div>

                    <h3>{item.data.title}</h3>

                    {item.data.beschreibung ? (
                      <p>{item.data.beschreibung}</p>
                    ) : (
                      <p>Kein Beschreibungstext vorhanden.</p>
                    )}

                    {isPremium ? (
                      <div class="premium-hint">
                        <strong>Die Lösung ist gesperrt</strong>
                        <span>Komplette Denkstruktur und Prüfungsantwort nur mit Premium</span>
                      </div>
                    ) : (
                      <div class="free-hint">
                        <strong>Direkt verfügbar</strong>
                        <span>Ohne Freischaltung lesbar</span>
                      </div>
                    )}

                    <span class="exam-link">
                      {isPremium ? "Vorschau öffnen" : "Prüfungsfall öffnen"}
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        ))}

        <section class="exam-premium-box">
          <div class="exam-premium-inner">
            <div>
              <span class="exam-premium-kicker">PraxisMaik Premium</span>
              <h2>Mehr Fälle, mehr Tiefe, mehr Prüfungssicherheit</h2>
              <p>
                Im freien Bereich übst du die Grundlagen. Mit Premium bekommst du
                weitere Prüfungsfälle, vollständige Lösungen und die Denklogik hinter
                den richtigen Antworten.
              </p>
            </div>

            <div class="exam-premium-actions">
              <a href="/premium-interesse" class="btn exam-main-btn">
                Premium freischalten
              </a>
              <a href="/premium/" class="btn secondary">
                Erst ansehen
              </a>
            </div>
          </div>
        </section>
      </>
    )}
  </section>

   <script>
    const STORAGE_KEY = 'praxismaik_completed_cases';

    function getCompletedCases() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    const completedCases = getCompletedCases();
    const uniqueCompletedCases = [...new Set(completedCases)];

    const progressOverview = document.getElementById('cases-progress-overview');
    const progressCount = document.getElementById('cases-progress-count');
    const caseCards = document.querySelectorAll('[data-case-card]');
    const smartStartButton = document.getElementById('smart-start-button');
    const smartStartData = document.getElementById('smart-start-data');

    if (progressOverview && progressCount) {
      progressCount.textContent = String(uniqueCompletedCases.length);
      progressOverview.hidden = false;
    }

    caseCards.forEach((card) => {
      const slug = card.getAttribute('data-case-slug') ?? '';
      const completedBadge = card.querySelector('[data-case-completed]');

      if (uniqueCompletedCases.includes(slug)) {
        card.classList.add('exam-card-completed');

        if (completedBadge) {
          completedBadge.hidden = false;
        }
      }
    });

    if (smartStartButton && smartStartData) {
      let cases = [];

      try {
        cases = JSON.parse(smartStartData.dataset.cases ?? '[]');
      } catch {
        cases = [];
      }

      const defaultHref =
        smartStartData.dataset.defaultHref ??
        smartStartButton.getAttribute('href') ??
        '/pruefung/';

      const defaultText =
        smartStartButton.dataset.defaultText ??
        'Jetzt mit dem ersten Fall starten';

      const repeatText =
        smartStartButton.dataset.repeatText ??
        'Alle Fälle abgeschlossen, ersten Fall wiederholen';

      const nextOpenCase = cases.find((item) => !uniqueCompletedCases.includes(item.slug));

      if (nextOpenCase) {
        smartStartButton.setAttribute('href', `/pruefung/${nextOpenCase.slug}/`);

        if (uniqueCompletedCases.length === 0) {
          smartStartButton.textContent = defaultText;
        } else {
          smartStartButton.textContent = `Weiter mit Fall ${nextOpenCase.order}`;
        }
      } else {
        smartStartButton.setAttribute('href', defaultHref);
        smartStartButton.textContent = repeatText;
      }
    }
  </script>
</BaseLayout>


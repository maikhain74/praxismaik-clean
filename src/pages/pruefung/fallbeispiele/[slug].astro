---
export const prerender = false;

import { getCollection } from 'astro:content';

const slug = Astro.params.slug;
const pruefungen = await getCollection('pruefung');

const exists = pruefungen.some((item) => item.slug === slug);

if (!slug || !exists) {
  return Astro.redirect('/pruefung/', 302);
}

return Astro.redirect(`/pruefung/${encodeURIComponent(slug)}/`, 302);
---

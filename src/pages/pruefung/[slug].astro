---
export const prerender = false;

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PremiumGate from '../../components/PremiumGate.astro';
import LernpfadPruefungsfall from '../../components/LernpfadPruefungsfall.astro';

const slug = Astro.params.slug;

if (!slug) {
  throw new Error('Slug fehlt.');
}

const pruefungen = await getCollection('pruefung');

const sortiertePruefungen = [...pruefungen].sort((a, b) => {
  const topicCompare = (a.data.topic ?? '').localeCompare(b.data.topic ?? '');
  if (topicCompare !== 0) return topicCompare;

  return (a.data.reihenfolge ?? 999) - (b.data.reihenfolge ?? 999);
});

const aktuellerIndex = sortiertePruefungen.findIndex((item) => item.slug === slug);
const eintrag = aktuellerIndex >= 0 ? sortiertePruefungen[aktuellerIndex] : null;

if (!eintrag) {
  return Astro.redirect('/pruefung/');
}

const vorherigerFall = aktuellerIndex > 0 ? sortiertePruefungen[aktuellerIndex - 1] : null;
const naechsterFall =
  aktuellerIndex < sortiertePruefungen.length - 1
    ? sortiertePruefungen[aktuellerIndex + 1]
    : null;

const verwandteFaelle = sortiertePruefungen
  .filter((item) => {
    return (
      item.slug !== eintrag.slug &&
      item.data.topic === eintrag.data.topic
    );
  })
  .slice(0, 3); 

const { Content } = await render(eintrag);

const isPremium = eintrag.data.premium === true;
const title = eintrag.data.title ?? 'Prüfungsfall';
const beschreibung = eintrag.data.beschreibung ?? '';
const preview = eintrag.data.preview ?? '';

const isLocalhost =
  Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';

const devUnlock =
  Astro.url.searchParams.get('freischalten') === '1' && isLocalhost;

const hasPremiumCookie =
  Astro.cookies.get('praxismaik_premium')?.value === '1' ||
  Astro.cookies.get('praxismaik_premium')?.value === 'true';

const praxisanleiterPremiumCookieValue =
  Astro.cookies.get('praxismaik_premium_praxisanleiter')?.value;

const hasPraxisanleiterPremium =
  praxisanleiterPremiumCookieValue === '1' ||
  praxisanleiterPremiumCookieValue === 'true';

const isPraxisanleiterFall =
  eintrag.data.topic === 'praxisanleitung';

const hasRequiredPremium =
  isPraxisanleiterFall
    ? hasPraxisanleiterPremium
    : hasPremiumCookie;

const showFullContent =
  !isPremium ||
  devUnlock ||
  hasRequiredPremium;

const referer = Astro.request.headers.get('referer') ?? '';
const sameOriginReferer = referer.startsWith(Astro.url.origin) ? referer : '';

const backHref = sameOriginReferer || '/pruefung';
const backLabel = sameOriginReferer.includes('/themen/')
  ? '← Zurück zum Thema'
  : '← Zurück zu den Prüfungsfällen';
---

<BaseLayout
  title={`${title} | PraxisMaik`}
  description={beschreibung}
>
    <div class="container">
      <a href={backHref} class="back-link">{backLabel}</a>

      <article class="content-card">
        <header class="content-header">
          <p class="content-badge">
            {isPremium ? 'Premium-Prüfungsfall' : 'Prüfungsfall'}
          </p>

          <h1>{title}</h1>

          {beschreibung && <p class="content-description">{beschreibung}</p>}

          {devUnlock && (
            <div class="status-box">
              Testmodus aktiv, Premium-Inhalt lokal freigeschaltet.
            </div>
          )}

          {hasPremiumCookie && !devUnlock && (
            <div class="status-box">
              Premium ist aktiv.
            </div>
          )}
        </header>

        {showFullContent ? (
  <>
    <div class="mode-switch-box">
  <button
    type="button"
    class="mode-button active"
    id="learning-mode-button"
  >
    Lernmodus
  </button>

  <button
    type="button"
    class="mode-button"
    id="exam-mode-button"
  >
    Prüfungsmodus
  </button>
</div>

<section
  class="markdown-content"
  id="markdown-content"
>
  <Content />
</section>

    <section class="case-progress-box">
      <p class="case-progress-label">Fortschritt</p>

      <div class="case-progress-actions">
        <p id="case-complete-status" class="case-progress-status">
          Noch nicht als abgeschlossen markiert
        </p>

        <button
          type="button"
          id="case-complete-button"
          class="case-complete-button"
        >
          Fall als abgeschlossen markieren
        </button>
      </div>
    </section>

<LernpfadPruefungsfall verwandteFaelle={verwandteFaelle} />
  </>
) : (
  <>
    {preview && (
      <section class="preview-box">
        <h2>Vorschau</h2>
        <p>{preview}</p>
      </section>
    )}

<PremiumGate
  title={
    isPraxisanleiterFall
      ? "Dieser Praxisanleiter-Fall gehört zu Praxisanleiter Premium"
      : "Hier entscheidet sich, ob du den Fall wirklich verstehst"
  }
  text={
    isPraxisanleiterFall
      ? "Die vollständige Fallanalyse mit Denkstruktur, Reflexion und fachlicher Einordnung ist Teil von Praxisanleiter Premium."
      : "Die Vorschau zeigt dir nur die Situation. Die entscheidende Denklogik, Prioritäten und Begründung fehlen hier. Genau das ist der Teil, der in Prüfungen bewertet wird."
  }
  buttonText={
    isPraxisanleiterFall
      ? "Praxisanleiter Premium ansehen"
      : "Jetzt sicher durch die Prüfung lernen"
  }
  buttonHref={
    isPraxisanleiterFall
      ? "/praxisanleiter-premium"
      : "/premium-interesse"
  }
/>
<p class="preview-warning">
  Wenn du nur bis hier lernst, fehlt dir genau der Teil, der in der Prüfung bewertet wird.
</p>
  </>
)}
      </article>
    </div>

    <div
      id="case-tracking-data"
      data-slug={slug}
      data-title={title}
      hidden
    ></div>

   <script type="module">
  import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';

  const supabase = createClient(
    "https://dmjbuijhoiklmgqozxkg.supabase.co",
    "sb_publishable_SQLOHit8yP0fMjfS3nN1QQ_61E3MOgn"
  );

  const trackingElement = document.getElementById('case-tracking-data');
  const completeButton = document.getElementById('case-complete-button');
  const completeStatus = document.getElementById('case-complete-status');

  const STORAGE_KEY = 'praxismaik_completed_cases';

  function getCompletedCases() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function saveCompletedCases(cases) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cases));
  }

  function updateCompleteUi(isCompleted) {
    if (!completeButton || !completeStatus) return;

    if (isCompleted) {
      completeStatus.textContent = 'Dieser Fall ist als abgeschlossen markiert';
      completeButton.textContent = 'Abgeschlossen';
      completeButton.disabled = true;
      completeButton.setAttribute('aria-disabled', 'true');
    } else {
      completeStatus.textContent = 'Noch nicht als abgeschlossen markiert';
      completeButton.textContent = 'Fall als abgeschlossen markieren';
      completeButton.disabled = false;
      completeButton.removeAttribute('aria-disabled');
    }
  }

  async function getCurrentUserId() {
    const {
      data: { user },
      error,
    } = await supabase.auth.getUser();

    if (error || !user) {
      return null;
    }

    return user.id;
  }

  async function saveCaseProgress(slug, title) {
    const userId = await getCurrentUserId();

    if (!userId) {
      console.warn('[progress] Kein eingeloggter User gefunden');
      return false;
    }

    const response = await fetch('/api/progress-save', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        userId,
        slug,
        title,
      }),
    });

    if (!response.ok) {
      const result = await response.json().catch(() => null);
      console.error('[progress] Speichern fehlgeschlagen', result);
      return false;
    }

    return true;
  }

  if (trackingElement) {
    const slug = trackingElement.dataset.slug ?? '';
    const title = trackingElement.dataset.title ?? '';

    const completedCases = getCompletedCases();
    const isAlreadyCompleted = completedCases.includes(slug);

    updateCompleteUi(isAlreadyCompleted);

    if (completeButton && !isAlreadyCompleted) {
      completeButton.addEventListener('click', async () => {
        completeButton.disabled = true;
        completeButton.textContent = 'Wird gespeichert...';

        const saved = await saveCaseProgress(slug, title);

        if (!saved) {
          completeButton.disabled = false;
          completeButton.textContent = 'Fall als abgeschlossen markieren';
          alert('Fortschritt konnte nicht gespeichert werden. Bitte prüfe, ob du eingeloggt bist.');
          return;
        }

        const currentCases = getCompletedCases();

        if (!currentCases.includes(slug)) {
          const nextCases = [...currentCases, slug];
          saveCompletedCases(nextCases);
        }

        updateCompleteUi(true);

        console.log('[case completed]', { slug, title });
      });
    }
  }

  const answerGroups = document.querySelectorAll('.fall-answers');

answerGroups.forEach((group) => {
  const cards = group.querySelectorAll('.fall-answer-card');
  const checkButton = group.querySelector('.answer-check-button');

  let selectedCard = null;

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      cards.forEach((item) => {
        item.classList.remove('selected');
      });

      selectedCard = card;
      card.classList.add('selected');
    });
  });

  checkButton?.addEventListener('click', () => {
    if (!selectedCard) {
      alert('Bitte zuerst eine Antwort auswählen.');
      return;
    }

    cards.forEach((item) => {
      item.classList.add('disabled');

      const text = item.textContent?.trim() ?? '';

      if (text.startsWith('C)')) {
        item.classList.add('correct');
      }
    });

    const selectedText = selectedCard.textContent?.trim() ?? '';

    if (selectedText.startsWith('C)')) {
      selectedCard.classList.add('correct');
    } else {
      selectedCard.classList.add('wrong');
    }

    checkButton.disabled = true;
    checkButton.textContent = 'Antwort geprüft';
  });
});
const learningModeButton = document.getElementById('learning-mode-button');
const examModeButton = document.getElementById('exam-mode-button');

const allDetails = document.querySelectorAll('details');

const examHiddenElements = Array.from(allDetails).filter((detail) => {
  const summaryText = detail.querySelector('summary')?.textContent ?? '';

  return (
    summaryText.includes('Antwort und Begründung') ||
    summaryText.includes('Lösung anzeigen')
  );
});

console.log('[exam mode elements found]', examHiddenElements.length);

function activateLearningMode() {
  learningModeButton?.classList.add('active');
  examModeButton?.classList.remove('active');

  examHiddenElements.forEach((element) => {
    element.classList.remove('exam-hidden');
  });
}

function activateExamMode() {
  examModeButton?.classList.add('active');
  learningModeButton?.classList.remove('active');

  examHiddenElements.forEach((element) => {
    element.removeAttribute('open');
    element.classList.add('exam-hidden');
  });
}

learningModeButton?.addEventListener('click', () => {
  activateLearningMode();
});

examModeButton?.addEventListener('click', () => {
  activateExamMode();
});

activateLearningMode();

</script>
 </BaseLayout>


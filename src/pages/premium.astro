              <img src="/images/ebooks/ebook-praxisanleitung-cover.webp" alt="Praxisanleitung E-Book" />
            </a>

            <a href="/ebooks/formulierungen-praxisanleitung/">
              <img src="/images/ebooks/formulierungen-praxisanleitung-cover.webp" alt="Formulierungen für Praxisanleiter E-Book" />
            </a>

            <a href="/ebooks/pruefungsfaelle-pflegepruefung/">
              <img src="/images/ebooks/pruefungsfaelle-cover.webp" alt="Prüfungsfälle E-Book" />
            </a>

            <a href="/ebooks/pflegeprozess-vorbehaltsaufgaben/">
              <img src="/images/ebooks/pflegeprozess-vorbehaltsaufgaben-cover.webp" alt="Vorbehaltsaufgaben E-Book" />

<style>
  .premium-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.2rem 1rem 3.5rem;
  }

  .breadcrumbs {
    margin-bottom: 1.2rem;
    font-size: 0.95rem;
    color: #6b7280;
  }

  .breadcrumbs a {
    color: #18324a;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .breadcrumb-sep {
    margin: 0 0.4rem;
  }

  .premium-hero {
    max-width: 780px;
    margin-bottom: 2.8rem;
  }

  .premium-urgency {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    background: #fee2e2;
    color: #991b1b;
    font-weight: 700;
  }

  .premium-active-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    background: #ecfdf5;
    color: #166534;
    border: 1px solid #bbf7d0;
    font-weight: 700;
  }

  .premium-active-box span {
    font-weight: 400;
  }

  .premium-eyebrow {
    display: inline-block;
    margin-bottom: 0.7rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: #eef5ff;
    color: #2f5f9b;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .premium-hero h1 {
    margin: 0 0 0.9rem;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.1;
  }

  .premium-lead {
    max-width: 62ch;
    margin: 0;
    color: #5b6b7a;
    line-height: 1.75;
  }

  .premium-price-inline {
    margin-top: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .premium-price-inline strong {
    font-size: 2rem;
    line-height: 1.1;
    color: #111827;
  }

  .premium-price-inline span {
    color: #6b7280;
  }

  .premium-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.4rem;
  }

  .premium-main-btn,
  .premium-buy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.2rem;
    border-radius: 12px;
    background: #111827;
    color: #ffffff !important;
    text-decoration: none;
    font-weight: 700;
  }

.premium-main-btn {
  width: 100%;
  max-width: 420px;
  font-size: 1.05rem;
  padding: 1.1rem 1.2rem;
}
  .premium-main-btn:hover,
  .premium-buy-btn:hover {
    opacity: 0.95;
    text-decoration: none;
  }

  .premium-section + .premium-section {
    margin-top: 3rem;
  }

  .section-headline {
    max-width: 760px;
    margin-bottom: 1rem;
  }

  .section-headline h2 {
    margin-bottom: 0.45rem;
  }

  .section-intro {
    margin: 0;
    color: #5b6b7a;
    line-height: 1.7;
  }

  .premium-benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }

  .premium-overview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

.premium-overview-card {
  display: block;
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 18px;
  padding: 1.2rem;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
  text-align: center;
  text-decoration: none;
  color: inherit;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

.premium-overview-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 30px rgba(24, 50, 74, 0.1);
  border-color: rgba(24, 50, 74, 0.22);
  text-decoration: none;
}

  .premium-overview-card strong {
    display: block;
    font-size: 1.4rem;
    line-height: 1.2;
    color: #18324a;
  }

  .premium-overview-card span {
    display: block;
    margin-top: 0.35rem;
    color: #5b6b7a;
    font-size: 0.95rem;
  }

.premium-overview-card em {
  display: block;
  margin-top: 0.9rem;
  font-style: normal;
  font-weight: 700;
  color: #d07a5f;
  transition: color 0.2s ease;
}

.premium-overview-card:hover em {
  color: #18324a;
}

  .premium-content-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }

  .premium-benefit-card,
  .premium-content-card,

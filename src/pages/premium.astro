<style>
  .premium-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.2rem 1rem 3.5rem;
  }

  .breadcrumbs {
    margin-bottom: 1.2rem;
    font-size: 0.95rem;
    color: #6b7280;
  }

  .breadcrumbs a {
    color: #18324a;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .breadcrumb-sep {
    margin: 0 0.4rem;
  }

  .premium-hero {
    max-width: 780px;
    margin-bottom: 2.8rem;
  }

  .premium-urgency {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    background: #fee2e2;
    color: #991b1b;
    font-weight: 700;
  }

  .premium-active-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    background: #ecfdf5;
    color: #166534;
    border: 1px solid #bbf7d0;
    font-weight: 700;
  }

  .premium-active-box span {
    font-weight: 400;
  }

  .premium-eyebrow {
    display: inline-block;
    margin-bottom: 0.7rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: #eef5ff;
    color: #2f5f9b;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .premium-hero h1 {
    margin: 0 0 0.9rem;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.1;
  }

  .premium-lead {
    max-width: 62ch;
    margin: 0;
    color: #5b6b7a;
    line-height: 1.75;
  }

.premium-hero-trust {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin: 2rem 0;
}

.premium-hero-trust-item {
  background: #ffffff;
  border: 1px solid rgba(230, 126, 34, 0.18);
  border-radius: 18px;
  padding: 1rem;
  text-align: center;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.06);
}

.premium-hero-trust-item strong {
  display: block;
  margin-bottom: 0.35rem;
  color: #e67e22;
  font-size: 1.2rem;
}

.premium-hero-trust-item span {
  display: block;
  color: #556270;
  font-size: 0.9rem;
  line-height: 1.4;
}

@media (max-width: 800px) {
  .premium-hero-trust {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 520px) {
  .premium-hero-trust {
    grid-template-columns: 1fr;
  }
}

  .premium-problem-box {
    margin-top: 1.5rem;
    padding: 1.3rem;
    border-radius: 20px;
    background: #fffaf3;
    border: 1px solid rgba(208, 122, 95, 0.24);
    box-shadow: 0 10px 24px rgba(24, 50, 74, 0.06);
  }

  .premium-problem-box h2 {
    margin-top: 0;
    margin-bottom: 0.7rem;
    color: #18324a;
    font-size: 1.35rem;
  }

  .premium-problem-box p {
    color: #556270;
    line-height: 1.7;
  }

  .premium-problem-box ul {
    margin: 1rem 0;
    padding-left: 1.25rem;
  }

  .premium-problem-box li {
    margin-bottom: 0.45rem;
    color: #18324a;
    font-weight: 700;
    line-height: 1.55;
  }

  .premium-price-inline {
    margin-top: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .premium-price-inline strong {
    font-size: 2rem;
    line-height: 1.1;
    color: #111827;
  }

  .premium-price-inline span {
    color: #6b7280;
  }

  .premium-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.4rem;
  }

  .premium-main-btn,
  .premium-buy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.2rem;
    border-radius: 12px;
    background: #111827;
    color: #ffffff !important;
    text-decoration: none;
    font-weight: 700;
  }

  .premium-main-btn {
    width: 100%;
    max-width: 420px;
    font-size: 1.05rem;
    padding: 1.1rem 1.2rem;
  }

  .premium-main-btn:hover,
  .premium-buy-btn:hover {
    opacity: 0.95;
    text-decoration: none;

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export const prerender = false;

const ebooks = await getCollection("ebooks");
const lernskripte = await getCollection("lernskripte");
const pruefung = await getCollection("pruefung");
const examQuiz = await getCollection("examQuiz");

const hasPremiumCookie =
  Astro.cookies.get("praxismaik_premium")?.value === "1" ||
  Astro.cookies.get("praxismaik_premium")?.value === "true";

/* Nur index.md zählen = echte E-Books */
const premiumEbooks = ebooks.filter(
  (entry) => entry.id.endsWith("/index.md") && entry.data.premium === true
);

const premiumLernskripte = lernskripte.filter(
  (entry) => entry.data.premium === true
);

const premiumPruefungsfaelle = pruefung.filter(
  (entry) => entry.data.premium === true
);

const premiumExamQuiz = examQuiz.filter(
  (entry) => entry.data.premium === true
);

const premiumEbookCount = premiumEbooks.length;
const premiumLernskriptCount = premiumLernskripte.length;
const premiumPruefungsfallCount = premiumPruefungsfaelle.length;
const premiumExamQuizCount = premiumExamQuiz.length;
---

<BaseLayout
  title="PraxisMaik Premium"
  description="Alle Premium-Inhalte für die Pflegeausbildung, E-Books, Examensquiz, Lernskripte und Prüfungsfälle für Ausbildung, Praxis und Examen."
>
  <section class="premium-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span class="breadcrumb-sep">›</span>
      <span class="current">Premium</span>
    </nav>

  <header class="premium-hero">
  {hasPremiumCookie ? (
    <div class="premium-active-box">
      <strong>Premium ist bereits aktiv.</strong>
      <span>Willkommen zurück. Wähle direkt den Bereich, in dem du heute weiterlernen möchtest.</span>

      <div class="premium-dashboard-split">
        <div class="premium-dashboard-group">
          <h2>Für Pflegeazubis</h2>
          <p>Sicherer lernen, Fälle verstehen und gezielt für Praxisbesuche und Abschlussprüfung trainieren.</p>

          <div class="premium-dashboard-grid">
            <a href="/lernskripte/" class="premium-dashboard-card">
              <strong>📖 Lernskripte</strong>
              <span>Über 240 Themen gezielt wiederholen →</span>
            </a>

            <a href="/pruefung/" class="premium-dashboard-card">
              <strong>🩺 Prüfungsfälle</strong>
              <span>Fallsituationen mit Lösungen trainieren →</span>
            </a>

            <a href="/quiz-exam" class="premium-dashboard-card">
              <strong>🎓 Examensquiz</strong>
              <span>Fragen im Examensmodus bearbeiten →</span>
            </a>

            <a href="/ebooks/" class="premium-dashboard-card">
              <strong>📚 Pflege-E-Books</strong>
              <span>Pflegeprozess, Prüfungsfälle und Vorbehaltsaufgaben öffnen →</span>
            </a>
          </div>
        </div>

        <div class="premium-dashboard-group">
          <h2>Für Praxisanleiter</h2>
          <p>Erstgespräche, Feedback, Beurteilungen und Anleitungssituationen professioneller gestalten.</p>

          <div class="premium-dashboard-grid">
            <a href="/ebooks/praxisanleitung/" class="premium-dashboard-card">
              <strong>📘 Praxisanleitung</strong>
              <span>Methoden, Gespräche und Struktur für den Ausbildungsalltag →</span>
            </a>

            <a href="/ebooks/formulierungen-praxisanleitung/" class="premium-dashboard-card">
              <strong>📝 Formulierungen</strong>
              <span>Vorlagen für Erstgespräch, Feedback und Beurteilungen →</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <>
      <div class="premium-urgency">
        <strong>Du siehst aktuell nur Vorschauen.</strong>
      </div>

      <span class="premium-eyebrow">PraxisMaik Premium</span>

      <h1>🎓 Bestehe deine Pflegeprüfung sicherer.</h1>

      <p class="premium-lead">
        240 Lernskripte, 45 Prüfungsfälle, 61 Examensfragen und 6 Premium-E-Books.
      </p>

      <div class="premium-included-box">
        <strong>Alles in einem Zugang:</strong>

        <ul>
          <li>240 Lernskripte</li>
          <li>45 Prüfungsfälle mit Lösungen</li>
          <li>61 Examensfragen</li>
          <li>6 Premium-E-Books</li>
          <li>Dauerhafter Zugriff</li>
          <li>Kein Abo</li>
        </ul>
      </div>

      <div class="premium-above-fold-cta">
        <a
          href="/premium-interesse"
          class="btn premium-main-btn"
          data-ga-event="premium_above_fold_cta_click"
        >
          Premium für 39 € freischalten
        </a>

        <p class="premium-above-fold-note">
          Sofortiger Zugriff. Kein Abo. Dauerhaft nutzbar.
        </p>
      </div>

      <p class="premium-loss">
        Viele Pflegeazubis lernen viel, fühlen sich in Fallsituationen und Prüfungen aber trotzdem unsicher.
      </p>

      <p class="premium-loss">
        Premium zeigt dir die Denklogik hinter Pflegeplanung, Prioritäten und Prüfungsfragen.
      </p>

      <div class="premium-price-inline">
        <strong>39 € einmalig</strong>
        <span>entspricht weniger als 1 € pro Lerntag</span>
        <span>kein Abo, keine laufenden Kosten</span>

        <p class="premium-value">
          Premium hilft dir dabei, Fallsituationen sicherer zu lösen,
          Pflegeplanungen strukturierter zu schreiben und dich gezielt
          auf die Abschlussprüfung vorzubereiten.
        </p>

        <div class="premium-price-benefits">
          <span>✓ Dauerhafter Zugriff</span>
          <span>✓ Kein Abo</span>
          <span>✓ Keine Folgekosten</span>
          <span>✓ Sofort freigeschaltet</span>
        </div>

        <div class="premium-social-proof">
          <span>🎓 Über 500.000 Videoaufrufe auf TikTok</span>
          <span>📚 Entwickelt aus echten Prüfungsfragen und Fallbeispielen</span>
        </div>

        <p class="premium-risk">
          Du kannst sofort starten und direkt prüfen, ob es dir hilft.
        </p>
      </div>
    </>
  )}
</header>

{!hasPremiumCookie && (
  <>

    <section class="premium-section premium-overview-section">
      <div class="section-headline">
   <h2>Alles freischalten, was dich sicherer macht</h2>
<p class="section-intro">
  Premium bündelt die wichtigsten Inhalte für Ausbildung, Praxis und Prüfung an einem Ort.
</p>
      </div>

{!hasPremiumCookie && (
  <div class="premium-compare">
<div class="compare-box">
  <h3>Ohne Premium</h3>
  <ul>
    <li>du siehst nur Vorschauen und Einstiegstexte</li>
    <li>viele Lernwege bleiben unvollständig</li>
    <li>Prüfungsfälle und Lösungen sind nur eingeschränkt nutzbar</li>
  </ul>
</div>

<div class="compare-box highlight">
  <h3>Mit Premium</h3>
  <ul>
    <li>du lernst Grundlagen, Themen und Zusammenhänge vollständig</li>
    <li>du trainierst Pflegefälle mit Denkstruktur und Lösung</li>
    <li>du bereitest dich Schritt für Schritt auf Ausbildung, Praxis und Prüfung vor</li>
  </ul>
</div>
  </div>
)}


    <div class="premium-overview-grid">
  <a href="/ebooks/" class="premium-overview-card">
    <strong>📚 {premiumEbookCount}</strong>
    <span>Premium-E-Books</span>
    <em>Jetzt entdecken →</em>
  </a>

  <a href="/lernskripte/" class="premium-overview-card">
    <strong>📖 {premiumLernskriptCount}</strong>
    <span>Lernskripte</span>
    <em>Alle Lernskripte ansehen →</em>
  </a>

  <a href="/pruefung/" class="premium-overview-card">
    <strong>🩺 {premiumPruefungsfallCount}</strong>
    <span>Prüfungsfälle mit Lösungen</span>
    <em>Fälle trainieren →</em>
  </a>

  <a href="/quiz-exam" class="premium-overview-card">
    <strong>🎓 {premiumExamQuizCount}</strong>
    <span>Examensfragen</span>
    <em>Examensmodus starten →</em>
  </a>
</div>

{!hasPremiumCookie && (
  <div class="premium-quick-cta">
    <p>
      🎓 Einmal freischalten, dauerhaft nutzen.
    </p>

    <a
      href="/premium-interesse"
      class="btn premium-buy-btn"
      data-ga-event="premium_quick_cta_click"
    >
      Premium für 39 € freischalten
    </a>
  </div>
)}
    
    </section>

<section class="premium-section premium-showcase-compact">
  <div class="section-headline">
    <h2>Du bekommst sofort Zugriff auf die wichtigsten Premium-Inhalte</h2>
    <p class="section-intro">
      E-Books, Lernskripte, Prüfungsfälle und Examensfragen, alles in einem Zugang.
    </p>
  </div>

 <div class="premium-ebook-cover-grid">
  <a href="/ebooks/praxisanleitung/">
    <img src="/images/ebooks/ebook-praxisanleitung-cover.webp" alt="Praxisanleitung E-Book" />
  </a>

  <a href="/ebooks/formulierungen-praxisanleitung/">
    <img src="/images/ebooks/formulierungen-praxisanleitung-cover.webp" alt="Formulierungen für Praxisanleiter E-Book" />
  </a>

  <a href="/ebooks/pruefungsfaelle-pflegepruefung/">
    <img src="/images/ebooks/pruefungsfaelle-cover.webp" alt="Prüfungsfälle E-Book" />
  </a>

  <a href="/ebooks/pflegeprozess-vorbehaltsaufgaben/">
    <img src="/images/ebooks/pflegeprozess-vorbehaltsaufgaben-cover.webp" alt="Vorbehaltsaufgaben E-Book" />
  </a>

  <a href="/ebooks/pflegeprozess/">
    <img src="/images/ebooks/pflegeprozess-pflegeplanung-pruefung-cover.webp" alt="Pflegeprozess E-Book" />
  </a>

  <a href="/ebooks/taschen-exzellenz/">
    <img src="/images/ebooks/taschen-exzellenz-cover.webp" alt="Taschen-Exzellenz E-Book" />
  </a>
</div>

  {!hasPremiumCookie && (
    <div class="premium-after-showcase-cta">
      <h3>6 E-Books, 240 Lernskripte, 45 Prüfungsfälle und 61 Examensfragen in einem Zugang.</h3>
      <p>
        Wenn du für Ausbildung, Praxis oder Examen lernst, bekommst du hier einen klaren Lernweg statt einzelner Sucherei.
      </p>
      <a href="/premium-interesse" class="btn premium-buy-btn">
        Premium für 39 € freischalten
      </a>
    </div>
  )}
</section>

<section class="premium-section premium-faq-section">
  <div class="section-headline">
    <h2>Häufige Fragen</h2>
    <p class="section-intro">
      Die wichtigsten Antworten vor der Freischaltung.
    </p>
  </div>

  <div class="premium-faq-accordion">
    <details class="premium-faq-item" open>
      <summary>Ist Premium auch geeignet, wenn ich noch am Anfang der Ausbildung bin?</summary>
      <p>
        Ja. Die Inhalte sind so aufgebaut, dass du sie vom ersten Ausbildungsjahr
        bis zur Abschlussprüfung nutzen kannst.
      </p>
    </details>

    <details class="premium-faq-item">
      <summary>Hilft Premium bei Pflegeplanung und Fallaufgaben?</summary>
      <p>
        Genau dafür wurde Premium entwickelt. Der Fokus liegt auf Pflegeprozess,
        Prioritäten, Begründungen und typischen Prüfungssituationen.
      </p>
    </details>

    <details class="premium-faq-item">
      <summary>Muss ich alles durcharbeiten?</summary>
      <p>
        Nein. Du kannst gezielt einzelne Themen, Lernskripte, E-Books oder
        Prüfungsfälle nutzen und dort einsteigen, wo du gerade Unterstützung brauchst.
      </p>
    </details>

    <details class="premium-faq-item">
      <summary>Ist Premium nur für Prüfungen gedacht?</summary>
      <p>
        Nein. Viele Inhalte helfen auch im Praxiseinsatz, bei Pflegeplanung,
        Medikamentenwissen und dem Verständnis pflegerischer Zusammenhänge.
      </p>
    </details>

    <details class="premium-faq-item">
      <summary>Warum kostet Premium nur 39 €?</summary>
     <p>
  Mein Ziel ist, Pflegeazubis einen bezahlbaren Zugang zu hochwertigen
  Lernmaterialien zu ermöglichen. Du zahlst einmal und erhältst Zugriff auf
  240 Lernskripte, 45 Prüfungsfälle, 61 Examensfragen und 6 Premium-E-Books,
  ohne Abo und ohne weitere Kosten.
</p>
    </details>

    <details class="premium-faq-item">
  <summary>Was unterscheidet PraxisMaik von kostenlosen Lernmaterialien?</summary>
  <p>
    Viele kostenlose Inhalte erklären einzelne Themen. PraxisMaik verbindet
    Lernskripte, Prüfungsfälle, Examensfragen, Pflegeplanung und E-Books zu
    einem strukturierten Lernweg. Du lernst nicht nur Wissen auswendig,
    sondern trainierst die Denklogik hinter Prüfungsfragen und Fallsituationen.
  </p>
</details>

<details class="premium-faq-item">
  <summary>Wie lange habe ich Zugriff?</summary>
  <p>
    Du zahlst einmal und behältst dauerhaft Zugriff auf alle freigeschalteten
    Premium-Inhalte. Es gibt kein Abo und keine monatlichen Kosten.
  </p>
</details>

    <details class="premium-faq-item">
      <summary>Was bekomme ich konkret?</summary>
      <p>
        6 Premium-E-Books, 240 Lernskripte, 45 Prüfungsfälle und 61 Examensfragen
        in einem dauerhaften Zugang.
      </p>
    </details>
  </div>
</section>

    <section class="premium-section premium-proof-section">
  <div class="premium-proof-box">
    <h2>Premium gibt dir einen klaren Lernweg statt planloses Wiederholen</h2>

    <p class="premium-proof-intro">
      Du lernst nicht einfach mehr Inhalte. Du lernst strukturierter, verstehst Fälle besser
      und kannst deine Antworten sicherer begründen.
    </p>

    <ul class="premium-proof-list">
      <li>du erkennst schneller, worum es in einer Fallsituation wirklich geht</li>
      <li>du begründest Prioritäten sicherer und fachlicher</li>
      <li>du schreibst Pflegeplanungen strukturierter und nachvollziehbarer</li>
      <li>du nutzt E-Books, Skripte, Fälle und Examensfragen als zusammenhängenden Lernweg</li>
    </ul>

{!hasPremiumCookie && (
  <p class="premium-pressure">
    Viele merken erst kurz vor der Prüfung, dass ihnen Struktur und klare Falllogik fehlen.
  </p>
)}

        <div class="premium-price-actions">
          {hasPremiumCookie ? (
            <a href="/pruefung/" class="btn premium-buy-btn">Zu den Prüfungsfällen</a>
          ) : (
            <a href="/premium-interesse" class="btn premium-buy-btn">Jetzt alle Premium-Inhalte freischalten</a>
          )}
        </div>

        <p class="premium-price-note">
          {hasPremiumCookie ? "Dein Zugang ist aktiv." : "Einmal zahlen, sofort freischalten."}
        </p>
      </div>
    </section>

   {!hasPremiumCookie && (
  <section class="premium-section premium-final-cta">
    <h2>Sicherer durch Ausbildung und Abschlussprüfung</h2>

    <p>
      Premium hilft dir dabei, Fallsituationen besser zu verstehen,
      Pflegeplanungen sicherer zu schreiben und in Prüfungen
      strukturierter zu denken.
    </p>

    <p class="premium-final-benefit">
      Einmal freischalten. Dauerhaft nutzen. Kein Abo.
    </p>

    <div class="premium-final-price">
      39 € einmalig
      <span>kein Abo, keine laufenden Kosten</span>
    </div>

    <a
      href="/premium-interesse"
      class="btn premium-buy-btn"
      data-ga-event="premium_final_cta_click"
    >
      Jetzt Premium freischalten
    </a>
  </section>
)}

{!hasPremiumCookie && (
  <div class="premium-mobile-sticky-cta">
    <a
      href="/premium-interesse"
      class="premium-mobile-sticky-cta__button"

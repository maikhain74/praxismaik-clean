  .premium-content-card h3,
  .premium-proof-box h2 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .premium-benefit-card p,
  .premium-content-card p {
    margin: 0;
    color: #556270;
    line-height: 1.65;
  }

  .premium-card-label {
    display: inline-flex;
    align-items: center;
    margin-bottom: 0.7rem;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #f5f7fb;
    color: #556270;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;

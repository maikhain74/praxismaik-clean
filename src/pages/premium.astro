---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ExpertBox from "../components/ExpertBox.astro";

export const prerender = false;

const ebooks = await getCollection("ebooks");
const lernskripte = await getCollection("lernskripte");
const pruefung = await getCollection("pruefung");
const examQuiz = await getCollection("examQuiz");

const hasPremiumCookie =
  Astro.cookies.get("praxismaik_premium")?.value === "1" ||
  Astro.cookies.get("praxismaik_premium")?.value === "true";

/* Nur index.md zählen = echte E-Books */
const premiumEbooks = ebooks.filter(
  (entry) => entry.id.endsWith("/index.md") && entry.data.premium === true
);

const premiumLernskripte = lernskripte.filter(
  (entry) => entry.data.premium === true
);

const premiumPruefungsfaelle = pruefung.filter(
  (entry) => entry.data.premium === true
);

const premiumExamQuiz = examQuiz.filter(
  (entry) => entry.data.premium === true
);

const premiumEbookCount = premiumEbooks.length;
const premiumLernskriptCount = premiumLernskripte.length;
const premiumPruefungsfallCount = premiumPruefungsfaelle.length;
const premiumExamQuizCount = premiumExamQuiz.length;
---

<BaseLayout
  title="PraxisMaik Premium"
  description="Alle Premium-Inhalte für die Pflegeausbildung, E-Books, Examensquiz, Lernskripte und Prüfungsfälle für Ausbildung, Praxis und Examen."
>
  <section class="premium-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span class="breadcrumb-sep">›</span>
      <span class="current">Premium</span>
    </nav>

    <header class="premium-hero">
      {hasPremiumCookie ? (
        <div class="premium-active-box">
          <strong>Premium ist bereits aktiv.</strong>
          <span>Willkommen zurück. Wähle direkt den Bereich, in dem du heute weiterlernen möchtest.</span>

          <div class="premium-dashboard-split">
            <div class="premium-dashboard-group">
              <h2>Für Pflegeazubis</h2>
              <p>Sicherer lernen, Fälle verstehen und gezielt für Praxisbesuche und Abschlussprüfung trainieren.</p>

              <div class="premium-dashboard-grid">
                <a href="/lernskripte/" class="premium-dashboard-card">
                  <strong>📖 Lernskripte</strong>
                  <span>Über 240 Themen gezielt wiederholen →</span>
                </a>

                <a href="/pruefung/" class="premium-dashboard-card">
                  <strong>🩺 Prüfungsfälle</strong>
                  <span>Fallsituationen mit Lösungen trainieren →</span>
                </a>

                <a href="/quiz-exam" class="premium-dashboard-card">
                  <strong>🎓 Examensquiz</strong>
                  <span>Fragen im Examensmodus bearbeiten →</span>
                </a>

                <a href="/ebooks/" class="premium-dashboard-card">
                  <strong>📚 Pflege-E-Books</strong>
                  <span>Pflegeprozess, Prüfungsfälle und Vorbehaltsaufgaben öffnen →</span>
                </a>
              </div>
            </div>

            <div class="premium-dashboard-group">
              <h2>Für Praxisanleiter</h2>
              <p>Erstgespräche, Feedback, Beurteilungen und Anleitungssituationen professioneller gestalten.</p>

              <div class="premium-dashboard-grid">
                <a href="/ebooks/praxisanleitung/" class="premium-dashboard-card">
                  <strong>📘 Praxisanleitung</strong>
                  <span>Methoden, Gespräche und Struktur für den Ausbildungsalltag →</span>
                </a>

                <a href="/ebooks/formulierungen-praxisanleitung/" class="premium-dashboard-card">
                  <strong>📝 Formulierungen</strong>
                  <span>Vorlagen für Erstgespräch, Feedback und Beurteilungen →</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <>
          <div class="premium-eyebrow">
            Über 330.000 Videoaufrufe • Praxisnahes Lernen für die generalistische Pflegeausbildung
          </div>

         <h1>
  Bestehe deine Praxisbesuche und deine Abschlussprüfung sicher und entwickle dich zu einer selbstbewussten Pflegefachkraft.
</h1>

<p class="premium-lead">
  Mit PraxisMaik lernst du nicht nur Antworten auswendig. Du verstehst pflegerische Zusammenhänge, kannst Entscheidungen sicher begründen und gehst ruhiger in Praxisbesuche, Fallsituationen und die Abschlussprüfung.
</p>

<div class="premium-hero-trust">
  <div class="premium-hero-trust-item">
    <strong>👨‍⚕️ 27 Jahre</strong>
    <span>Erfahrung in der Pflege</span>
  </div>

  <div class="premium-hero-trust-item">
    <strong>🩺 21 Jahre</strong>
    <span>Pflegefachkraft</span>
  </div>

  <div class="premium-hero-trust-item">
    <strong>🎓 5 Jahre</strong>
    <span>Praxisanleiter</span>
  </div>

  <div class="premium-hero-trust-item">
    <strong>▶️ 300.000+</strong>
    <span>TikTok-Aufrufe</span>
  </div>
</div>

    <div class="premium-above-fold-cta">
            <a
              href="/premium-interesse"
              class="btn premium-main-btn"
              data-ga-event="premium_above_fold_cta_click"
            >
              Jetzt Premium dauerhaft freischalten
            </a>

         <p class="premium-subtitle">
  Verstehe Pflege. Triff sichere Entscheidungen. Gehe sicher in Praxisbesuche und deine Abschlussprüfung.
</p>
        </div>

        <p class="premium-risk-free">
  ✓ 39 € einmalig, kein Abo, keine versteckten Kosten, lebenslanger Zugriff.
</p>

<div class="premium-time-saving">
  <div class="premium-time-saving-icon">⏰</div>

  <div class="premium-time-saving-content">
    <strong>Spare wertvolle Lernzeit.</strong>

    <p>
      Konzentriere dich auf genau die Inhalte, die dich in
      Praxisbesuchen und der Abschlussprüfung wirklich weiterbringen.
    </p>
  </div>
</div>

<div class="premium-expert-proof">
  <strong>⭐ Entwickelt von einem Praxisanleiter mit 27 Jahren Berufserfahrung.</strong>

  <span>
    Alle Inhalte basieren auf echten Praxisbesuchen, Abschlussprüfungen und typischen Situationen aus der generalistischen Pflegeausbildung.
  </span>
</div>

      <div class="premium-included-box">
  <strong>So verändert Premium deinen Pflegealltag:</strong>

  <ul>
    <li>✅ Pflegeplanungen sicher und logisch erstellen.</li>
    <li>✅ Pflegediagnosen fachlich korrekt formulieren.</li>
    <li>✅ Pflegerische Entscheidungen sicher begründen.</li>
    <li>✅ Praxisbesuche und Abschlussprüfungen ruhiger meistern.</li>
    <li>✅ Zusammenhänge verstehen, statt Antworten auswendig zu lernen.</li>
    <li>✅ Sofort auf alle Premium-Inhalte zugreifen, dauerhaft und ohne Abo.</li>
  </ul>
</div>

          <section class="premium-problem-box">
            <h2>Kommt dir das bekannt vor?</h2>

            <p>
              Du lernst stundenlang und kennst die Theorie. Doch sobald eine Fallsituation kommt, fragst du dich:
            </p>

            <ul>
              <li>Was hat jetzt Priorität?</li>
              <li>Wie begründe ich meine Entscheidung fachlich?</li>
              <li>Was erwartet die Lehrkraft wirklich?</li>
              <li>Wie schreibe ich eine gute Pflegeplanung?</li>
            </ul>

            <p>
              Genau hier setzt PraxisMaik an. Du lernst nicht mehr nur Inhalte, sondern die Denkweise hinter pflegerischen Entscheidungen.
            </p>
          </section>
        </>
      )}
    </header>

    {!hasPremiumCookie && (
      <>
        <ExpertBox
  title="Ich bin Maik Hain."
  showStarterGuideButton={false}
/>

        <section class="premium-section premium-transformation">
  <h2>Stell dir vor, du gehst in deinen nächsten Praxisbesuch und …</h2>

  <p class="premium-transformation-intro">
    Du bist nicht mehr unsicher, sondern weißt genau, wie du fachlich richtig denkst und handelst.
  </p>

  <div class="premium-transformation-grid">
    <div class="premium-transformation-item">
      ✅ Du erkennst sofort, was in einer Fallsituation Priorität hat.
    </div>

    <div class="premium-transformation-item">
      ✅ Du begründest deine Entscheidungen sicher und fachlich korrekt.
    </div>

    <div class="premium-transformation-item">
      ✅ Du schreibst Pflegeplanungen ohne langes Überlegen.
    </div>

    <div class="premium-transformation-item">
      ✅ Du beantwortest die Fragen deiner Lehrkraft souverän.
    </div>

    <div class="premium-transformation-item">
      ✅ Du gehst deutlich sicherer in Praxisbesuche und deine Abschlussprüfung.
    </div>

    <div class="premium-transformation-item">
      ✅ Du verstehst pflegerische Zusammenhänge, statt Antworten auswendig zu lernen.
    </div>
  </div>

  <p class="premium-transformation-note">
  Genau auf dieses Ziel sind alle Lernskripte, Prüfungsfälle, Examensfragen und Premium-E-Books aufgebaut.
</p>
</section>

<section class="premium-section premium-overview-section">
  <div class="section-headline">
    <h2>Alles, was du für erfolgreiche Praxisbesuche und deine Abschlussprüfung brauchst.</h2>

    <p class="section-intro">
      Du musst nicht mehr zwischen Büchern, Internetseiten, Mitschriften und verschiedenen Unterlagen wechseln.
      Mit PraxisMaik findest du alle wichtigen Inhalte an einem Ort, verständlich erklärt und speziell für die generalistische Pflegeausbildung aufgebaut.
    </p>
  </div>

  <div class="premium-compare">
  <div class="compare-box">
    <h3>Viele Pflegeazubis kennen das</h3>

    <ul>
      <li>Du suchst Informationen auf verschiedenen Webseiten und in mehreren Unterlagen.</li>
      <li>Du bist unsicher, welche Inhalte wirklich wichtig und fachlich richtig sind.</li>
      <li>Du verlierst viel Zeit, ohne einen klaren Lernweg für Praxisbesuche und Abschlussprüfung zu haben.</li>
    </ul>
  </div>

  <div class="compare-box highlight">

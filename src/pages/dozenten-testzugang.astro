---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";

const error = Astro.url.searchParams.get("error");
---

<BaseLayout
  title="Dozenten-Testzugang | PraxisMaik"
  description="Kostenloser Testzugang für Lehrkräfte und Pflegepädagogen zur fachlichen Einschätzung von PraxisMaik Premium."
>
  <section class="teacher-access-page">
    <div class="teacher-access-box">
      <span class="teacher-label">PraxisMaik für Lehrkräfte</span>

      <h1>Dozenten-Testzugang</h1>

      <p>
        Dieser Zugang ist für Pflegepädagoginnen, Pflegepädagogen und Lehrkräfte gedacht,
        die PraxisMaik fachlich und didaktisch prüfen möchten.
      </p>

      <p>
        Der Testzugang ermöglicht Einblick in Premium-Inhalte wie Lernskripte,
        E-Books, Prüfungsfälle und das Examensquiz.
      </p>

      {error && (
        <div class="error-box">
          Der Zugangscode ist ungültig.
        </div>
      )}

      <form method="get" action="/api/dozenten-zugang" class="access-form">
        <label>
          Zugangscode
          <input
            type="password"
            name="code"
            placeholder="Zugangscode eingeben"
            required
          />
        </label>

        <button type="submit">
          Testzugang freischalten
        </button>
      </form>

      <p class="note">
        Der Zugang ist nur für Feedbackzwecke gedacht und ersetzt keinen regulären Premiumzugang.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
.teacher-access-page {
  max-width: 760px;
  margin: 0 auto;
  padding: 3rem 1rem 4rem;
}

.teacher-access-box {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 22px;
  padding: 2rem;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.06);
}

.teacher-label {
  display: inline-block;
  margin-bottom: 0.8rem;
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  background: #eef5ff;
  color: #2f5f9b;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
}

.teacher-access-box h1 {
  margin: 0 0 1rem;
  font-size: clamp(2rem, 3vw, 2.7rem);
}

.teacher-access-box p {
  color: #556270;
  line-height: 1.7;
}

.access-form {
  display: grid;
  gap: 1rem;
  margin-top: 1.5rem;
}

.access-form label {
  display: grid;
  gap: 0.45rem;
  font-weight: 700;
  color: #18324a;
}

.access-form input {
  width: 100%;
  border: 1px solid #d1d5db;
  border-radius: 14px;
  padding: 0.9rem 1rem;
  font: inherit;
}

.access-form button {
  border: 0;
  border-radius: 14px;
  padding: 1rem 1.2rem;
  background: #18324a;
  color: #ffffff;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.error-box {
  margin-top: 1rem;
  padding: 0.9rem 1rem;
  border-radius: 12px;
  background: #fee2e2;
  color: #991b1b;
  font-weight: 700;
}

.note {
  margin-top: 1.2rem;
  font-size: 0.95rem;
  color: #6b7280;
}
</style>
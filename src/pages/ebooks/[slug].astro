---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import PremiumGate from "../../components/PremiumGate.astro";
import { createSupabaseServerClient } from "../../lib/supabase-server";

const slug = Astro.params.slug;

const ebookCovers: Record<string, string> = {
  "pruefungsfaelle-pflegepruefung": "/images/ebooks/pruefungsfaelle-cover.webp",
  "pflegeprozess-vorbehaltsaufgaben": "/images/ebooks/pflegeprozess-vorbehaltsaufgaben-cover.webp",
  "pflegeprozess": "/images/ebooks/pflegeprozess-pflegeplanung-pruefung-cover.webp",
  "taschen-exzellenz": "/images/ebooks/taschen-exzellenz-cover.webp",
  "praxisanleitung": "/images/ebooks/ebook-praxisanleitung-cover.webp",
  "formulierungen-praxisanleitung": "/images/ebooks/formulierungen-praxisanleitung-cover.webp",
};

if (!slug) {
  throw new Error("E-Book nicht gefunden: Kein Slug vorhanden.");
}

const allEbookEntries = await getCollection("ebooks");

const mainEntry = allEbookEntries.find(
  (entry) => entry.id === `${slug}/index.md`
);

if (!mainEntry) {
  throw new Error(`E-Book nicht gefunden: ${slug}`);
}

const isPremium = mainEntry.data.premium === true;

/*
 * Diese beiden E-Books gehören ausschließlich
 * zu Praxisanleiter Premium.
 */
const praxisanleiterEbookSlugs = [
  "praxisanleitung",
  "formulierungen-praxisanleitung",
];

const isPraxisanleiterEbook =
  praxisanleiterEbookSlugs.includes(slug);

const supabase =
  createSupabaseServerClient(Astro.cookies);

const {
  data: { user },
  error: userError,
} = await supabase.auth.getUser();

let hasAzubiPremium = false;
let hasPraxisanleiterPremium = false;

if (!userError && user) {
  const {
    data: profile,
    error: profileError,
  } = await supabase
    .from("profiles")
    .select(
      "premium, premium_azubi, premium_praxisanleiter"
    )
    .eq("id", user.id)
    .single();

  if (!profileError && profile) {
    hasAzubiPremium =
      profile.premium === true ||
      profile.premium_azubi === true;

    hasPraxisanleiterPremium =
      profile.premium_praxisanleiter === true;
  }
}

const isLocalhost =
  Astro.url.hostname === "localhost" ||
  Astro.url.hostname === "127.0.0.1";

const devUnlock =
  Astro.url.searchParams.get("freischalten") === "1" &&
  isLocalhost;

/*
 * Zugriffslogik:
 *
 * Praxisanleiter-E-Books:
 * nur Praxisanleiter Premium
 *
 * Andere Premium-E-Books:
 * nur Azubi Premium
 *
 * Nicht-Premium:
 * frei zugänglich
 *
 * Lokal:
 * ?freischalten=1 bleibt als Testmöglichkeit bestehen
 */
const hasRequiredPremium =
  isPraxisanleiterEbook
    ? hasPraxisanleiterPremium
    : hasAzubiPremium;

const showFullContent =
  !isPremium ||
  hasRequiredPremium ||
  devUnlock;

/*
 * Gesperrte Praxisanleiter-E-Books führen zum
 * 79-Euro-Praxisanleiter-Produkt.
 *
 * Andere Premium-E-Books führen weiterhin
 * zum Azubi-Premium.
 */
const premiumPageHref =
  isPraxisanleiterEbook
    ? "/praxisanleiter-premium/"
    : "/premium";

const premiumGateTitle =
  isPraxisanleiterEbook
    ? "Du siehst nur die Einleitung"
    : "Du siehst nur die Einleitung";

const premiumGateText =
  isPraxisanleiterEbook
    ? "Die vollständigen Kapitel dieses E-Books sind in Praxisanleiter Premium verfügbar."
    : "Die vollständigen Kapitel mit allen Inhalten sind nur im Premium-Bereich verfügbar.";

const chapterEntries = allEbookEntries
  .filter((entry) => {
    return (
      entry.id.startsWith(`${slug}/`) &&
      !entry.id.endsWith("/index.md")
    );
  })
  .sort((a, b) => {
    const orderA =
      typeof a.data.reihenfolge === "number"
        ? a.data.reihenfolge
        : 999;

    const orderB =
      typeof b.data.reihenfolge === "number"
        ? b.data.reihenfolge
        : 999;

    if (orderA !== orderB) return orderA - orderB;

    return a.id.localeCompare(b.id, "de");
  });

const { Content: IntroContent } = await mainEntry.render();

const renderedChapters = await Promise.all(
  chapterEntries.map(async (chapter) => {
    const { Content } = await chapter.render();

    return {
      id: chapter.id,
      data: chapter.data,
      Content,
    };
  })
);
---

<BaseLayout
  title={mainEntry.data.title}
  description={mainEntry.data.beschreibung}
>
  <article class="ebook">
    <header class="ebook-header">
      <p class="ebook-kicker">
        {isPremium ? "Premium E-Book" : "E-Book"}
      </p>

      <h1>{mainEntry.data.title}</h1>

      {ebookCovers[slug] && (
        <img
          src={ebookCovers[slug]}
          alt={mainEntry.data.title}
          class="ebook-cover"
        />
      )}

      {mainEntry.data.beschreibung && (
        <p class="ebook-description">
          {mainEntry.data.beschreibung}
        </p>
      )}

      {mainEntry.data.tags?.length > 0 && (
        <ul class="ebook-tags">
          {mainEntry.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}

      {devUnlock && (
        <div class="dev-box">
          Testmodus aktiv, Premium-Inhalt lokal freigeschaltet.
        </div>
      )}
    </header>

    <section class="ebook-product-box">
      <div class="ebook-stats-grid">
        <div>
          <strong>{renderedChapters.length}</strong>
          <span>Kapitel</span>
        </div>

        <div>
          <strong>Premium</strong>
          <span>Zugriff</span>
        </div>

        <div>
          <strong>Praxisnah</strong>
          <span>Direkt nutzbar</span>
        </div>
      </div>

     <div class="ebook-benefit-box">
  <h2>Was dich in diesem E-Book erwartet</h2>

  {slug === "praxisanleitung" ? (
    <ul>
      <li>Rolle und Aufgaben von Praxisanleitenden sicher einordnen</li>
      <li>pädagogische und didaktische Grundlagen verständlich anwenden</li>
      <li>Anleitungen strukturiert planen und passende Methoden auswählen</li>
      <li>Kompetenzen von Auszubildenden gezielt fördern und einschätzen</li>
      <li>Feedback, Beurteilungen und schwierige Anleitungssituationen professionell gestalten</li>
    </ul>
  ) : slug === "formulierungen-praxisanleitung" ? (
    <ul>
      <li>konkrete Formulierungen für Praxisanleiter</li>
      <li>Beispiele für Erstgespräche, Zwischengespräche und Abschlussgespräche</li>
      <li>Textbausteine für Beurteilungsbögen</li>
      <li>Formulierungen nach Kompetenzbereichen und Einsatzbereichen</li>
      <li>komplette Musterbeurteilungen zum Anpassen</li>
    </ul>
  ) : (
    <ul>
      <li>praxisnah aufbereitete Inhalte zum direkten Nachlesen</li>
      <li>strukturierte Kapitel für gezieltes Lernen</li>
      <li>verständliche Erklärungen wichtiger Zusammenhänge</li>
      <li>konkrete Beispiele für Pflegepraxis und Prüfung</li>
      <li>dauerhafter Zugriff im jeweiligen Premium-Bereich</li>
    </ul>
  )}
</div>

      {!showFullContent && (
        <div class="ebook-locked-note">
          <strong>
            {isPraxisanleiterEbook
              ? "Praxisanleiter Premium"
              : "Premium-Inhalt"}
          </strong>

          <p>
            {isPraxisanleiterEbook
              ? "Du siehst aktuell nur die Einleitung. Die vollständigen Kapitel dieses E-Books sind in Praxisanleiter Premium freigeschaltet."
              : "Du siehst aktuell nur die Einleitung. Die vollständigen Kapitel sind im Premiumbereich freigeschaltet."}
          </p>

          <a
            href={premiumPageHref}
            class="ebook-premium-link"
          >
            {isPraxisanleiterEbook
              ? "Praxisanleiter Premium ansehen"
              : "Premium freischalten"}
          </a>
        </div>
      )}
    </section>

    <section class="ebook-intro">
      <IntroContent />
    </section>

    {showFullContent ? (
      <section
        class="ebook-accordion"
        aria-label="E-Book Kapitel"
      >
        <div class="ebook-accordion-header">
          <p class="ebook-section-kicker">
            Inhaltsverzeichnis
          </p>

          <h2>Kapitel öffnen und direkt lesen</h2>

          <p>
            Klicke auf ein Kapitel, um den Inhalt direkt auf dieser
            Seite zu öffnen.
          </p>
        </div>

        <div class="ebook-chapter-grid">
          {renderedChapters.map((chapter, index) => (
            <details
              class="ebook-chapter-card"
              id={`kapitel-${index + 1}`}
            >
              <summary>
                <span class="chapter-number">
                  Kapitel {index + 1}
                </span>

                <span class="chapter-title">
                  {chapter.data.title ??
                    `Kapitel ${index + 1}`}
                </span>

                <span class="chapter-toggle">
                  öffnen
                </span>
              </summary>

              <div class="ebook-chapter-content">
                <chapter.Content />
              </div>
            </details>
          ))}
        </div>
      </section>
    ) : (
      <>
        <nav
          class="ebook-toc"
          aria-label="Inhaltsverzeichnis"
        >
          <h2>Inhaltsverzeichnis</h2>

          <ol>
            {renderedChapters.map((chapter, index) => (
              <li>
                <span class="locked-chapter-title">
                  {chapter.data.title ??
                    `Kapitel ${index + 1}`}
                </span>
              </li>
            ))}
          </ol>
        </nav>

        <PremiumGate
          title={premiumGateTitle}
          text={premiumGateText}
          buttonText={
            isPraxisanleiterEbook
              ? "Praxisanleiter Premium ansehen"
              : "Jetzt freischalten"
          }
          buttonHref={premiumPageHref}
        />
      </>
    )}
  </article>
</BaseLayout>

<style>
  .ebook {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .ebook-header {
    margin-bottom: 2rem;
  }

  .ebook-kicker,
  .ebook-section-kicker {
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #c46a2b;
    margin-bottom: 0.5rem;
  }

  .ebook-description {
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 70ch;
  }

  .ebook-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .ebook-tags li {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: #f3f4f6;
    font-size: 0.9rem;
  }

  .dev-box {
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid #d1fae5;
    background: #ecfdf5;
    color: #065f46;
    border-radius: 12px;
    font-weight: 700;
  }

  .ebook-intro {
    margin: 2rem 0 3rem;
  }

  .ebook-product-box {
    margin: 2rem 0 2.5rem;
    display: grid;
    gap: 1.2rem;
  }

  .ebook-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .ebook-stats-grid div {
    padding: 1rem;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
    text-align: center;
  }

  .ebook-stats-grid strong {
    display: block;
    font-size: 1.2rem;
    color: #18324a;
  }

  .ebook-stats-grid span {
    display: block;
    margin-top: 0.25rem;
    color: #6b7280;
    font-size: 0.95rem;
  }

  .ebook-benefit-box,
  .ebook-locked-note {
    padding: 1.3rem;
    border-radius: 18px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
  }

  .ebook-benefit-box h2 {
    margin-top: 0;
  }

  .ebook-benefit-box ul {
    margin-bottom: 0;
    padding-left: 1.2rem;
  }

  .ebook-benefit-box li {
    margin-bottom: 0.45rem;
    line-height: 1.6;
  }

  .ebook-locked-note {
    background: #fff7ed;
    border-color: #fed7aa;
  }

  .ebook-locked-note p {
    margin: 0.5rem 0 1rem;
    color: #7c2d12;
    line-height: 1.6;
  }

  .ebook-premium-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    background: #18324a;
    color: #ffffff !important;
    text-decoration: none !important;
    font-weight: 700;
  }

  .ebook-cover {
    width: 100%;
    max-width: 680px;
    display: block;
    margin: 0 auto 2rem;
    border-radius: 24px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
  }

  .ebook-toc {
    margin: 0 0 3rem;
    padding: 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fafafa;
  }

  .ebook-toc ol {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
  }

  .ebook-toc li + li {
    margin-top: 0.5rem;
  }

  .locked-chapter-title {
    color: #18324a;
    opacity: 0.85;
  }

  .ebook-accordion {
    margin-top: 2rem;
  }

  .ebook-accordion-header {
    margin-bottom: 1.5rem;
    padding: 1.5rem;
    border-radius: 20px;
    background: #fff7ed;
    border: 1px solid #fed7aa;
  }

  .ebook-accordion-header h2 {
    margin: 0 0 0.6rem;
    color: #18324a;
  }

  .ebook-accordion-header p {
    margin-bottom: 0;
    line-height: 1.6;
  }

  .ebook-chapter-grid {
    display: grid;
    gap: 1rem;
  }

  .ebook-chapter-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
    overflow: hidden;
    scroll-margin-top: 100px;
  }

  .ebook-chapter-card summary {
    cursor: pointer;
    list-style: none;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.2rem;
  }

  .ebook-chapter-card summary::-webkit-details-marker {
    display: none;
  }

  .chapter-number {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #fff7ed;
    color: #c46a2b;
    font-size: 0.85rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .chapter-title {
    color: #18324a;
    font-weight: 800;
    line-height: 1.35;
  }

  .chapter-toggle {
    color: #6b7280;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .ebook-chapter-card[open] .chapter-toggle {
    color: #c46a2b;
  }

  .ebook-chapter-card[open] summary {
    border-bottom: 1px solid #f3f4f6;
    background: #fffaf5;
  }

  .ebook-chapter-card[open] .chapter-toggle {
    font-size: 0;
  }

  .ebook-chapter-card[open] .chapter-toggle::after {
    content: "schließen";
    font-size: 0.9rem;
  }

  .ebook-chapter-content {
    padding: 1.4rem;
    line-height: 1.7;
  }

  .ebook-chapter-content :global(h1),
  .ebook-chapter-content :global(h2),
  .ebook-chapter-content :global(h3) {
    color: #18324a;
  }

  .ebook-chapter-content :global(h1) {
    margin-top: 0;
  }

  .ebook-chapter-content :global(blockquote) {
    margin: 1rem 0;
    padding: 1rem;
    border-left: 4px solid #c46a2b;
    background: #fff7ed;
    border-radius: 12px;
  }

  @media (max-width: 700px) {
    .ebook-stats-grid {
      grid-template-columns: 1fr;
    }

    .ebook-chapter-card summary {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .chapter-number,
    .chapter-toggle {
      width: fit-content;
    }
  }
</style>
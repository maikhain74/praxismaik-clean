---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="PraxisMaik Shop | Lernmaterialien für die Pflegeausbildung"
  description="Entdecke praxisnahe Masterkits, Lernmaterialien und Prüfungshilfen für die generalistische Pflegeausbildung im PraxisMaik Shop."
>
  <div class="pm-shop">
    <nav class="pm-shop-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Startseite</a>
      <span aria-hidden="true">›</span>
      <span>Shop</span>
    </nav>

    <header class="pm-shop-hero">
      <span class="pm-shop-eyebrow">PRAXISMAIK LERNSHOP</span>
      <h1>Lernen mit Struktur. Sicherer in die Pflegeprüfung.</h1>
      <p class="pm-shop-lead">
        Praxisnahe Lernmaterialien für deine Pflegeausbildung.
        Verständlich erklärt, übersichtlich aufgebaut und
        mit konkretem Bezug zum Pflegealltag.
      </p>
      <div class="pm-shop-highlights">
        <span>✓ Für Pflege-Azubis</span>
        <span>✓ Praxisnah aufbereitet</span>
        <span>✓ Digitale Lernmaterialien</span>
      </div>
    </header>

    <section class="pm-shop-products" aria-labelledby="products-title">
      <div class="pm-shop-section-head">
        <div>
          <span class="pm-shop-section-label">UNSERE LERNPRODUKTE</span>
          <h2 id="products-title">Masterkits und Lernhilfen</h2>
        </div>
        <p>Gezielt lernen, Wissen festigen und sicherer in die Pflegeprüfung gehen.</p>
      </div>

      <div class="pm-shop-grid">
        <article class="pm-shop-card">
          <div class="pm-shop-cover">
            <img
              src="/images/medikamentenlehre-masterkit-shop.png"
              alt="Medikamentenlehre Masterkit von PraxisMaik, digitales Lernmaterial für die generalistische Pflegeausbildung"
              loading="lazy"
              style="display:block;width:100%;height:auto;object-fit:contain;border-radius:12px;"
            />
          </div>

          <div class="pm-shop-card-body">
            <span class="pm-shop-tag">Digitales Lernskript</span>
            <h3>Medikamentenlehre Masterkit</h3>
            <p>
              Arzneimittelgruppen, sichere Medikamentengabe,
              Dosierungsberechnung und praxisnahe Prüfungsfälle
              verständlich und strukturiert erklärt.
            </p>

            <div class="pm-shop-facts">
              <span>19 Kapitel</span>
              <span>89 Seiten</span>
              <span>PDF</span>
            </div>

            <div class="pm-shop-card-bottom">
              <p style="margin:0 0 12px;font-size:1.5rem;font-weight:800;color:#342b24;">
                19,90 €
              </p>
              <a
                href="/shop/medikamentenlehre-masterkit/"
                class="pm-shop-status"
                style="background:#e67e22;color:#fff;text-decoration:none;"
              >
                Produkt ansehen
              </a>
            </div>
          </div>
        </article>

        <article class="pm-shop-card">
          <div class="pm-shop-cover">
            <img
              src="/images/fachgespraech-masterkit-shop.png"
              alt="Fachgespräch-Masterkit Generalistik von PraxisMaik, Vorbereitung auf das mündliche Pflegeexamen"
              loading="lazy"
              style="display:block;width:100%;height:auto;object-fit:contain;border-radius:12px;"
            />
          </div>

          <div class="pm-shop-card-body">
            <span class="pm-shop-tag">Digitale Prüfungsvorbereitung</span>
            <h3>Fachgespräch-Masterkit Generalistik</h3>
            <p>
              Bereite dich gezielt auf das mündliche Pflegeexamen vor.
              Mit 27 praxisnahen Prüfungsfragen und strukturierten
              Lernhilfen für dein Fachgespräch.
            </p>

            <div class="pm-shop-facts">
              <span>27 Prüfungsfragen</span>
              <span>36 Seiten</span>
              <span>PDF</span>
            </div>

            <div class="pm-shop-card-bottom">
              <p style="margin:0 0 12px;font-size:1.5rem;font-weight:800;color:#342b24;">
                9,90 €
              </p>
              <a
                href="/shop/fachgespraech-masterkit/"
                class="pm-shop-status"
                style="background:#e67e22;color:#fff;text-decoration:none;"
              >
                Produkt ansehen
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="pm-shop-info" aria-labelledby="info-title">
      <div class="pm-shop-info-icon" aria-hidden="true">♡</div>
      <div>
        <h2 id="info-title">Lernen mit PraxisMaik</h2>
        <p>
          Hinter den Lernmaterialien stehen langjährige Pflegepraxis
          und Erfahrung in der Praxisanleitung. Ziel ist es,
          komplexe Inhalte verständlich und für die Ausbildung
          praktisch nutzbar aufzubereiten.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .pm-shop {
    --shop-orange: #e67e22;
    --shop-orange-dark: #b9570d;
    --shop-cream: #fff5e9;
    --shop-border: #ead9c7;
    --shop-text: #342b24;
    --shop-muted: #665d55;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 18px 55px;
    color: var(--shop-text);
  }

  .pm-shop-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    font-size: 0.9rem;
    color: var(--shop-muted);
  }

  .pm-shop-breadcrumb a,
  .pm-shop-breadcrumb a:visited {
    color: var(--shop-muted);
    text-decoration: none;
  }

  .pm-shop-hero {
    padding: clamp(28px, 5vw, 58px);
    border: 1px solid var(--shop-border);
    border-radius: 24px;
    background: linear-gradient(125deg, #fffaf4 0%, #f8e6d1 100%);
  }

  .pm-shop-eyebrow,
  .pm-shop-section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    color: var(--shop-orange-dark);
  }

  .pm-shop-hero h1 {
    max-width: 760px;
    margin: 14px 0 18px;
    font-size: clamp(2rem, 4.3vw, 3.2rem);
    line-height: 1.15;
    color: var(--shop-text);
  }

  .pm-shop-lead {
    max-width: 700px;
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--shop-muted);
  }

  .pm-shop-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .pm-shop-highlights span {
    padding: 9px 13px;
    border: 1px solid #efd6bd;
    border-radius: 999px;
    background: #fff;
    color: #6b4626;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .pm-shop-products {
    margin-top: 48px;
  }

  .pm-shop-section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 24px;
  }

  .pm-shop-section-head h2 {
    margin: 8px 0 0;
    padding: 0;
    border: 0;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    color: var(--shop-text);
  }

  .pm-shop-section-head p {
    margin: 0;
    color: var(--shop-muted);
    font-size: 0.92rem;
  }

  .pm-shop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: 22px;
  }

  .pm-shop-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 360px;
    overflow: hidden;
    border: 1px solid var(--shop-border);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 10px 30px rgba(90, 60, 30, 0.06);
  }

  .pm-shop-cover {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
    padding: 25px;
    background: linear-gradient(135deg, #f9e5cf, #fff8ef);
  }

  .pm-shop-cover-inner {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 230px;
    min-height: 280px;
    padding: 24px 20px;
    border: 1px solid #e7c7a4;
    border-radius: 8px;
    background: #fffaf3;
    box-shadow: 8px 12px 20px rgba(83, 53, 23, 0.12);
    color: var(--shop-text);
  }

  .pm-shop-cover-brand {
    font-weight: 800;
    color: var(--shop-orange-dark);
  }

  .pm-shop-cover-category {
    margin-top: 12px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--shop-orange-dark);
  }

  .pm-shop-cover-inner strong {
    font-size: 1.45rem;
    line-height: 1.2;
  }

  .pm-shop-cover-inner > span:nth-of-type(3) {
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .pm-shop-cover-line {
    width: 60px;
    height: 4px;
    margin-top: auto;
    border-radius: 4px;
    background: var(--shop-orange);
  }

  .pm-shop-cover-inner small {
    font-size: 0.72rem;
    color: var(--shop-muted);
  }

  .pm-shop-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 24px;
  }

  .pm-shop-tag {
    align-self: flex-start;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--shop-cream);
    color: var(--shop-orange-dark);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .pm-shop-card h3 {
    margin: 16px 0 10px;
    font-size: 1.3rem;
    line-height: 1.3;
    color: var(--shop-text);
  }

  .pm-shop-card p {
    color: var(--shop-muted);
    line-height: 1.7;
  }

  .pm-shop-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .pm-shop-facts span {
    padding: 7px 10px;
    border: 1px solid #e9dfd4;
    border-radius: 9px;
    background: #faf8f5;
    font-size: 0.8rem;
    font-weight: 700;
    color: #5d5044;
  }

  .pm-shop-card-bottom {
    margin-top: auto;
    padding-top: 22px;
  }

  .pm-shop-status {
    display: block;
    padding: 13px;
    border-radius: 11px;
    background: #f7f3ee;
    color: #6a5a4c;
    text-align: center;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .pm-shop-info {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin-top: 46px;
    padding: 26px;
    border: 1px solid var(--shop-border);
    border-radius: 20px;
    background: #fffaf5;
  }

  .pm-shop-info-icon {
    flex-shrink: 0;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--shop-orange);
  }

  .pm-shop-info h2 {
    margin: 0 0 10px;
    padding: 0;
    border: 0;
    font-size: 1.3rem;
    color: var(--shop-text);
  }

  .pm-shop-info p {
    margin: 0;
    color: var(--shop-muted);
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .pm-shop {
      padding: 0 12px 36px;
    }

    .pm-shop-hero {
      padding: 26px 20px;
    }

    .pm-shop-section-head {
      display: block;
    }

    .pm-shop-section-head p {
      margin-top: 12px;
    }

    .pm-shop-info {
      padding: 20px;
    }
  }
</style>

---
export const prerender = false;

import Stripe from "stripe";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const sessionId = Astro.url.searchParams.get("session_id");

let paymentVerified = false;
let errorMessage = "";
let purchaseValue = 0;
let purchaseCurrency = "EUR";

if (!sessionId) {
  errorMessage = "Es wurde keine Zahlungsbestätigung übermittelt.";
} else {
  try {
    const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY);

    const session = await stripe.checkout.sessions.retrieve(sessionId, {
      expand: ["line_items"],
    });

    const priceId = session.line_items?.data[0]?.price?.id;

    paymentVerified =
      session.livemode === true &&
      session.mode === "payment" &&
      session.status === "complete" &&
      session.payment_status === "paid" &&
      priceId === import.meta.env.STRIPE_PRICE_ID_FACHGESPRAECH &&
      session.line_items?.data.length === 1 &&
      session.line_items?.data[0]?.quantity === 1 &&
      session.amount_total !== null &&
      session.currency !== null;

    if (paymentVerified) {
      purchaseValue = session.amount_total! / 100;
      purchaseCurrency = session.currency!.toUpperCase();
    } else {
      errorMessage =
        "Die Zahlung konnte noch nicht eindeutig bestätigt werden.";
    }
  } catch (error) {
    console.error("Fachgespräch-Zahlungsprüfung fehlgeschlagen:", error);
    errorMessage =
      "Die Zahlungsbestätigung ist momentan nicht verfügbar.";
  }
}
---

<BaseLayout
  title="Bestellung abgeschlossen | PraxisMaik"
  description="Informationen zu deiner Bestellung des PraxisMaik Fachgespräch-Masterkits."
>
  <main class="pm-success">
    <div class="pm-success-card">
      <div class="pm-success-icon" aria-hidden="true">✓</div>

      <span class="pm-success-eyebrow">
        PRAXISMAIK SHOP
      </span>

      {
        paymentVerified ? (
          <h1>Vielen Dank für deinen Kauf!</h1>
        ) : (
          <h1>Zahlungsbestätigung wird geprüft</h1>
        )
      }

      {
        paymentVerified ? (
          <p class="pm-success-lead">
            Deine Zahlung für das
            <strong>&nbsp;Fachgespräch-Masterkit Generalistik</strong>
            wurde erfolgreich bestätigt.
          </p>
        ) : (
          <p class="pm-success-lead">
            {errorMessage}
            Falls du bereits bezahlt hast, führe bitte keinen weiteren Kauf durch.
          </p>
        )
      }

      <div class="pm-success-info">
        <h2>So erhältst du dein Masterkit</h2>

        <p>
          Sobald deine Zahlung bestätigt wurde, senden wir
          deinen persönlichen Downloadlink an die
          E-Mail-Adresse aus deiner Bestellung.
        </p>

        <p>
          Über diesen Link kannst du dein Masterkit
          als PDF herunterladen.
        </p>

        <p>
          Der Downloadlink ist 7 Tage gültig.
        </p>
      </div>

      <p class="pm-success-help">
        Du hast nach bestätigter Zahlung keine E-Mail erhalten?
        Prüfe bitte auch deinen Spamordner.
        Bei Problemen erreichst du uns unter
        <a href="mailto:kontakt@praxismaik.de">
          kontakt@praxismaik.de
        </a>.
      </p>

      <a class="pm-success-link" href="/shop/">
        Zurück zum PraxisMaik Shop
      </a>
    </div>
  </main>

  {paymentVerified && (
    <script
      is:inline
      define:vars={{ sessionId, purchaseValue, purchaseCurrency }}
    >
      if (
        sessionId &&
        sessionId.startsWith("cs_live_") &&
        typeof window.trackPraxisMaikEvent === "function"
      ) {
        const trackingKey = "praxismaik_ga4_purchase_" + sessionId;

        try {
          if (!localStorage.getItem(trackingKey)) {
            window.trackPraxisMaikEvent("purchase", {
              transaction_id: sessionId,
              value: purchaseValue,
              currency: purchaseCurrency,
              items: [
                {
                  item_id: "fachgespraech-masterkit",
                  item_name: "Fachgespräch-Masterkit Generalistik",
                  price: purchaseValue,
                  quantity: 1
                }
              ]
            });

            localStorage.setItem(trackingKey, "1");
          }
        } catch (error) {
          console.error("GA4-Kauftracking fehlgeschlagen:", error);
        }
      }
    </script>
  )}

</BaseLayout>

<style>
  .pm-success {
    --pm-orange: #e67e22;
    --pm-orange-dark: #b9570d;
    --pm-text: #342b24;
    --pm-muted: #665d55;
    --pm-border: #ead9c7;

    max-width: 780px;
    margin: 0 auto;
    padding: 65px 18px 90px;
  }

  .pm-success-card {
    padding: clamp(26px, 5vw, 52px);
    border: 1px solid var(--pm-border);
    border-radius: 22px;
    background: #fffaf4;
    text-align: center;
  }

  .pm-success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    margin: 0 auto 25px;
    border-radius: 50%;
    background: #fff0dd;
    color: var(--pm-orange-dark);
    font-size: 2.4rem;
    font-weight: 800;
  }

  .pm-success-eyebrow {
    color: var(--pm-orange-dark);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .pm-success h1 {
    margin: 18px 0;
    color: var(--pm-text);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.2;
  }

  .pm-success-lead {
    color: var(--pm-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .pm-success-lead strong {
    color: var(--pm-text);
  }

  .pm-success-info {
    margin-top: 32px;
    padding: 25px;
    border: 1px solid var(--pm-border);
    border-radius: 16px;
    background: #fff;
    text-align: left;
  }

  .pm-success-info h2 {
    margin: 0 0 18px;
    color: var(--pm-text);
    font-size: 1.3rem;
  }

  .pm-success-info p {
    color: var(--pm-muted);
    line-height: 1.75;
  }

  .pm-success-help {
    margin: 28px 0;
    color: var(--pm-muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .pm-success-help a {
    color: var(--pm-orange-dark);
    font-weight: 700;
  }

  .pm-success-link {
    display: inline-block;
    padding: 15px 25px;
    border-radius: 12px;
    background: var(--pm-orange);
    color: #fff;
    font-weight: 800;
    text-decoration: none;
  }

  .pm-success-link:hover {
    background: var(--pm-orange-dark);
  }
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PremiumGate from '../components/PremiumGate.astro';

const allQuizQuestions = await getCollection('quiz');

const isLocalhost =
  Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';

const devUnlock =
  Astro.url.searchParams.get('freischalten') === '1' && isLocalhost;

const visibleQuizQuestions = devUnlock
  ? allQuizQuestions
  : allQuizQuestions.filter((item) => item.data.premium !== true);

const freeCount = allQuizQuestions.filter((item) => item.data.premium !== true).length;
const premiumCount = allQuizQuestions.filter((item) => item.data.premium === true).length;

const availableTopics = [...new Set(
  visibleQuizQuestions
    .map((item) => item.data.topic?.trim())
    .filter(Boolean)
)].sort((a, b) => a.localeCompare(b, 'de'));

const pageTitle = 'Prüfungsquiz Pflege';
const hasVisibleQuestions = visibleQuizQuestions.length > 0;

function formatTopicLabel(topic) {
  const value = String(topic || '').trim().toLowerCase();

  const topicLabels = {
    anatomie: 'Anatomie',
    atmung: 'Atmung',
    demenz: 'Demenz',
    dokumentation: 'Dokumentation',
    ernaehrung: 'Ernährung',
    hygiene: 'Hygiene',
    kommunikation: 'Kommunikation',
    kreislauf: 'Kreislauf',
    medikation: 'Medikation',
    mobilisation: 'Mobilisation',
    mobilitaet: 'Mobilität',
    neurologie: 'Neurologie',
    notfall: 'Notfall',
    notfaelle: 'Notfälle',
    palliativ: 'Palliativ',
    'palliativ-care': 'Palliativ-Care',
    pflegeprozess: 'Pflegeprozess',
    prioritaet: 'Priorität',
    prophylaxe: 'Prophylaxe',
    psychiatrie: 'Psychiatrie',
    schmerz: 'Schmerz',
    sicherheit: 'Sicherheit',
    'sterben-tod-trauer': 'Sterben, Tod und Trauer',
    vitalzeichen: 'Vitalzeichen',
    wundversorgung: 'Wundversorgung'
  };

  if (topicLabels[value]) return topicLabels[value];

  return value
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join('-');
}
---

<BaseLayout title="Prüfungsquiz" description="Einfacher Lernmodus für Prüfungsfragen in der Pflegeausbildung.">
  <section class="quiz-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span class="breadcrumb-sep">›</span>
      <span class="current">Quiz</span>
    </nav>

    <h1>{pageTitle}</h1>

    {devUnlock && (
      <div class="dev-box">
        Testmodus aktiv, alle Quizfragen sind lokal freigeschaltet.
      </div>
    )}

    {!hasVisibleQuestions ? (
      <div class="quiz-empty-state">
        <p class="muted">
          Aktuell sind keine kostenlosen Quizfragen verfügbar.
        </p>

        <PremiumGate
          title="Quiz nur mit Premium"
          text="Die vollständigen Quizfragen sind nur für Premium freigeschaltet."
          buttonText="Premium freischalten"
          buttonHref="/premium"
        />
      </div>
    ) : (
      <>
        <section class="quiz-start-box">
          <p class="eyebrow">Lernquiz</p>
          <h2>Teste dein Wissen für die Pflegeprüfung.</h2>
          <p>
            Du bekommst immer eine Frage. Denk kurz nach, zeige dann die Antwort an
            und markiere, ob du sie gewusst hast.
          </p>

          <div class="quiz-start-actions">
            <button id="startQuizBtn" class="primary-btn" type="button">
              Quiz starten
            </button>

            <a href="/quiz-exam" class="btn secondary">
              Examensmodus
            </a>
          </div>

          {!devUnlock && premiumCount > 0 && (
            <p class="premium-hint">
              Kostenlos sichtbar: {freeCount} Frage{freeCount === 1 ? '' : 'n'}.
              Mit Premium werden weitere Fragen freigeschaltet.
            </p>
          )}
        </section>

        <section id="quizApp" class="quiz-app" hidden>
          <div class="quiz-toolbar">
            <label class="topic-select-label" for="topicSelect">
              Thema auswählen
            </label>

            <select id="topicSelect" class="topic-select">
              <option value="all">Alle Themen</option>
              {availableTopics.map((topic) => (
                <option value={String(topic).trim().toLowerCase()}>
                  {formatTopicLabel(topic)}
                </option>
              ))}
            </select>
          </div>

          <div class="quiz-small-status">
            <span id="quiz-counter">Frage 1 von {visibleQuizQuestions.length}</span>
            <span id="quiz-progress-text">0 gelernt</span>
          </div>

          <div class="quiz-progressbar" aria-hidden="true">
            <div id="quiz-progress-fill" class="quiz-progressbar-fill"></div>
          </div>

          <div class="quiz-stack">
            {visibleQuizQuestions.map((q, index) => (
              <article
                class={`quiz-slide${index === 0 ? ' active' : ''}`}
                data-index={index}
                data-slug={q.slug}
                data-question={q.data.question}
                data-answer={q.data.answer}
                data-difficulty={q.data.difficulty ?? ''}
                data-topic={q.data.topic ? String(q.data.topic).trim().toLowerCase() : ''}
              >
                <div class="quiz-card-main">
                  <p class="quiz-card-label">
                    {q.data.topic ? formatTopicLabel(q.data.topic) : 'Prüfungsfrage'}
                  </p>

                  <h2 class="quiz-question-title">
                    {q.data.question}
                  </h2>

                  <button class="btn quiz-toggle-answer" type="button">
                    Antwort anzeigen
                  </button>

                  <div class="quiz-answer-panel" hidden>
                    <h3>Antwort</h3>
                    <p>{q.data.answer}</p>

                    {q.data.difficulty ? (
                      <p class="muted quiz-meta">
                        Schwierigkeit: {q.data.difficulty}
                      </p>
                    ) : null}

                    <div class="quiz-result-actions">
                      <button class="btn secondary quiz-mark-known" type="button">
                        Gewusst
                      </button>
                      <button class="btn secondary quiz-mark-unknown" type="button">
                        Nochmal üben
                      </button>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="quiz-nav">
            <button id="quiz-prev" class="btn secondary" type="button">
              Zurück
            </button>

            <button id="quiz-next" class="btn" type="button">
              Nächste Frage
            </button>
          </div>

          <details class="quiz-more-actions">
            <summary>Weitere Optionen</summary>

            <div class="quiz-more-actions-inner">
              <button id="quiz-shuffle" class="btn secondary" type="button">
                Fragen mischen
              </button>

              <button id="resetProgressBtn" class="btn secondary" type="button">
                Fortschritt löschen
              </button>
            </div>
          </details>
        </section>
      </>
    )}
  </section>

  <script>
    const QUIZ_ANSWERS_STORAGE_KEY = 'quiz-answers';
    const WRONG_QUIZ_STORAGE_KEY = 'wrong-quiz-questions';

    const startQuizBtn = document.getElementById('startQuizBtn');
    const quizApp = document.getElementById('quizApp');

    const allSlides = Array.from(document.querySelectorAll('.quiz-slide'));
    const topicSelect = document.getElementById('topicSelect');

    const counter = document.getElementById('quiz-counter');
    const prevBtn = document.getElementById('quiz-prev');
    const nextBtn = document.getElementById('quiz-next');
    const shuffleBtn = document.getElementById('quiz-shuffle');
    const resetBtn = document.getElementById('resetProgressBtn');

    const progressTextEl = document.getElementById('quiz-progress-text');
    const progressFillEl = document.getElementById('quiz-progress-fill');

    let activeTopic = 'all';
    let visibleSlides = [...allSlides];
    let currentIndex = 0;

    const answers = new Map();

    function loadSavedAnswers() {
      try {
        const raw = localStorage.getItem(QUIZ_ANSWERS_STORAGE_KEY);
        if (!raw) return;

        const parsed = JSON.parse(raw);

        Object.entries(parsed).forEach(([key, value]) => {
          if (value === 'known' || value === 'unknown') {
            answers.set(Number(key), value);
          }
        });
      } catch (error) {
        console.error('Fehler beim Laden der Quiz-Antworten:', error);
      }
    }

    function saveAnswers() {
      localStorage.setItem(
        QUIZ_ANSWERS_STORAGE_KEY,
        JSON.stringify(Object.fromEntries(answers))
      );
    }

    function getWrongQuestions() {
      try {
        const raw = localStorage.getItem(WRONG_QUIZ_STORAGE_KEY);
        if (!raw) return [];

        const parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : [];
      } catch (error) {
        console.error('Fehler beim Laden der Fehlerfragen:', error);
        return [];
      }
    }

    function saveWrongQuestions(items) {
      localStorage.setItem(WRONG_QUIZ_STORAGE_KEY, JSON.stringify(items));
    }

    function addWrongQuestion(questionData) {
      const existing = getWrongQuestions();
      const alreadyExists = existing.some((item) => item.slug === questionData.slug);

      if (alreadyExists) return;

      existing.push(questionData);
      saveWrongQuestions(existing);
    }

    function removeWrongQuestion(slug) {
      const existing = getWrongQuestions();
      const filtered = existing.filter((item) => item.slug !== slug);
      saveWrongQuestions(filtered);
    }

    function prioritizeWrongQuestions(slides) {
      const wrongQuestions = getWrongQuestions();
      const wrongSlugs = new Set(wrongQuestions.map((item) => item.slug));

      const wrongSlides = [];
      const normalSlides = [];

      slides.forEach((slide) => {
        const slug = slide.dataset.slug || '';

        if (wrongSlugs.has(slug)) {
          wrongSlides.push(slide);
        } else {
          normalSlides.push(slide);
        }
      });

      return [...wrongSlides, ...normalSlides];
    }

    function getVisibleGlobalIndexes() {
      return visibleSlides.map((slide) => Number(slide.dataset.index));
    }

    function updateStats() {
      const visibleIndexes = getVisibleGlobalIndexes();
      const answeredCount = visibleIndexes.filter((index) => answers.has(index)).length;

      const progressPercent = visibleIndexes.length > 0
        ? Math.round((answeredCount / visibleIndexes.length) * 100)
        : 0;

      if (progressTextEl) {
        progressTextEl.textContent = `${answeredCount} von ${visibleIndexes.length} gelernt`;
      }

      if (progressFillEl) {
        progressFillEl.style.width = `${progressPercent}%`;
      }
    }

    function resetSlideUi(slide) {
      const answerPanel = slide.querySelector('.quiz-answer-panel');
      const toggleBtn = slide.querySelector('.quiz-toggle-answer');
      const knownBtn = slide.querySelector('.quiz-mark-known');
      const unknownBtn = slide.querySelector('.quiz-mark-unknown');

      if (answerPanel) {
        answerPanel.setAttribute('hidden', '');
      }

      if (toggleBtn) {
        toggleBtn.textContent = 'Antwort anzeigen';
      }

      knownBtn?.classList.remove('active-known');
      unknownBtn?.classList.remove('active-unknown');
    }

    function applyTopicFilter(topic) {
      activeTopic = topic;

      visibleSlides = allSlides.filter((slide) => {
        const slideTopic = (slide.dataset.topic || '').trim().toLowerCase();
        return activeTopic === 'all' || slideTopic === activeTopic;
      });

      visibleSlides = prioritizeWrongQuestions(visibleSlides);
      currentIndex = 0;

      updateView();
    }

    function updateView() {
      allSlides.forEach((slide) => {
        slide.classList.remove('active');
        slide.style.display = 'none';
      });

      if (visibleSlides.length === 0) {
        if (counter) {
          counter.textContent = 'Keine Fragen in diesem Thema';
        }

        if (prevBtn) prevBtn.disabled = true;
        if (nextBtn) nextBtn.disabled = true;

        updateStats();
        return;
      }

      if (currentIndex < 0) currentIndex = 0;
      if (currentIndex > visibleSlides.length - 1) currentIndex = visibleSlides.length - 1;

      const activeSlide = visibleSlides[currentIndex];
      activeSlide.style.display = '';
      activeSlide.classList.add('active');

      allSlides.forEach((slide) => {
        const globalIndex = Number(slide.dataset.index);
        const knownBtn = slide.querySelector('.quiz-mark-known');
        const unknownBtn = slide.querySelector('.quiz-mark-unknown');

        knownBtn?.classList.remove('active-known');
        unknownBtn?.classList.remove('active-unknown');

        if (answers.get(globalIndex) === 'known') {
          knownBtn?.classList.add('active-known');
        }

        if (answers.get(globalIndex) === 'unknown') {
          unknownBtn?.classList.add('active-unknown');
        }
      });

      if (counter) {
        counter.textContent = `Frage ${currentIndex + 1} von ${visibleSlides.length}`;
      }

      if (prevBtn) {
        prevBtn.disabled = currentIndex === 0;
      }

      if (nextBtn) {
        nextBtn.disabled = currentIndex === visibleSlides.length - 1;
      }

      updateStats();
    }

    function shuffleVisibleSlides() {
      for (let i = visibleSlides.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [visibleSlides[i], visibleSlides[j]] = [visibleSlides[j], visibleSlides[i]];
      }

      visibleSlides = prioritizeWrongQuestions(visibleSlides);

      visibleSlides.forEach((slide) => {
        resetSlideUi(slide);
      });

      currentIndex = 0;
      updateView();
    }

    function markAnswer(globalIndex, value, slide, knownBtn, unknownBtn) {
      answers.set(globalIndex, value);
      saveAnswers();

      const slug = slide.dataset.slug || '';

      if (value === 'known') {
        if (slug) {
          removeWrongQuestion(slug);
        }

        knownBtn?.classList.add('active-known');
        unknownBtn?.classList.remove('active-unknown');
      }

      if (value === 'unknown') {
        const wrongQuestion = {
          slug: slide.dataset.slug || '',
          question: slide.dataset.question || '',
          answer: slide.dataset.answer || '',
          topic: slide.dataset.topic || '',
          difficulty: slide.dataset.difficulty || ''
        };

        if (wrongQuestion.slug && wrongQuestion.question && wrongQuestion.answer) {
          addWrongQuestion(wrongQuestion);
        }

        unknownBtn?.classList.add('active-unknown');
        knownBtn?.classList.remove('active-known');
      }

      visibleSlides = prioritizeWrongQuestions(visibleSlides);
      updateView();
    }

    function resetProgress() {
      localStorage.removeItem(QUIZ_ANSWERS_STORAGE_KEY);
      localStorage.removeItem(WRONG_QUIZ_STORAGE_KEY);
      location.reload();
    }

    loadSavedAnswers();

    allSlides.forEach((slide) => {
      const globalIndex = Number(slide.dataset.index);
      const toggleBtn = slide.querySelector('.quiz-toggle-answer');
      const answerPanel = slide.querySelector('.quiz-answer-panel');
      const knownBtn = slide.querySelector('.quiz-mark-known');
      const unknownBtn = slide.querySelector('.quiz-mark-unknown');

      if (toggleBtn && answerPanel) {
        toggleBtn.addEventListener('click', () => {
          const isHidden = answerPanel.hasAttribute('hidden');

          if (isHidden) {
            answerPanel.removeAttribute('hidden');
            toggleBtn.textContent = 'Antwort ausblenden';
          } else {
            answerPanel.setAttribute('hidden', '');
            toggleBtn.textContent = 'Antwort anzeigen';
          }
        });
      }

      if (knownBtn) {
        knownBtn.addEventListener('click', () => {
          markAnswer(globalIndex, 'known', slide, knownBtn, unknownBtn);
        });
      }

      if (unknownBtn) {
        unknownBtn.addEventListener('click', () => {
          markAnswer(globalIndex, 'unknown', slide, knownBtn, unknownBtn);
        });
      }
    });

    if (startQuizBtn && quizApp) {
      startQuizBtn.addEventListener('click', () => {
        quizApp.hidden = false;
        startQuizBtn.textContent = 'Quiz läuft';
        startQuizBtn.disabled = true;
        quizApp.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex -= 1;
          updateView();
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentIndex < visibleSlides.length - 1) {
          currentIndex += 1;
          updateView();
        }
      });
    }

    if (shuffleBtn) {
      shuffleBtn.addEventListener('click', () => {
        shuffleVisibleSlides();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        const confirmReset = confirm('Willst du wirklich deinen Fortschritt löschen?');

        if (confirmReset) {
          resetProgress();
        }
      });
    }

    if (topicSelect) {
      topicSelect.addEventListener('change', () => {
        const topic = topicSelect.value || 'all';
        const url = topic === 'all'
          ? '/quiz'
          : `/quiz?topic=${encodeURIComponent(topic)}`;

        window.history.replaceState({}, '', url);
        applyTopicFilter(topic);
      });
    }

    const urlParams = new URLSearchParams(window.location.search);
    const initialTopic = (urlParams.get('topic') || 'all').trim().toLowerCase();

    if (topicSelect) {
      topicSelect.value = initialTopic;
    }

    applyTopicFilter(initialTopic);
  </script>

  <style>
    .quiz-page {
      max-width: 920px;
      margin: 0 auto;
    }

    .dev-box {
      margin-bottom: 1.5rem;
      padding: 0.9rem 1rem;
      border: 1px solid #d1fae5;
      background: #ecfdf5;
      color: #065f46;
      border-radius: 12px;
      font-weight: 700;
    }

    .quiz-start-box {
      margin: 1.5rem 0 2rem;
      padding: 1.5rem;
      border: 1px solid rgba(24, 50, 74, 0.12);
      border-radius: 20px;
      background: #ffffff;
      box-shadow: 0 10px 30px rgba(24, 50, 74, 0.08);
    }

    .quiz-start-box h2 {
      margin: 0 0 0.75rem;
      font-size: clamp(1.5rem, 4vw, 2.1rem);
      line-height: 1.15;
      color: #18324a;
    }

    .quiz-start-box p {
      max-width: 680px;
      margin: 0 0 1rem;
      color: #475569;
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .eyebrow {
      margin-bottom: 0.5rem !important;
      color: #c97a63 !important;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.85rem !important;
    }

    .quiz-start-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }

    .premium-hint {
      margin-top: 1rem !important;
      padding: 0.85rem 1rem;
      border-radius: 14px;
      background: rgba(201, 122, 99, 0.08);
      color: #18324a !important;
      font-weight: 600;
    }

    .quiz-app {
      margin-top: 1.5rem;
    }

    .quiz-toolbar {
      display: grid;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .topic-select-label {
      font-weight: 800;
      color: #18324a;
    }

    .topic-select {
      width: 100%;
      max-width: 420px;
      padding: 0.85rem 1rem;
      border: 1px solid rgba(24, 50, 74, 0.18);
      border-radius: 12px;
      background: #ffffff;
      color: #18324a;
      font: inherit;
      font-weight: 700;
    }

    .quiz-small-status {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin: 1rem 0 0.5rem;
      color: #475569;
      font-weight: 700;
      font-size: 0.95rem;
    }

    .quiz-progressbar {
      height: 9px;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(24, 50, 74, 0.1);
      margin-bottom: 1.25rem;
    }

    .quiz-progressbar-fill {
      width: 0%;
      height: 100%;
      border-radius: 999px;
      background: #c97a63;
      transition: width 0.2s ease;
    }

    .quiz-stack {
      margin-top: 1rem;
    }

    .quiz-slide {
      display: none;
    }

    .quiz-slide.active {
      display: block;
    }

    .quiz-card-main {
      padding: 1.4rem;
      border: 1px solid rgba(24, 50, 74, 0.12);
      border-radius: 20px;
      background: #ffffff;
      box-shadow: 0 10px 30px rgba(24, 50, 74, 0.08);
    }

    .quiz-card-label {
      margin: 0 0 0.75rem;
      color: #c97a63;
      font-weight: 800;
      font-size: 0.95rem;
    }

    .quiz-question-title {
      margin: 0 0 1.25rem;
      color: #18324a;
      font-size: clamp(1.35rem, 4vw, 2rem);
      line-height: 1.25;
    }

    .quiz-answer-panel {
      margin-top: 1.25rem;
      padding: 1rem;
      border-radius: 16px;
      background: #f8fafc;
      border: 1px solid rgba(24, 50, 74, 0.1);
    }

    .quiz-answer-panel h3 {
      margin: 0 0 0.5rem;
      color: #18324a;
    }

    .quiz-answer-panel p {
      color: #334155;
      line-height: 1.7;
    }

    .quiz-meta {
      font-size: 0.95rem;
      margin-top: 0.75rem;
    }

    .quiz-result-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .quiz-mark-known.active-known {
      border-color: #16a34a;
      background: #dcfce7;
      color: #166534;
    }

    .quiz-mark-unknown.active-unknown {
      border-color: #dc2626;
      background: #fee2e2;
      color: #991b1b;
    }

    .quiz-nav {
      display: flex;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .quiz-nav .btn {
      flex: 1;
    }

    .quiz-nav button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .quiz-more-actions {
      margin-top: 1rem;
      color: #475569;
    }

    .quiz-more-actions summary {
      cursor: pointer;
      font-weight: 800;
      color: #18324a;
    }

    .quiz-more-actions-inner {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 0.85rem;
    }

    @media (max-width: 640px) {
      .quiz-start-box,
      .quiz-card-main {
        padding: 1.1rem;
        border-radius: 16px;
      }

      .quiz-start-actions,
      .quiz-result-actions,
      .quiz-nav {
        flex-direction: column;
      }

      .quiz-start-actions .btn,
      .quiz-start-actions .primary-btn,
      .quiz-result-actions .btn,
      .quiz-nav .btn {
        width: 100%;
      }

      .quiz-small-status {
        flex-direction: column;
        gap: 0.25rem;
      }
    }
  </style>
</BaseLayout>
<script>
  import { createClient } from "@supabase/supabase-js";

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const form =
    document.getElementById(
      "praxisanleiter-checkout-form"
    );

  const button =
    document.getElementById(
      "praxisanleiter-checkout-button"
    );

  const message =
    document.getElementById(
      "praxisanleiter-checkout-message"
    );

  function setMessage(text) {
    if (message instanceof HTMLElement) {
      message.textContent = text;
    }
  }

  function resetButton() {
    if (button instanceof HTMLButtonElement) {
      button.disabled = false;
      button.textContent =
        "Praxisanleiter Premium freischalten";
    }
  }

  form?.addEventListener(
    "submit",
    async (event) => {
      event.preventDefault();

      if (!(button instanceof HTMLButtonElement)) {
        return;
      }

      button.disabled = true;
      button.textContent =
        "Anmeldung wird geprüft ...";

      setMessage(
        "Dein PraxisMaik-Konto wird geprüft ..."
      );

      try {
        const {
          data: { session },
          error: sessionError,
        } = await supabase.auth.getSession();

        if (
          sessionError ||
          !session ||
          !session.access_token
        ) {
          window.location.href =
            "/login?redirect=%2Fpraxisanleiter-premium";
          return;
        }

        const {
          data: { user },
          error: userError,
        } = await supabase.auth.getUser();

        if (userError || !user) {
          await supabase.auth.signOut({
            scope: "local",
          });

          window.location.href =
            "/login?redirect=%2Fpraxisanleiter-premium";
          return;
        }

        button.textContent =
          "Stripe wird geöffnet ...";

        setMessage(
          "Alles geprüft. Du wirst jetzt sicher zu Stripe weitergeleitet."
        );

        const response = await fetch(
          "/api/checkout-praxisanleiter",
          {
            method: "POST",

            headers: {
              Authorization:
                `Bearer ${session.access_token}`,
              "Content-Type":
                "application/json",
            },
          }
        );

        let result = {};

        try {
          result = await response.json();
        } catch {
          result = {};
        }

        if (response.status === 401) {
          await supabase.auth.signOut({
            scope: "local",
          });

          window.location.href =
            "/login?redirect=%2Fpraxisanleiter-premium";
          return;
        }

        if (!response.ok) {
          const errorMessage =
            typeof result.error === "string"
              ? result.error
              : "Der Bezahlvorgang konnte nicht gestartet werden.";

          setMessage(errorMessage);
          resetButton();

          return;
        }

        if (
          typeof result.url !== "string" ||
          !result.url.startsWith("https://")
        ) {
          setMessage(
            "Stripe konnte nicht geöffnet werden. Bitte versuche es erneut."
          );

          resetButton();

          return;
        }

        window.location.href = result.url;
      } catch (error) {
        console.error(
          "Praxisanleiter Checkout Fehler:",
          error
        );

        setMessage(
          "Der Bezahlvorgang konnte nicht gestartet werden. Bitte versuche es erneut."
        );

        resetButton();
      }
    }
  );
</script>


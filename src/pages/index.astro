<style is:global>
.home-page {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2.5rem 1rem 3rem;
}

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
  align-items: center;
  gap: 2.5rem;
  padding: 1rem 0 2rem;
}

.hero-text {
  max-width: 620px;
}

.eyebrow {
  display: inline-block;
  margin-bottom: 0.6rem;
  padding: 0.35rem 0.65rem;
  border-radius: 999px;
  background: #eef5ff;
  color: #2f5f9b;
  font-size: 0.7rem;
  font-weight: 600;
}

.hero h1 {
  margin: 0 0 0.7rem 0;
  max-width: 16ch;
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  line-height: 1.12;
  letter-spacing: -0.01em;
  font-weight: 700;
}

.hero-lead {
  margin: 0;
  max-width: 42ch;
  font-size: 1rem;
  line-height: 1.65;
  color: #5b6b7a;
}

.hero-sublead {
  margin: 0.9rem 0 0;
  max-width: 42ch;
  font-size: 0.98rem;
  line-height: 1.65;
  color: #7f1d1d;
  font-weight: 600;
}

.button-group {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  margin-top: 1.4rem;
}

.hero-figure {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 0;
}

.hero-circle {

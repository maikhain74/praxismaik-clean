---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExpertBox from "../components/ExpertBox.astro";

const title =
  "PraxisMaik | Pflegeprüfung lernen mit Fällen und Quiz";

const description =
  "Lerne für deine Pflegeausbildung mit realistischen Fallbeispielen, Quizfragen, Lernskripten und Prüfungssimulationen für die Pflegeprüfung.";

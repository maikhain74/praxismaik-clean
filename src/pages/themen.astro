---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("themen");

const categoryDefinitions = [
  {
    slug: "anatomie",
    title: "Anatomie",
    icon: "🫀",
    description: "Grundlagen des Körpers verstehen.",
    group: "Grundlagen verstehen",
  },
  {
    slug: "hygiene",
    title: "Hygiene",
    icon: "🧼",
    description: "Infektionen vermeiden und sicher arbeiten.",
    group: "Grundlagen verstehen",
  },
  {
    slug: "vitalzeichen",
    title: "Vitalzeichen",
    icon: "💓",
    description: "Puls, Blutdruck und Atmung richtig einschätzen.",
    group: "Grundlagen verstehen",
  },
  {
    slug: "krankheitslehre",
    title: "Krankheitslehre",
    icon: "🩺",
    description: "Krankheiten verstehen und einordnen.",
    group: "Grundlagen verstehen",
  },
  {
    slug: "medikamente",
    title: "Medikamente",
    icon: "💊",
    description: "Sicherer Umgang mit Medikamenten.",
    group: "Grundlagen verstehen",
  },
  {
    slug: "pflegeausbildung",
    title: "Pflegeausbildung",
    icon: "🎓",
    description: "Kompetenzbereiche, Pflegeprozess, Pflegediagnosen und Prüfungsthemen verstehen.",
    group: "Pflegerisch handeln",
  },
  {
    slug: "pflegeprozess",
    title: "Pflegeprozess",
    icon: "📝",
    description: "Pflege planen und durchführen.",
    group: "Pflegerisch handeln",
  },
  {
    slug: "notfaelle",
    title: "Notfälle",
    icon: "🚑",
    description: "Notfälle erkennen und handeln.",
    group: "Pflegerisch handeln",
  },
  {
    slug: "prophylaxen",
    title: "Prophylaxen",
    icon: "🛡️",
    description: "Komplikationen vorbeugen.",
    group: "Pflegerisch handeln",
  },
  {
    slug: "mobilitaet",
    title: "Mobilität",
    icon: "🚶",
    description: "Bewegung fördern, Selbstständigkeit erhalten und Komplikationen vermeiden.",
    group: "Pflegerisch handeln",
  },
  {
    slug: "kommunikation",
    title: "Kommunikation",
    icon: "💬",
    description: "Professionell mit Patienten und Team sprechen.",
    group: "Menschen begleiten",
  },
  {
    slug: "demenz",
    title: "Demenz",
    icon: "🧠",
    description: "Menschen mit Demenz begleiten.",
    group: "Menschen begleiten",
  },
  {
    slug: "palliative-care",
    title: "Palliative Care",
    icon: "🕊️",
    description: "Menschen am Lebensende begleiten.",
    group: "Menschen begleiten",
  },
  {
    slug: "einsatzbereiche",
    title: "Einsatzbereiche",
    icon: "🏥",
    description: "Pflege in verschiedenen Settings verstehen.",
    group: "Menschen begleiten",
  },
  {
    slug: "recht",
    title: "Recht in der Pflege",
    icon: "⚖️",
    description: "Rechtlich sicher handeln.",
    group: "Qualität und Verantwortung",
  },
  {
    slug: "expertenstandards",
    title: "Expertenstandards",
    icon: "📘",
    description: "Pflege nach Standards durchführen.",
    group: "Qualität und Verantwortung",
  },
];

const categories = categoryDefinitions.map((category) => {
  const subtopics = entries.filter((entry) =>
    entry.slug.startsWith(`${category.slug}/`)
  );

  return {
    ...category,
    count: subtopics.length,
  };
});

const grouped = [
  {
    title: "Grundlagen verstehen",
    items: categories.filter((c) => c.group === "Grundlagen verstehen"),
  },
  {
    title: "Pflegerisch handeln",
    items: categories.filter((c) => c.group === "Pflegerisch handeln"),
  },
  {
    title: "Menschen begleiten",
    items: categories.filter((c) => c.group === "Menschen begleiten"),
  },
  {
    title: "Qualität und Verantwortung",
    items: categories.filter((c) => c.group === "Qualität und Verantwortung"),
  },
];
---

<BaseLayout title="Themen">
  <main class="container">
  <section class="themes-hero">
    <span class="themes-eyebrow">PraxisMaik Themen</span>

    <h1>Was möchtest du heute lernen?</h1>

    <p>
      Wähle einen Themenbereich und lerne Pflege Schritt für Schritt,
      von Grundlagen bis zu Prüfungsfällen und Praxisbesuchen.
    </p>
  </section>

    {grouped.map((group) => (
      <section>
        <h2>{group.title}</h2>

        <div class="grid">
          {group.items.map((cat) => (
            <a class="card" href={`/themen/${cat.slug}/`}>
              <span class="icon">{cat.icon}</span>
              <h3>{cat.title}</h3>
              <p>{cat.description}</p>
              <small>{cat.count === 0 ? "Übersicht" : cat.count === 1 ? "1 Thema" : `${cat.count} Themen`}</small>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
.container {
  max-width: 1100px;
  margin: auto;
  padding: 2.2rem 1rem 3rem;
}

.themes-hero {
  max-width: 760px;
  margin-bottom: 2.8rem;
}

.themes-eyebrow {
  display: inline-block;
  margin-bottom: 0.7rem;
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  background: #eef5ff;
  color: #18324a;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.themes-hero h1 {
  margin: 0 0 0.8rem;
  font-size: clamp(2rem, 3vw, 3rem);
  line-height: 1.1;
  color: #18324a;
}

.themes-hero p {
  margin: 0;
  max-width: 62ch;
  color: #556270;
  line-height: 1.75;
  font-size: 1.05rem;
}

section + section {
  margin-top: 2.8rem;
}

h2 {
  margin: 0 0 1rem;
  color: #18324a;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.2rem;
}

.card {
  display: block;
  min-height: 190px;
  padding: 1.35rem;
  border-radius: 20px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  text-decoration: none;
  color: inherit;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

.card:hover {
  transform: translateY(-4px);
  border-color: #c97b63;
  box-shadow: 0 16px 32px rgba(24, 50, 74, 0.09);
  text-decoration: none;
}

.icon {
  display: inline-flex;
  margin-bottom: 0.8rem;
  font-size: 1.7rem;
}

.card h3 {
  margin: 0 0 0.55rem;
  color: #18324a;
}

.card p {
  margin: 0;
  color: #556270;
  line-height: 1.6;
}

.card small {
  display: inline-flex;
  margin-top: 1rem;
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  background: #fff4e8;
  color: #9a3412;
  font-weight: 800;
}

@media (max-width: 900px) {
  .grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .grid {
    grid-template-columns: 1fr;
  }
}
</style>
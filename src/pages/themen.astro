  .category-card-title {
    word-break: break-word;
  }

  .topic-card-text {
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .topics-hero {
    max-width: 1000px;
  }

  .topics-hero h1 {
    max-width: 22ch;
  }
/* ===== KARTEN-FIX FÜR LANGE TITEL ===== */


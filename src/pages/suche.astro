---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Suche" description="Suche in allen Themen von PraxisMaik.">
  <section class="search-page">
    <h1>Suche</h1>
    <p class="muted">Suche nach Titel, Stichwort, Kategorie oder Inhalt.</p>

    <input
      id="q"
      class="searchbox"
      type="search"
      placeholder="z. B. Händedesinfektion, Demenz, Sturz..."
      autocomplete="off"
    />

    <p id="search-info" class="muted" style="margin-top:12px;"></p>

    <div id="results" class="topic-grid" style="margin-top:16px;"></div>
  </section>

  <script is:inline>
    async function runSearch() {
      const response = await fetch("/search-index.json");
      const data = await response.json();

      const q = document.getElementById("q");
      const out = document.getElementById("results");
      const info = document.getElementById("search-info");

      function esc(value) {
        return String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;");
      }

      function snippet(text, term) {
        const source = String(text || "");
        const lower = source.toLowerCase();
        const searchTerm = term.toLowerCase();

        const position = lower.indexOf(searchTerm);

        if (position === -1) {
          return source.slice(0, 140) + (source.length > 140 ? "..." : "");
        }

        const start = Math.max(0, position - 45);
        const end = Math.min(source.length, position + 95);

        let part = source.slice(start, end).trim();

        if (start > 0) {
          part = "..." + part;
        }

        if (end < source.length) {
          part = part + "...";
        }

        return part;
      }

      function scoreItem(item, term) {
        const searchTerm = term.toLowerCase();
        let score = 0;

        const title = String(item.title || "").toLowerCase();
        const description = String(item.description || "").toLowerCase();
        const category = String(item.category || "").toLowerCase();
        const content = String(item.content || "").toLowerCase();

        if (title.includes(searchTerm)) score += 10;
        if (description.includes(searchTerm)) score += 6;
        if (category.includes(searchTerm)) score += 4;
        if (content.includes(searchTerm)) score += 2;

        if (title.startsWith(searchTerm)) score += 5;
        if (category.startsWith(searchTerm)) score += 2;

        return score;
      }

      function renderResults(list, term) {
        if (!list.length) {
          out.innerHTML = "";
          info.textContent = `Keine Treffer für "${term}".`;
          return;
        }

        info.textContent = `${list.length} Treffer für "${term}".`;

        out.innerHTML = list
          .map((item) => {
            const preview =
              item.description && item.description.trim()
                ? item.description
                : snippet(item.content || "", term);

            return `
              <a class="topic-card" href="${esc(item.url)}">
                <h3>${esc(item.title)}</h3>
                <p>${esc(preview)}</p>
                <p class="muted" style="margin-top:8px;">${esc(item.category)}</p>
              </a>
            `;
          })
          .join("");
      }

      function search(term) {
        const cleanTerm = term.trim();

        if (!cleanTerm) {
          out.innerHTML = "";
          info.textContent = "Gib einen Suchbegriff ein.";
          return;
        }

        const hits = data
          .map((item) => ({
            ...item,
            _score: scoreItem(item, cleanTerm),
          }))
          .filter((item) => item._score > 0)
          .sort((a, b) => b._score - a._score)
          .slice(0, 50);

        renderResults(hits, cleanTerm);
      }

      q.addEventListener("input", () => search(q.value));

      const params = new URLSearchParams(window.location.search);
      const initialQuery = params.get("q");

      if (initialQuery) {
        q.value = initialQuery;
        search(initialQuery);
      } else {
        info.textContent = "Gib einen Suchbegriff ein.";
      }
    }

    runSearch();
  </script>
</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="1:1 Lernhilfe für Pflegeazubis | PraxisMaik"
  description="Persönliche 1:1 Lernhilfe für Pflegeazubis. 45 Minuten individuell vorbereitet für dein konkretes Lernproblem."
>
  <main class="lernhilfe-page">
    <section class="lernhilfe-hero">
      <div class="hero__content">
        <span class="eyebrow">Persönliche 1:1 Lernhilfe</span>

        <h1>
          Du hängst gerade bei einem
          <span>Pflegethema fest?</span>
        </h1>

        <p class="hero__lead">
          Vielleicht verstehst du die Pflegeplanung nicht, dein Praxisbesuch
          steht bevor oder du sitzt vor einem Fallbeispiel und weißt nicht,
          wo du anfangen sollst.
        </p>

        <p class="hero__statement">
          Du musst nicht noch zehn Videos anschauen und hoffen, dass irgendwo
          genau deine Frage beantwortet wird.
        </p>

        <a href="#interesse" class="primary-button">
          1:1 Lernhilfe vormerken
        </a>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <span class="eyebrow">So funktioniert es</span>
        <h2>45 Minuten nur für dein konkretes Problem</h2>

        <p>
          Du beschreibst mir vorher, wobei du gerade nicht weiterkommst.
          Dadurch kann ich mich auf dein Thema vorbereiten und wir verlieren
          im Gespräch keine Zeit mit allgemeinen Erklärungen.
        </p>
      </div>

      <div class="steps">
        <article class="step-card">
          <span class="step-number">1</span>
          <h3>Du beschreibst dein Problem</h3>
          <p>
            Sag mir, bei welchem Thema du festhängst und was dir gerade
            Schwierigkeiten macht.
          </p>
        </article>

        <article class="step-card">
          <span class="step-number">2</span>
          <h3>Ich bereite mich vor</h3>
          <p>
            Ich schaue mir dein Thema vor unserem Gespräch an und bereite die
            Lernhilfe gezielt darauf vor.
          </p>
        </article>

        <article class="step-card">
          <span class="step-number">3</span>
          <h3>Wir arbeiten gemeinsam daran</h3>
          <p>
            Im persönlichen Videogespräch geht es nicht um irgendein
            Pflegethema, sondern genau um das, was du verstehen möchtest.
          </p>
        </article>
      </div>

<div class="learning-path">
  <p><strong>Unser Ziel:</strong> verstehen → anwenden → selbst erklären können</p>
</div>
    </section>

    <section class="section section-soft">
      <div class="section-heading">
        <span class="eyebrow">Mögliche Themen</span>
        <h2>Wobei kann ich dich unterstützen?</h2>
      </div>

      <div class="topic-grid">
        <article class="topic-card">
          <h3>Pflegeplanung & Pflegeprozess</h3>
          <p>
            Zusammenhänge verstehen, Probleme erkennen, Ziele formulieren und
            Maßnahmen sinnvoll ableiten.
          </p>
        </article>

        <article class="topic-card">
          <h3>Pflegediagnosen & PESR</h3>
          <p>
            Nicht nur Begriffe auswendig lernen, sondern verstehen, was
            Problem, Einflussfaktoren, Symptome und Ressourcen bedeuten.
          </p>
        </article>

        <article class="topic-card">
          <h3>Praxisbesuch</h3>
          <p>
            Pflegerische Entscheidungen erklären, Maßnahmen begründen und
            sicherer durch typische Gesprächssituationen gehen.
          </p>
        </article>

        <article class="topic-card">
          <h3>Praktische Prüfung</h3>
          <p>
            Situationen einschätzen, Prioritäten erkennen und dein Vorgehen
            nachvollziehbar begründen.
          </p>
        </article>

        <article class="topic-card">
          <h3>Fallbeispiele & klinisches Denken</h3>
          <p>
            Lernen, relevante Informationen zu erkennen und Schritt für Schritt
            zu einer begründeten pflegerischen Entscheidung zu kommen.
          </p>
        </article>

        <article class="topic-card">
          <h3>Fachthema verstehen</h3>
          <p>
            Wenn dir ein bestimmtes Pflegethema trotz Unterricht, Skript oder
            Video einfach nicht klar wird.
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="about-box">
        <div>
          <span class="eyebrow">Warum mit Maik?</span>

          <h2>
            Du lernst mit jemandem, der Pflege nicht nur aus Lehrbüchern kennt.
          </h2>

          <p>
            Ich kenne sowohl die Anforderungen der Pflegeausbildung als auch
            die Situationen, in denen Theorie und Pflegealltag plötzlich nicht
            mehr so einfach zusammenpassen.
          </p>
        </div>

        <div class="experience-grid">
          <div>
            <strong>27 Jahre</strong>
            <span>Pflege</span>
          </div>

          <div>
            <strong>21 Jahre</strong>
            <span>Pflegefachkraft</span>
          </div>

          <div>
            <strong>5 Jahre</strong>
            <span>Praxisanleiter</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="price-box">
        <span class="eyebrow">1:1 Lernhilfe mit Maik</span>

        <h2>Individuell vorbereitet auf dein Lernproblem</h2>

        <div class="price">
          <strong>49 €</strong>
          <span>für 45 Minuten</span>
        </div>

        <ul>
          <li>persönliches 1:1 Videogespräch</li>
          <li>Vorbereitung auf dein konkretes Thema</li>
          <li>45 Minuten fokussierte Lernzeit</li>
          <li>keine langfristige Verpflichtung</li>
        </ul>

        <div class="boundary-box">
          <strong>Wichtig:</strong>
          <p>
            Die Lernhilfe ist keine Hausaufgaben-Erledigung und keine fertige
            Prüfungslösung. Mein Ziel ist, dass du den Zusammenhang verstehst
            und danach selbst weiterkommst.
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="interesse">
      <div class="form-wrapper">
        <div class="section-heading">
          <span class="eyebrow">Interesse vormerken</span>

          <h2>Möchtest du zu den Ersten gehören?</h2>

          <p>
            Das 1:1-Angebot befindet sich gerade im Aufbau. Trag dich ein und
            beschreibe mir kurz, wobei du Unterstützung brauchst.
          </p>

          <p class="test-note">
            Die 45-minütige Lernhilfe ist mit <strong>49 €</strong> geplant.
            Mit deiner Anfrage buchst und bezahlst du noch nichts.
          </p>
        </div>

        <form id="lernhilfe-form" class="lernhilfe-form">
          <div class="form-field">
            <label for="vorname">
              Vorname
            </label>

            <input
              type="text"
              id="vorname"
              name="vorname"
              autocomplete="given-name"
              required
            />
          </div>

          <div class="form-field">
            <label for="email">
              E-Mail-Adresse
            </label>

            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              required
            />
          </div>

          <div class="form-field">
            <label for="themenbereich">
              Wobei brauchst du Unterstützung?
            </label>

            <select
              id="themenbereich"
              name="themenbereich"
              required
            >
              <option value="">
                Bitte auswählen
              </option>

              <option value="Pflegeplanung / Pflegeprozess">
                Pflegeplanung / Pflegeprozess
              </option>

              <option value="Pflegediagnosen / PESR">
                Pflegediagnosen / PESR
              </option>

              <option value="Praxisbesuch">
                Praxisbesuch
              </option>

              <option value="Praktische Prüfung">
                Praktische Prüfung
              </option>

              <option value="Fallbeispiele / klinisches Denken">
                Fallbeispiele / klinisches Denken
              </option>

              <option value="Fachthema verstehen">
                Fachthema verstehen
              </option>

              <option value="Sonstiges">
                Sonstiges
              </option>
            </select>
          </div>

          <div class="form-field">
            <label for="problem">
              Beschreibe mir kurz, wo du gerade festhängst.
            </label>

            <textarea
              id="problem"
              name="problem"
              rows="6"
              required
              placeholder="Zum Beispiel: Ich habe nächste Woche einen Praxisbesuch und bin unsicher, wie ich meine Pflegemaßnahmen fachlich begründen soll."
            ></textarea>
          </div>

          <div class="form-field">
            <label for="zeitpunkt">
              Wann brauchst du Unterstützung?
              <span>Optional</span>
            </label>

            <input
              type="text"
              id="zeitpunkt"
              name="zeitpunkt"
              placeholder="Zum Beispiel: nächste Woche, vor dem 10.09. oder so schnell wie möglich"
            />
          </div>

          <div class="privacy-box">
            <strong>Bitte beachte:</strong>

            <p>
              Gib hier keine Namen, Geburtsdaten oder andere personenbezogene
              Daten von Patienten oder Bewohnern ein. Fallinformationen müssen
              vollständig anonymisiert sein.
            </p>
          </div>

          <button
            type="submit"
            id="lernhilfe-submit"
            class="primary-button submit-button"
            data-ga-event="lernhilfe_interesse_submit"
          >
            Interesse an 1:1 Lernhilfe senden
          </button>

          <p
            id="lernhilfe-message"
            class="form-message"
            aria-live="polite"
          ></p>

          <p class="form-small">
            Mit dem Absenden entsteht noch keine kostenpflichtige Buchung.
          </p>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const form =
    document.getElementById("lernhilfe-form");

  const button =
    document.getElementById("lernhilfe-submit");

  const message =
    document.getElementById("lernhilfe-message");

  function setMessage(text, type = "normal") {
    if (!(message instanceof HTMLElement)) {
      return;
    }

    message.textContent = text;

    message.classList.remove(
      "form-message--success",
      "form-message--error"
    );

    if (type === "success") {
      message.classList.add("form-message--success");
    }

    if (type === "error") {
      message.classList.add("form-message--error");
    }
  }

  function resetButton() {
    if (!(button instanceof HTMLButtonElement)) {
      return;
    }

    button.disabled = false;
    button.textContent =
      "Interesse an 1:1 Lernhilfe senden";
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (
      !(form instanceof HTMLFormElement) ||
      !(button instanceof HTMLButtonElement)
    ) {
      return;
    }

    const formData =
      new FormData(form);

    const payload = {
      vorname:
        String(formData.get("vorname") ?? ""),
      email:
        String(formData.get("email") ?? ""),
      themenbereich:
        String(formData.get("themenbereich") ?? ""),
      problem:
        String(formData.get("problem") ?? ""),
      zeitpunkt:
        String(formData.get("zeitpunkt") ?? ""),
    };

    button.disabled = true;
    button.textContent =
      "Anfrage wird gesendet ...";

    setMessage(
      "Einen Moment, deine Anfrage wird gespeichert."
    );

    try {
      const response =
        await fetch("/api/lernhilfe-anfrage", {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json",
          },

          body:
            JSON.stringify(payload),
        });

      let result = {};

      try {
        result = await response.json();
      } catch {
        result = {};
      }

      if (!response.ok) {
        const errorMessage =
          typeof result.error === "string"
            ? result.error
            : "Die Anfrage konnte nicht gesendet werden.";

        setMessage(
          errorMessage,
          "error"
        );

        resetButton();
        return;
      }

      form.reset();

      button.textContent =
        "Interesse vorgemerkt";

      setMessage(
        "Danke! Deine Anfrage ist angekommen. Ich melde mich, sobald die ersten 1:1-Termine verfügbar sind.",
        "success"
      );

      if (
        typeof window !== "undefined" &&
        typeof window.gtag === "function"
      ) {
        window.gtag(
          "event",
          "lernhilfe_interesse_submit"
        );
      }
    } catch (error) {
      console.error(
        "Lernhilfe Formular Fehler:",
        error
      );

      setMessage(
        "Die Anfrage konnte nicht gesendet werden. Bitte versuche es erneut.",
        "error"
      );

      resetButton();
    }
  });
</script>


---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const lernskripte = await getCollection("lernskripte");
const themen = await getCollection("themen");

const sortedLernskripte = [...lernskripte].sort((a, b) => {
  const topicCompare = (a.data.topic ?? "").localeCompare(b.data.topic ?? "", "de");
  if (topicCompare !== 0) return topicCompare;

  return (a.data.reihenfolge ?? 999) - (b.data.reihenfolge ?? 999);
});

const fallbackThemen: Record<string, { title: string; beschreibung: string }> = {
  krankheitslehre: {
    title: "Krankheitslehre",
    beschreibung: "Lernskripte zu wichtigen Krankheitsbildern, Symptomen, Risiken und pflegerischem Handeln.",
  },
  notfaelle: {
    title: "Notfälle in der Pflege",
    beschreibung: "Vertiefende Lernskripte zu akuten Situationen, Warnzeichen und sicherem Handeln im Notfall.",
  },
  medikamente: {
    title: "Medikamente",
    beschreibung: "Lernskripte zu sicherer Medikamentengabe, Beobachtung, Risiken und Pflegeverantwortung.",
  },
};

const themenMap = new Map();

for (const thema of themen) {
  const topicKey = thema.slug.split("/")[0];
  const isIndex = thema.id?.endsWith("/index.md") || thema.slug.endsWith("/index");

  if (!themenMap.has(topicKey)) {
    themenMap.set(topicKey, {
      slug: topicKey,
      title: fallbackThemen[topicKey]?.title ?? thema.data.title,
      beschreibung: fallbackThemen[topicKey]?.beschreibung ?? thema.data.beschreibung ?? "",
    });
  }

  if (isIndex) {
    themenMap.set(topicKey, {
      slug: topicKey,
      title: thema.data.title,
      beschreibung:
        thema.data.beschreibung ??
        fallbackThemen[topicKey]?.beschreibung ??
        "",
    });
  }
}

const groupedLernskripte = Array.from(themenMap.values())
  .map((thema) => {
    const items = sortedLernskripte.filter((item) => item.data.topic === thema.slug);

    return {
      ...thema,
      items,
    };
  })
  .filter((group) => group.items.length > 0);

const ohneThema = sortedLernskripte.filter((item) => !item.data.topic);

const premiumCount = lernskripte.filter((item) => item.data.premium === true).length;
const freeCount = lernskripte.filter((item) => item.data.premium !== true).length;
---

<BaseLayout
  title="Lernskripte | PraxisMaik"
  description="Strukturierte Lernskripte für die Pflegeausbildung, geordnet nach Thema und Reihenfolge."
>
  <section class="lernskripte-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span class="breadcrumb-sep">›</span>
      <span class="current">Lernskripte</span>
    </nav>

    <header class="lernskripte-hero">
      <span class="lernskripte-eyebrow">Lernbereich</span>
      <h1>Lernskripte</h1>
      <p class="lernskripte-lead">
        Hier findest du strukturierte Lernskripte zum Vertiefen, Wiederholen und gezielten Lernen.
        Die Inhalte sind nach Thema und Reihenfolge aufgebaut.
      </p>

      <div class="overview-stats">
        <div class="overview-stat">
          <strong>{lernskripte.length}</strong>
          <span>gesamt</span>
        </div>
        <div class="overview-stat">
          <strong>{premiumCount}</strong>
          <span>Premium</span>
        </div>
        <div class="overview-stat">
          <strong>{freeCount}</strong>
          <span>kostenlos</span>
        </div>
      </div>
    </header>

    <section class="lernskripte-search-box" aria-label="Lernskripte durchsuchen">
      <label for="lernskripte-search">Lernskripte suchen</label>
      <input
        id="lernskripte-search"
        type="search"
        placeholder="Suche nach Thema, Titel, Tag oder Beschreibung..."
        autocomplete="off"
      />
      <p id="search-result-count" class="search-result-count">
        Alle Lernskripte werden angezeigt.
      </p>
    </section>

    {groupedLernskripte.length === 0 && ohneThema.length === 0 ? (
      <section class="lernskripte-empty">
        <h2>Noch keine Lernskripte vorhanden</h2>
        <p>
          Lege zuerst Inhalte in <code>src/content/lernskripte</code> an.
        </p>
      </section>
    ) : null}

    <div class="lernskripte-groups">
  {groupedLernskripte.map((group) => (
    <details class="lernskript-gruppe" data-group>
      <summary class="lernskript-gruppe-summary">
        <div class="lernskript-gruppe-head">
          <div>
            <h2>{group.title}</h2>
            {group.beschreibung ? <p>{group.beschreibung}</p> : null}
          </div>

          <div class="group-meta">
            <span class="group-count">
              {group.items.length} Lernskripte
            </span>

            <a class="group-link" href={`/themen/${group.slug}/`}>
              Zum Thema
            </a>
          </div>
        </div>
      </summary>

      <div class="lernskript-grid">
        {group.items.map((item) => {
          const isPremium = item.data.premium === true;
          const tags = Array.isArray(item.data.tags)
            ? item.data.tags.map(String).join(" ")
            : "";

          const searchText = [
            item.data.title,
            item.data.beschreibung,
            item.data.topic,
            tags,
            isPremium ? "premium" : "kostenlos frei",
            group.title,
          ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();

          return (
            <a
              class={`lernskript-card ${isPremium ? "lernskript-card-premium" : "lernskript-card-free"}`}
              href={`/lernskripte/${item.slug}/`}
              data-card
              data-search={searchText}
            >
              <div class="lernskript-card-top">
                {isPremium ? (
                  <span class="card-badge card-badge-premium">🔒 Premium</span>
                ) : (
                  <span class="card-badge card-badge-free">Kostenlos</span>
                )}

                {typeof item.data.reihenfolge === "number" && (
                  <span class="lernskript-order">
                    Schritt {item.data.reihenfolge}
                  </span>
                )}
              </div>

              <h3>{item.data.title}</h3>

              {item.data.beschreibung ? (
                <p>{item.data.beschreibung}</p>
              ) : (
                <p>Kein Beschreibungstext vorhanden.</p>
              )}

              {isPremium ? (
                <div class="premium-hint">
                  <strong>Nur Vorschau frei</strong>
                  <span>Kompletter Inhalt nur mit Premium</span>
                </div>
              ) : (
                <div class="free-hint">
                  <strong>Direkt verfügbar</strong>
                  <span>Ohne Freischaltung lesbar</span>
                </div>
              )}

              <span class="lernskript-link">
                {isPremium ? "Vorschau öffnen" : "Lernskript öffnen"}
              </span>
            </a>
          );
        })}
      </div>
    </details>
  ))}
</div>

    {ohneThema.length > 0 && (
      <details class="lernskript-gruppe" open data-group>
        <summary class="lernskript-gruppe-summary">
          <div class="lernskript-gruppe-head">
            <div>
              <h2>Ohne Themenzuordnung</h2>
              <p>
                Diese Lernskripte haben noch kein <code>topic</code> im Frontmatter.
              </p>
            </div>

            <div class="group-meta">
              <span class="group-count">
                {ohneThema.length} Lernskripte
              </span>
            </div>
          </div>
        </summary>

        <div class="lernskript-grid">
          {ohneThema.map((item) => {
            const isPremium = item.data.premium === true;
            const tags = Array.isArray(item.data.tags) ? item.data.tags.join(" ") : "";

            const searchText = [
              item.data.title,
              item.data.beschreibung,
              item.data.topic,
              tags,
              isPremium ? "premium" : "kostenlos frei",
              "ohne thema",
            ]
              .filter(Boolean)
              .join(" ")
              .toLowerCase();

            return (
              <a
                class={`lernskript-card ${isPremium ? "lernskript-card-premium" : "lernskript-card-free"}`}
                href={`/lernskripte/${item.slug}/`}
                data-card
                data-search={searchText}
              >
                <div class="lernskript-card-top">
                  {isPremium ? (
                    <span class="card-badge card-badge-premium">🔒 Premium</span>
                  ) : (
                    <span class="card-badge card-badge-free">Kostenlos</span>
                  )}

                  {typeof item.data.reihenfolge === "number" && (
                    <span class="lernskript-order">
                      Schritt {item.data.reihenfolge}
                    </span>
                  )}
                </div>

                <h3>{item.data.title}</h3>

                {item.data.beschreibung ? (
                  <p>{item.data.beschreibung}</p>
                ) : (
                  <p>Kein Beschreibungstext vorhanden.</p>
                )}

                {isPremium ? (
                  <div class="premium-hint">
                    <strong>Nur Vorschau frei</strong>
                    <span>Kompletter Inhalt nur mit Premium</span>
                  </div>
                ) : (
                  <div class="free-hint">
                    <strong>Direkt verfügbar</strong>
                    <span>Ohne Freischaltung lesbar</span>
                  </div>
                )}

                <span class="lernskript-link">
                  {isPremium ? "Vorschau öffnen" : "Lernskript öffnen"}
                </span>
              </a>
            );
          })}
        </div>
      </details>
    )}
  </section>
</BaseLayout>

<script>
  const searchInput = document.querySelector("#lernskripte-search");
  const cards = Array.from(document.querySelectorAll("[data-card]"));
  const groups = Array.from(document.querySelectorAll("[data-group]"));
  const resultCount = document.querySelector("#search-result-count");

  function normalize(value: string) {
    return String(value)
      .toLowerCase()
      .trim()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");
  }

  function updateSearch() {
    const query = normalize(searchInput instanceof HTMLInputElement ? searchInput.value : "");
    let visibleCount = 0;

    cards.forEach((card) => {
      if (!(card instanceof HTMLElement)) return;

      const searchText = normalize(card.getAttribute("data-search") ?? "");
      const isVisible = query === "" || searchText.includes(query);

      card.style.display = isVisible ? "" : "none";

      if (isVisible) visibleCount += 1;
    });

    groups.forEach((group) => {
      if (!(group instanceof HTMLDetailsElement)) return;

      const groupCards = Array.from(group.querySelectorAll("[data-card]"));

      const hasVisibleCards = groupCards.some((card) => {
        return card instanceof HTMLElement && card.style.display !== "none";
      });

      group.style.display = hasVisibleCards ? "" : "none";

      if (query !== "" && hasVisibleCards) {
        group.open = true;
      }

      if (query === "") {
        group.open = false;
      }
    });

    if (resultCount) {
      if (query === "") {
        resultCount.textContent = "Alle Lernskripte werden angezeigt.";
      } else if (visibleCount === 1) {
        resultCount.textContent = "1 passendes Lernskript gefunden.";
      } else {
        resultCount.textContent = `${visibleCount} passende Lernskripte gefunden.`;
      }
    }
  }

  if (searchInput instanceof HTMLInputElement) {
    searchInput.addEventListener("input", updateSearch);
  }
</script>

<style>
.lernskripte-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2.2rem 1rem 3rem;
}

.breadcrumbs {
  margin-bottom: 1.2rem;
  font-size: 0.95rem;
  color: #6b7280;
}

.breadcrumbs a {
  color: #18324a;
  text-decoration: none;
}

.breadcrumbs a:hover {
  text-decoration: underline;
}

.breadcrumb-sep {
  margin: 0 0.4rem;
}

.lernskripte-hero {
  max-width: 760px;
  margin-bottom: 2.4rem;
}

.lernskripte-eyebrow {
  display: inline-block;
  margin-bottom: 0.6rem;
  padding: 0.35rem 0.65rem;
  border-radius: 999px;
  background: #eef5ff;
  color: #18324a;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.lernskripte-hero h1 {
  margin-bottom: 0.7rem;
  font-size: clamp(1.9rem, 3vw, 2.5rem);
  line-height: 1.12;
}

.lernskripte-lead {
  max-width: 58ch;
  margin: 0;
  color: #5b6b7a;
  line-height: 1.7;
}

.overview-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  margin-top: 1.4rem;
}

.overview-stat {
  min-width: 110px;
  padding: 0.9rem 1rem;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid #e5e5e5;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
}

.overview-stat strong {
  display: block;
  font-size: 1.25rem;
  line-height: 1.2;
  color: #18324a;
}

.overview-stat span {
  display: block;
  margin-top: 0.25rem;
  color: #5b6b7a;
  font-size: 0.92rem;
}

.lernskripte-search-box {
  margin: 0 0 2rem;
  padding: 1.2rem;
  border-radius: 18px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
}

.lernskripte-search-box label {
  display: block;
  margin-bottom: 0.55rem;
  color: #18324a;
  font-weight: 800;
}

.lernskripte-search-box input {
  width: 100%;
  padding: 0.9rem 1rem;
  border-radius: 14px;
  border: 1px solid #d9e2ec;
  font-size: 1rem;
  color: #18324a;
  background: #f8fbff;
}

.lernskripte-search-box input:focus {
  outline: 3px solid rgba(24, 50, 74, 0.14);
  border-color: #18324a;
  background: #ffffff;
}

.search-result-count {
  margin: 0.65rem 0 0;
  color: #5b6b7a;
  font-size: 0.92rem;
}

.lernskripte-empty {
  margin-top: 2rem;
  padding: 1.4rem;
  border-radius: 18px;
  background: #ffffff;
  border: 1px solid #e5e5e5;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
}

.lernskripte-groups {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.lernskript-gruppe {
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  background: #ffffff;
  padding: 1rem 1rem 1.25rem;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.04);
}

.lernskript-gruppe-summary {
  list-style: none;
  cursor: pointer;
}

.lernskript-gruppe-summary::-webkit-details-marker {
  display: none;
}

.lernskript-gruppe-summary::before {
  content: "▶";
  display: inline-flex;
  margin-right: 0.55rem;
  color: #18324a;
  font-size: 0.8rem;
  transform: translateY(-1px);
  transition: transform 0.15s ease;
}

.lernskript-gruppe[open] .lernskript-gruppe-summary::before {
  transform: rotate(90deg) translateX(1px);
}

.lernskript-gruppe-head {
  display: inline-flex;
  width: calc(100% - 1.5rem);
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  vertical-align: top;
}

.lernskript-gruppe-head h2 {
  margin: 0 0 0.35rem 0;
}

.lernskript-gruppe-head p {
  margin: 0;
  color: #5b6b7a;
  line-height: 1.6;
}

.group-meta {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.group-count {
  display: inline-flex;
  align-items: center;
  padding: 0.45rem 0.8rem;
  border-radius: 999px;
  background: #eef5ff;
  color: #18324a;
  font-size: 0.82rem;
  font-weight: 700;
  white-space: nowrap;
}

.group-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.65rem 1rem;
  border-radius: 12px;
  background: #ffffff;
  border: 1px solid #d9e2ec;
  color: #18324a !important;
  text-decoration: none;
  font-weight: 600;
  white-space: nowrap;
}

.group-link:hover {
  background: #f8fbff;
  border-color: #bfd1e3;
  text-decoration: none;
}

.lernskript-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.2rem;
  margin-top: 1.2rem;
}

.lernskript-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  min-height: 260px;
  padding: 1.25rem;
  border-radius: 18px;
  background: #ffffff;
  border: 1px solid #e5e5e5;
  box-shadow: 0 10px 24px rgba(24, 50, 74, 0.05);
  text-decoration: none;
  color: inherit !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  overflow: hidden;
}

.lernskript-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 30px rgba(24, 50, 74, 0.08);
  border-color: #cfdceb;
  text-decoration: none;
}

.lernskript-card-premium {
  border-color: rgba(154, 52, 18, 0.22);
  background: linear-gradient(180deg, #fffaf6 0%, #ffffff 100%);
}

.lernskript-card-premium::after {
  content: "";
  position: absolute;
  inset: auto 0 0 0;
  height: 70px;
  background: linear-gradient(to top, rgba(255, 244, 232, 0.9), rgba(255, 244, 232, 0));
  pointer-events: none;
}

.lernskript-card-free {
  border-color: rgba(22, 101, 52, 0.15);
}

.lernskript-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.7rem;
  flex-wrap: wrap;
}

.card-badge {
  display: inline-flex;
  align-items: center;
  padding: 0.3rem 0.65rem;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 700;
  line-height: 1;
}

.card-badge-premium {
  background: #fff4e8;
  color: #9a3412;
}

.card-badge-free {
  background: #ecfdf5;
  color: #166534;
}

.lernskript-order {
  display: inline-flex;
  align-items: center;
  padding: 0.3rem 0.65rem;
  border-radius: 999px;
  background: #f5f7fb;
  color: #556270;
  font-size: 0.78rem;
  font-weight: 700;
  line-height: 1;
}

.lernskript-card h3 {
  margin: 0;
  font-size: 1.08rem;
  line-height: 1.35;
}

.lernskript-card p {
  margin: 0;
  color: #556270;
  line-height: 1.6;
}

.premium-hint,
.free-hint {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  padding: 0.8rem 0.9rem;
  border-radius: 14px;
  margin-top: 0.1rem;
}

.premium-hint {
  background: rgba(255, 244, 232, 0.95);
  border: 1px solid rgba(154, 52, 18, 0.14);
}

.free-hint {
  background: rgba(236, 253, 245, 0.95);
  border: 1px solid rgba(22, 101, 52, 0.12);
}

.premium-hint strong,
.free-hint strong {
  font-size: 0.92rem;
  line-height: 1.2;
  color: #18324a;
}

.premium-hint span,
.free-hint span {
  font-size: 0.88rem;
  line-height: 1.45;
  color: #5b6b7a;
}

.lernskript-link {
  position: relative;
  z-index: 1;
  margin-top: auto;
  font-weight: 700;
  color: #18324a;
}

@media (max-width: 900px) {
  .lernskript-grid {
    grid-template-columns: 1fr;
  }

  .lernskript-gruppe-head {
    width: calc(100% - 1.5rem);
    flex-direction: column;
  }

  .group-meta {
    justify-content: flex-start;
  }

  .group-link {
    white-space: normal;
  }
}
</style>
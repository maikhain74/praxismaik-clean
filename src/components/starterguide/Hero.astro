---
const benefits = [
  "Prioritäten sicher setzen",
  "Pflegediagnosen richtig einordnen",
  "Maßnahmen fachlich begründen",
  "Warnzeichen frühzeitig erkennen",
  "Pflegerisch denken statt auswendig lernen",
];
---

<section class="starterguide-hero" aria-labelledby="starterguide-title">
  <div class="starterguide-hero__content">
    <p class="starterguide-hero__eyebrow">
      Kostenloses E-Book für Pflegeazubis
    </p>

    <h1 id="starterguide-title">
      Die 10 häufigsten Fehler im
      <span>Praxisbesuch</span>
    </h1>

    <p class="starterguide-hero__intro">
      Verstehe typische Denkfehler, triff sicherere Entscheidungen und
      begründe deine pflegerischen Maßnahmen fachlich.
    </p>

    <ul class="starterguide-hero__benefits" aria-label="Inhalte des E-Books">
      {
        benefits.map((benefit) => (
          <li>
            <span aria-hidden="true">✓</span>
            {benefit}
          </li>
        ))
      }
    </ul>

    <a
      class="starterguide-hero__button"
      href="#starterguide-formular"
      data-ga-event="starterguide_hero_cta_click"
    >
      Kostenloses E-Book sichern
    </a>

    <p class="starterguide-hero__note">
      Kostenlos, unverbindlich und direkt für deine Pflegeausbildung.
    </p>
  </div>

  <div class="starterguide-hero__visual">
    <div class="starterguide-hero__cover-frame">
      <img
        src="/images/starterguide-cover.png"
        alt="Cover des kostenlosen PraxisMaik E-Books: Die 10 häufigsten Fehler im Praxisbesuch"
        width="720"
        height="1018"
        loading="eager"
        fetchpriority="high"
      />

      <div class="starterguide-hero__badge">
        <strong>35 Seiten</strong>
        <span>praxisnah erklärt</span>
      </div>
    </div>
  </div>
</section>

<style>
  .starterguide-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
    padding: clamp(2.5rem, 6vw, 5.5rem) 0;
  }

  .starterguide-hero__content {
    max-width: 690px;
  }

  .starterguide-hero__eyebrow {
    display: inline-flex;
    margin: 0 0 1.25rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: #fff3e8;
    color: #b9550d;
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .starterguide-hero h1 {
    max-width: 760px;
    margin: 0;
    color: #171717;
    font-size: clamp(2.4rem, 5.7vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .starterguide-hero h1 span {
    display: block;
    margin-top: 0.2em;
    color: #e67e22;
  }

  .starterguide-hero__intro {
    max-width: 650px;
    margin: 1.6rem 0 0;
    color: #4b4b4b;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .starterguide-hero__benefits {
    display: grid;
    gap: 0.85rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .starterguide-hero__benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: #252525;
    font-size: 1.04rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .starterguide-hero__benefits li span {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    margin-top: 0.02rem;
    border-radius: 50%;
    background: #fff0e2;
    color: #d96512;
    font-size: 0.92rem;
    font-weight: 900;
  }

  .starterguide-hero__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 3.75rem;
    margin-top: 2.25rem;
    padding: 0.95rem 1.55rem;
    border-radius: 0.85rem;
    background: #e67e22;
    color: #ffffff;
    box-shadow: 0 14px 32px rgb(230 126 34 / 20%);
    font-size: 1.06rem;
    font-weight: 850;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }

  .starterguide-hero__button:hover {
    transform: translateY(-2px);
    background: #d96f16;
    box-shadow: 0 18px 38px rgb(230 126 34 / 26%);
  }

  .starterguide-hero__button:focus-visible {
    outline: 3px solid rgb(230 126 34 / 35%);
    outline-offset: 4px;
  }

  .starterguide-hero__note {
    margin: 0.9rem 0 0;
    color: #666666;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .starterguide-hero__visual {
    display: flex;
    justify-content: center;
  }

  .starterguide-hero__cover-frame {
    position: relative;
    width: min(100%, 430px);
    padding: clamp(0.8rem, 2vw, 1.2rem);
    border: 1px solid #f1dfcf;
    border-radius: 1.5rem;
    background: #fff8f1;
    box-shadow: 0 28px 70px rgb(89 55 27 / 14%);
  }

  .starterguide-hero__cover-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.85rem;
    background: #ffffff;
  }

  .starterguide-hero__badge {
    position: absolute;
    right: -1rem;
    bottom: 2rem;
    display: grid;
    gap: 0.1rem;
    min-width: 142px;
    padding: 0.85rem 1rem;
    border: 1px solid #f1c69f;
    border-radius: 0.9rem;
    background: #ffffff;
    box-shadow: 0 12px 28px rgb(89 55 27 / 17%);
  }

  .starterguide-hero__badge strong {
    color: #e67e22;
    font-size: 1.08rem;
  }

  .starterguide-hero__badge span {
    color: #545454;
    font-size: 0.82rem;
  }

  @media (max-width: 820px) {
    .starterguide-hero {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 2rem;
      text-align: center;
    }

    .starterguide-hero__content {
      margin-inline: auto;
    }

    .starterguide-hero__benefits {
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
      text-align: left;
    }

    .starterguide-hero__button {
      width: min(100%, 380px);
    }

    .starterguide-hero__note {
      max-width: 380px;
      margin-inline: auto;
    }
  }

  @media (max-width: 520px) {
    .starterguide-hero h1 {
      font-size: clamp(2.25rem, 12vw, 3.25rem);
    }

    .starterguide-hero__intro {
      font-size: 1.03rem;
    }

    .starterguide-hero__cover-frame {
      width: min(92%, 390px);
    }

    .starterguide-hero__badge {
      right: -0.4rem;
      bottom: 1.3rem;
      min-width: 130px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .starterguide-hero__button {
      transition: none;
    }

    .starterguide-hero__button:hover {
      transform: none;
    }
  }
</style>
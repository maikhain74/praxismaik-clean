---
interface Props {
  title?: string;
  text?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  title = 'Premium-Inhalt',
  text = 'Dieser Bereich ist nur mit Premium freigeschaltet.',
  buttonText = 'Jetzt Premium freischalten',
  buttonHref = '/premium'
} = Astro.props;

const gateId = `premium-gate-${Math.random().toString(36).slice(2, 10)}`;
---

<div class="premium-gate" id={gateId}>
  <!-- FREIGESCHALTETER INHALT -->
  <div data-state="unlocked" hidden>
    <slot />
  </div>

  <!-- GESPERRTER INHALT -->
  <div data-state="locked">
    <div class="premium-gate__icon">🔒</div>
    <h2>{title}</h2>
    <p>{text}</p>
    <a href={buttonHref} class="premium-gate__button">{buttonText}</a>
  </div>
</div>

<script is:inline define:vars={{ gateId }}>
  const STORAGE_KEY = 'praxismaik_premium';

  const root = document.getElementById(gateId);

  if (root) {
    const locked = root.querySelector('[data-state="locked"]');
    const unlocked = root.querySelector('[data-state="unlocked"]');

    const isUnlocked = localStorage.getItem(STORAGE_KEY) === '1';

    if (isUnlocked) {
      if (locked) locked.hidden = true;
      if (unlocked) unlocked.hidden = false;
    } else {
      if (locked) locked.hidden = false;
      if (unlocked) unlocked.hidden = true;
    }
  }
</script>

<style>
  .premium-gate {
    margin: 2rem auto;
    max-width: 760px;
  }

  .premium-gate [data-state="unlocked"] {
    margin-bottom: 1rem;
  }

  .premium-gate [data-state="locked"] {
    padding: 2rem 1.5rem;
    border: 1px solid #eadccd;
    border-radius: 24px;
    background: #fffaf5;
    text-align: center;
    box-shadow: 0 14px 34px rgba(24, 50, 74, 0.08);
  }

  .premium-gate__icon {
    font-size: 2.4rem;
    margin-bottom: 1rem;
  }

  .premium-gate h2 {
    margin: 0 auto 1rem;
    max-width: 520px;
    font-size: clamp(1.7rem, 6vw, 2.4rem);
    line-height: 1.2;
    color: #18324a;
  }

  .premium-gate h2::after {
    content: "";
    display: block;
    width: 100%;
    max-width: 520px;
    height: 3px;
    margin: 1rem auto 0;
    background: #eadccd;
    border-radius: 999px;
  }

  .premium-gate p {
    margin: 0 auto 1.5rem;
    max-width: 520px;
    color: #18324a;
    font-size: clamp(1.05rem, 4vw, 1.35rem);
    line-height: 1.65;
  }

  .premium-gate__button,
  .premium-gate__button:link,
  .premium-gate__button:visited {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 56px;
    padding: 0.95rem 1.6rem;
    border-radius: 16px;
    background: linear-gradient(135deg, #d99a23 0%, #b97800 100%);
    color: #ffffff !important;
    text-decoration: none !important;
    font-weight: 800;
    font-size: clamp(1rem, 4vw, 1.25rem);
    box-shadow: 0 10px 24px rgba(185, 120, 0, 0.22);
  }

  .premium-gate__button::before {
    content: "🔐";
  }

  .premium-gate__button:hover {
    background: linear-gradient(135deg, #c98712 0%, #a86800 100%);
    color: #ffffff !important;
    text-decoration: none !important;
  }

  @media (max-width: 640px) {
    .premium-gate {
      margin: 1.5rem auto;
    }

    .premium-gate [data-state="locked"] {
      padding: 1.5rem 1rem;
      border-radius: 20px;
    }

    .premium-gate__button {
      width: 100%;
      max-width: 360px;
    }
  }
</style>
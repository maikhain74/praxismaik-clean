---
const { pathname, navItems } = Astro.props;
---

<header class="site-header">
  <div class="topbar wrap">
    <a class="brand" href="/">
      <img src="/PraxisMaik.jpg" alt="PraxisMaik Logo" />
      <div class="brand-text">
        <span class="brand-title">PraxisMaik</span>
        <span class="brand-subtitle">Lernplattform für Pflegeausbildung</span>
      </div>
    </a>

    <nav class="nav">
      {navItems.map((item) => {
        const isActive =
          item.href === "/"
            ? pathname === "/"
            : pathname.startsWith(item.href);

        return (
          <a href={item.href} aria-current={isActive ? "page" : undefined}>
            {item.label}
          </a>
        );
      })}

<span id="auth-nav">
  <a href="/login">Login</a>
</span>
    </nav>
  </div>
</header>

<script>
  import { createSupabaseBrowserClient } from "../lib/supabase-browser";

  const supabase = createSupabaseBrowserClient();

  async function updateAuthNavigation() {
    const authNav = document.getElementById("auth-nav");

    if (!authNav) {
      return;
    }

    const {
      data: { user },
    } = await supabase.auth.getUser();

    if (user) {
      authNav.innerHTML = `
        <a href="/dashboard">Mein Konto</a>
        <a href="/logout">Logout</a>
      `;
    } else {
      authNav.innerHTML = `
        <a href="/login">Login</a>
      `;
    }
  }

  updateAuthNavigation();
</script>
---
import { categories } from "../data/categories";
import CategoryCard from "../components/CategoryCard.astro";

import fs from "fs";
import path from "path";

const contentBase = path.resolve("src/content/themen");

function hasContent(slug) {
  if (!fs.existsSync(contentBase)) return false;

  const files = fs.readdirSync(contentBase);

  return files.some((file) => {
    const filePath = path.join(contentBase, file);
    if (!fs.statSync(filePath).isFile()) return false;

    const content = fs.readFileSync(filePath, "utf-8");

    return (
      content.includes(`category: "${slug}"`) ||
      content.includes(`category: '${slug}'`) ||
      content.includes(`category: ${slug}`) ||
      content.includes(`kategorie: "${slug}"`) ||
      content.includes(`kategorie: '${slug}'`) ||
      content.includes(`kategorie: ${slug}`)
    );
  });
}

const filteredCategories = categories.filter((cat) => hasContent(cat.slug));
---

<main>
  <h1>Kategorien</h1>
  <p class="intro">
  Wähle einen Themenbereich und lerne gezielt lerne für deine Pflegeausbildung 
</p>

  <div class="grid">
    {filteredCategories.map((cat) => (
      <CategoryCard {...cat} />
    ))}
  </div>
</main>

<style>
main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 32px 20px;
}

h1 {
  margin-bottom: 8px;
}

.intro {
  margin-bottom: 28px;
  color: #666;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 20px;
}
</style>